+	char pd[24], sd[24], r[24];
+	bool nowrite, s_first = false;
+	int i;
+	*ok = false;
+	if (has_flag (popw, "repeat2") || !dst_ok (sa[0], &nowrite) || nowrite || strchr (sa[0], '.')
