 libr/arch/p/usse/pseudo.c        | 122 +++++++++++++++++++++++++++++++
 libr/asm/meson.build             |   1 +
 libr/asm/p/usse.mk               |  18 +++++
 libr/include/r_asm.h             |   1 +
 libr/meson.build                 |   1 +
 test/db/asm/usse                 |  23 ++++++
 7 files changed, 167 insertions(+)
 create mode 100644 libr/arch/p/usse/pseudo.c
 create mode 100644 libr/asm/p/usse.mk
 create mode 100644 test/db/asm/usse

