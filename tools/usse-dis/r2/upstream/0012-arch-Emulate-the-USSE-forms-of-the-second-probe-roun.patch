--- a/libr/arch/p/usse/plugin.c
+++ b/libr/arch/p/usse/plugin.c
@@ -30,6 +30,11 @@ static bool reg_ok(const char *r) {
 	if (!*r || strlen (r) > 16) {
 		return false;
 	}
+	/* measured: i3 reads as i0 and drops writes; the text cannot tell bank 0's
