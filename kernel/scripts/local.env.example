# Machine-specific settings for the test-cycle scripts (push-gma500.sh).
# Copy to kernel/scripts/local.env (gitignored) and edit. The file is sourced by bash;
# the ${VAR:-value} form lets a variable set in the environment still win.
# Unset variables fall back to the defaults listed in push-gma500.sh.

# ssh destinations; host aliases from ~/.ssh/config work as well.
SGX_BUILD_HOST=${SGX_BUILD_HOST:-sgx-build}
SGX_TARGET_HOST=${SGX_TARGET_HOST:-user@sgx-target}
# Extra ssh/scp options for the laptop, e.g. a host key alias when it dual-boots.
SGX_TARGET_SSH_OPTS=${SGX_TARGET_SSH_OPTS:-"-o HostKeyAlias=sgx-target"}

# Build host: kernel tree (relative to the remote $HOME), make -j, extra PATH entries
# (quoted, so ~ expands on the build host and not here).
SGX_KERNEL_TREE=${SGX_KERNEL_TREE:-src/linux-sgx}
SGX_KERNEL_RELEASE=${SGX_KERNEL_RELEASE:-7.3.0-sgx}
SGX_BUILD_JOBS=${SGX_BUILD_JOBS:-8}
SGX_BUILD_PATH=${SGX_BUILD_PATH:-'~/.local/bin'}
# Absolute path of the IGT clone on the build host. No script reads it; it records the
# value the commands in userspace/igt/README.md expect there.
SGX_IGT_TREE=${SGX_IGT_TREE:-/path/to/igt-gpu-tools}

# Where the laptop sends netconsole (an IPv4 address the laptop can reach).
SGX_NETCONSOLE_HOST=${SGX_NETCONSOLE_HOST:-192.0.2.10}
SGX_NETCONSOLE_PORT=${SGX_NETCONSOLE_PORT:-6666}
