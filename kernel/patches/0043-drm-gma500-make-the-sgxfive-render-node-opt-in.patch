 drivers/gpu/drm/gma500/Makefile               |  2 +-
 drivers/gpu/drm/gma500/gma_sgx.c              | 17 +++++++
 drivers/gpu/drm/gma500/gma_sgx.h              |  1 +
 drivers/gpu/drm/gma500/psb_drv.c              | 12 ++++-
 drivers/gpu/drm/gma500/sgxfive/sgxfive.h      |  7 ++-
 drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c  | 10 +++++
 .../gpu/drm/gma500/sgxfive/sgxfive_drv_test.c | 44 +++++++++++++++++++
 7 files changed, 89 insertions(+), 4 deletions(-)
 create mode 100644 drivers/gpu/drm/gma500/sgxfive/sgxfive_drv_test.c

diff --git a/drivers/gpu/drm/gma500/Makefile b/drivers/gpu/drm/gma500/Makefile
index c63f44498c2e3..c80cd1193757e 100644
--- a/drivers/gpu/drm/gma500/Makefile
+++ b/drivers/gpu/drm/gma500/Makefile
@@ -43,7 +43,7 @@ gma500_gfx-y += sgxfive/sgx_fw.o sgxfive/sgx_seq.o sgxfive/sgx_xfer.o sgxfive/sg
 	sgxfive/sgxfive_sched.o sgxfive/sgxfive_submit.o sgxfive/sgxfive_coredump.o gma_sgx.o
 gma500_gfx-$(CONFIG_DRM_GMA500_KUNIT_TEST) += sgxfive/sgx_fw_test.o sgxfive/sgx_seq_test.o \
 	sgxfive/sgx_xfer_test.o sgxfive/sgx_mmu_test.o sgxfive/sgxfive_vm_test.o \
-	sgxfive/sgxfive_job_test.o sgxfive/sgxfive_coredump_test.o
+	sgxfive/sgxfive_job_test.o sgxfive/sgxfive_coredump_test.o sgxfive/sgxfive_drv_test.o
 gma500_gfx-$(CONFIG_DRM_FBDEV_EMULATION) +=  fbdev.o
 
 obj-$(CONFIG_DRM_GMA500) += gma500_gfx.o
diff --git a/drivers/gpu/drm/gma500/gma_sgx.c b/drivers/gpu/drm/gma500/gma_sgx.c
index d44216b709fb9..3c6a07a2eed19 100644
--- a/drivers/gpu/drm/gma500/gma_sgx.c
+++ b/drivers/gpu/drm/gma500/gma_sgx.c
@@ -4,6 +4,7 @@
  * device to it, forward the SGX interrupt, and route the sgxfive render-node
  * ioctls to it.
  */
+#include <linux/moduleparam.h>
 #include <linux/pci.h>
 
 #include <drm/drm_file.h>
@@ -15,6 +16,19 @@
 #include "psb_drv.h"
 #include "sgxfive/sgxfive.h"
 
+static bool gma_sgx_render;
+module_param_named(sgx_render, gma_sgx_render, bool, 0444);
+MODULE_PARM_DESC(sgx_render,
+		 "Expose the SGX545 render node (default: off). For trusted users "
+		 "only: GPU programs can read every SGX register and data that "
+		 "earlier jobs left behind. When off, only DEV_QUERY is accepted.");
+
+/* Fixed for the life of the module: the parameter is read-only (0444). */
+bool gma_sgx_render_enabled(void)
+{
+	return gma_sgx_render;
+}
+
 /* After psb_mmu_driver_init: the reset sequence keeps gma500's PD in list 0. */
 void gma_sgx_init(struct drm_device *dev)
 {
@@ -82,6 +96,9 @@ static int gma_sgx_ioctl(struct drm_device *dev, unsigned int nr, void *data,
 
 	if (!dev_priv->sgx)
 		return -ENODEV;
+	/* Without the render node, card0's users (seat, compositor) are not trusted either. */
+	if (!sgxfive_ioctl_allowed(gma_sgx_render, nr))
+		return -EPERM;
 	return sgxfive_ioctl(dev_priv->sgx, nr, data, file);
 }
 
diff --git a/drivers/gpu/drm/gma500/gma_sgx.h b/drivers/gpu/drm/gma500/gma_sgx.h
index 0d0f210b1ce9c..7c743a9bb41db 100644
--- a/drivers/gpu/drm/gma500/gma_sgx.h
+++ b/drivers/gpu/drm/gma500/gma_sgx.h
@@ -12,6 +12,7 @@
 struct drm_device;
 struct drm_minor;
 
+bool gma_sgx_render_enabled(void);
 void gma_sgx_init(struct drm_device *dev);
 void gma_sgx_fini(struct drm_device *dev);
 void gma_sgx_debugfs_init(struct drm_minor *minor);
diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index d91cebbaf02a9..73f0fd85d4655 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -38,7 +38,7 @@
 #include "psb_reg.h"
 #include "gma_sgx.h"
 
-static const struct drm_driver driver;
+static struct drm_driver driver;
 static int psb_pci_probe(struct pci_dev *pdev, const struct pci_device_id *ent);
 
 /*
@@ -501,7 +501,8 @@ static const struct file_operations psb_gem_fops = {
 	.fop_flags = FOP_UNSIGNED_OFFSET,
 };
 
-static const struct drm_driver driver = {
+/* Not const: psb_init() drops DRIVER_RENDER unless sgx_render is set. */
+static struct drm_driver driver = {
 	.driver_features = DRIVER_MODESET | DRIVER_GEM | DRIVER_RENDER |
 			   DRIVER_SYNCOBJ | DRIVER_SYNCOBJ_TIMELINE,
 
@@ -537,6 +538,13 @@ static int __init psb_init(void)
 	if (drm_firmware_drivers_only())
 		return -ENODEV;
 
+	/*
+	 * The render node is opt-in: drm_dev_init() allocates its minor from the
+	 * driver's features, so it must be dropped here, before any device.
+	 */
+	if (!gma_sgx_render_enabled())
+		driver.driver_features &= ~DRIVER_RENDER;
+
 	return pci_register_driver(&psb_pci_driver);
 }
 
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive.h b/drivers/gpu/drm/gma500/sgxfive/sgxfive.h
index 4233525b9600f..55dc7e98b910d 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive.h
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive.h
@@ -29,7 +29,12 @@ void sgxfive_destroy(struct sgxfive *sgx);
 bool sgxfive_irq(struct sgxfive *sgx, u32 stat_1, u32 stat_2);
 void sgxfive_debugfs_init(struct sgxfive *sgx, struct dentry *root);
 
-/* The render-node interface: the host routes its sgxfive ioctls here. */
+/*
+ * The render-node interface: the host routes its sgxfive ioctls here. With
+ * the render node off (trusted users only), the host lets through only what
+ * sgxfive_ioctl_allowed() accepts and returns -EPERM for the rest.
+ */
+bool sgxfive_ioctl_allowed(bool render, unsigned int nr);
 int sgxfive_ioctl(struct sgxfive *sgx, unsigned int nr, void *data,
 		  struct drm_file *file);
 struct drm_gem_object *sgxfive_gem_create_object(struct drm_device *drm,
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c
index 489610d0eadcd..13f0f93858732 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c
@@ -241,6 +241,16 @@ static int sgxfive_ioctl_get_bo_mmap_offset(void *data, struct drm_file *file)
 	return ret;
 }
 
+/*
+ * Client programs read every SGX register and stale temporaries (design §6.3),
+ * so with the render node off nothing may allocate, map or run on the GPU:
+ * only DEV_QUERY, which reports fixed device facts.
+ */
+bool sgxfive_ioctl_allowed(bool render, unsigned int nr)
+{
+	return render || nr == DRM_SGXFIVE_DEV_QUERY;
+}
+
 int sgxfive_ioctl(struct sgxfive *sgx, unsigned int nr, void *data,
 		  struct drm_file *file)
 {
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv_test.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv_test.c
new file mode 100644
index 0000000000000..417fb5b4e36f0
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv_test.c
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the render-node gate (sgxfive_ioctl_allowed): with the
+ * render node off, only DEV_QUERY may reach the device; everything that
+ * allocates, maps or runs on the GPU is for trusted users only.
+ */
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include <drm/sgxfive_drm.h>
+
+#include "sgxfive.h"
+
+static void sgxfive_drv_test_gate_on(struct kunit *test)
+{
+	unsigned int nr;
+
+	for (nr = DRM_SGXFIVE_DEV_QUERY; nr <= DRM_SGXFIVE_SUBMIT_JOBS; nr++)
+		KUNIT_EXPECT_TRUE_MSG(test, sgxfive_ioctl_allowed(true, nr), "nr %u", nr);
+}
+
+static void sgxfive_drv_test_gate_off(struct kunit *test)
+{
+	unsigned int nr;
+
+	KUNIT_EXPECT_TRUE(test, sgxfive_ioctl_allowed(false, DRM_SGXFIVE_DEV_QUERY));
+	for (nr = DRM_SGXFIVE_CREATE_BO; nr <= DRM_SGXFIVE_SUBMIT_JOBS; nr++)
+		KUNIT_EXPECT_FALSE_MSG(test, sgxfive_ioctl_allowed(false, nr), "nr %u", nr);
+	/* Off, unknown numbers are refused too. */
+	KUNIT_EXPECT_FALSE(test, sgxfive_ioctl_allowed(false, DRM_SGXFIVE_SUBMIT_JOBS + 1));
+}
+
+static struct kunit_case sgxfive_drv_test_cases[] = {
+	KUNIT_CASE(sgxfive_drv_test_gate_on),
+	KUNIT_CASE(sgxfive_drv_test_gate_off),
+	{}
+};
+
+static struct kunit_suite sgxfive_drv_test_suite = {
+	.name = "gma500_sgxfive_drv",
+	.test_cases = sgxfive_drv_test_cases,
+};
+
+kunit_test_suite(sgxfive_drv_test_suite);
