From b3bc9bc660c5032d1112a41b941a7fad0b53864d Mon Sep 17 00:00:00 2001
From: Josep Torra <n770galaxy@gmail.com>
Date: Tue, 20 Oct 2026 18:24:57 +0200
Subject: [PATCH 05/11] drm/gma500: send the SGX545 firmware its first CCB
 command

Add sgx_ccb_submit(), the kernel CCB half of SGXScheduleCCBCommand: write the
command at the write offset, advance the write offset and the event-kicker
word, then kick EVENT_KICK. KUnit pins the layout and order. The first command
after boot carries the init info's cache control (INVAL_BIF_PD), as the DDK
does.

dri/N/sgx/miscinfo sends GETMISCINFO with GET_STRUCT_SIZES and checks the
reply: the firmware's core and DDK identity against the registers and the
firmware file, and the 13 MKIF structure sizes against the file's table. On
the GMA3600 every value matches and the EDM answers in about 140 us.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Josep Torra <n770galaxy@gmail.com>
---
 drivers/gpu/drm/gma500/sgx_boot.c     | 126 +++++++++++++++++++++++++-
 drivers/gpu/drm/gma500/sgx_seq.c      |  32 +++++++
 drivers/gpu/drm/gma500/sgx_seq.h      |  10 ++
 drivers/gpu/drm/gma500/sgx_seq_test.c |  63 +++++++++++++
 4 files changed, 230 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/gma500/sgx_boot.c b/drivers/gpu/drm/gma500/sgx_boot.c
index ee4878afe437..f99374977c12 100644
--- a/drivers/gpu/drm/gma500/sgx_boot.c
+++ b/drivers/gpu/drm/gma500/sgx_boot.c
@@ -80,12 +80,17 @@ struct gma_sgx {
 	bool loaded;
 	bool live;			/* EDM booted: the IRQ events are ours */
 	u32 heap_start;			/* first buffer's offset in each heap */
+	u32 cache_control;		/* SGXMKIF_CC_* for the next command */
 	atomic_t sw_events;		/* EVENT_STATUS.SW_EVENT interrupts */
 	atomic_t bif_faults;
 };
 
 /* Buffer ids and HostCtl dwords (design/sgx545_fw_format.md, spec §13.10). */
-enum { BUF_KICKER = 8, BUF_TA3D_CTL = 9, BUF_HOST_CTL = 10, BUF_CCB_CTL = 7 };
+enum {
+	BUF_CCB = 6, BUF_CCB_CTL = 7, BUF_KICKER = 8, BUF_TA3D_CTL = 9,
+	BUF_HOST_CTL = 10, BUF_MISC = 11,
+};
+
 enum {
 	HC_INIT_STATUS = 0, HC_POWER_STATUS = 1, HC_HWR_SAMPLE_RATE = 5,
 	HC_UKERNEL_TIMER_CLOCK = 6, HC_APM_SAMPLE_RATE = 7, HC_HOST_CLOCK = 13,
@@ -98,6 +103,12 @@ enum {
 #define SGX_EVENT_SW		0x00004000
 #define SGX_EVENT_MASTER	0x80000000
 
+/* SGXMKIF_CMD_* index into the kick table, and the misc-info protocol. */
+#define SGX_CMD_GETMISCINFO	6
+#define MISCINFO_READY		0x1
+#define MISCINFO_GET_STRUCT_SIZES 0x2
+#define MISCINFO_DWORDS		(1 + 7 + 13)	/* flags, features, sizes */
+
 static void gma_sgx_free_buf(struct gma_sgx *sgx, unsigned int id)
 {
 	struct gma_sgx_buf *b = &sgx->buf[id];
@@ -307,6 +318,11 @@ static void seq_udelay(void *ctx, unsigned int us)
 	udelay(us);
 }
 
+static void seq_wmb(void *ctx)
+{
+	wmb(); /* the command and offsets before the kick */
+}
+
 /* C7, C9-C11: the kicker word, the host clock, InitStatus, then a barrier. */
 static void seq_pre_kick(void *ctx)
 {
@@ -447,10 +463,117 @@ static int gma_sgx_boot(struct gma_sgx *sgx)
 	}
 	drm_info(sgx->dev, "SGX boot: EDM up after %lld us\n",
 		 ktime_us_delta(ktime_get(), start));
+	/* InitDevInfo: the first command invalidates the BIF PD cache. */
+	sgx->cache_control = sgx->fw.meta[SGX_FW_META_CACHE_CONTROL];
 	gma_sgx_dump(sgx, &p);
 	return 0;
 }
 
+/* Submit one kernel CCB command (SGXScheduleCCBCommand). */
+static int gma_sgx_command(struct gma_sgx *sgx, unsigned int cmd,
+			   const u32 *data, unsigned int ndata)
+{
+	struct sgx_seq s = {
+		.wr = seq_wr, .wmb = seq_wmb, .ctx = sgx->dev,
+	};
+	int ret;
+
+	if (!sgx->live)
+		return -ENODEV;
+	ret = sgx_ccb_submit(&s, gma_sgx_words(sgx, BUF_CCB),
+			     gma_sgx_words(sgx, BUF_CCB_CTL),
+			     gma_sgx_words(sgx, BUF_KICKER),
+			     sgx->fw.meta[SGX_FW_META_KICK + cmd],
+			     sgx->cache_control, data, ndata);
+	if (!ret)
+		sgx->cache_control = 0;
+	return ret;
+}
+
+static const char *const gma_sgx_feature_names[] = {
+	"core rev", "core id", "ddk version", "ddk build", "core id sw",
+	"core rev sw", "build options",
+};
+
+static void gma_sgx_expect(struct drm_printer *p, const char *what, u32 got,
+			   u32 want, int *bad)
+{
+	drm_printf(p, "%-16s %#010x %s\n", what, got,
+		   got == want ? "ok" : "MISMATCH");
+	if (got != want) {
+		drm_printf(p, "%-16s expected %#010x\n", "", want);
+		(*bad)++;
+	}
+}
+
+/*
+ * SGXGetMiscInfoUkernel with GET_STRUCT_SIZES: the EDM fills in the core and
+ * DDK identity and the MKIF structure sizes it was built with. Check every
+ * value against the registers and the firmware file.
+ */
+static int gma_sgx_miscinfo(struct gma_sgx *sgx, struct drm_printer *p)
+{
+	struct drm_psb_private *dev_priv = to_drm_psb_private(sgx->dev);
+	u32 *mi = gma_sgx_words(sgx, BUF_MISC);
+	const u32 data[] = { 0, sgx->layout.addr[BUF_MISC] };
+	u32 want[7];
+	ktime_t start;
+	int i, ret, bad = 0;
+
+	for (i = 1; i < MISCINFO_DWORDS; i++)
+		WRITE_ONCE(mi[i], 0);
+	WRITE_ONCE(mi[0], MISCINFO_GET_STRUCT_SIZES);
+	ret = gma_sgx_command(sgx, SGX_CMD_GETMISCINFO, data, ARRAY_SIZE(data));
+	if (ret)
+		return ret;
+	start = ktime_get();
+	while (!(READ_ONCE(mi[0]) & MISCINFO_READY)) {
+		if (ktime_ms_delta(ktime_get(), start) > 500) {
+			drm_printf(p, "no MISCINFO_READY after 500 ms\n");
+			gma_sgx_dump(sgx, p);
+			return -ETIMEDOUT;
+		}
+		usleep_range(50, 100);
+		rmb(); /* re-read the misc block from memory */
+	}
+	drm_printf(p, "GETMISCINFO answered after %lld us\n",
+		   ktime_us_delta(ktime_get(), start));
+
+	want[0] = PSB_RSGX32(SGX_CORE_REVISION);
+	want[1] = PSB_RSGX32(SGX_CORE_ID);
+	/* PVRVERSION_MAJ/MIN/BRANCH: DDK 1.7 is branch 17 */
+	want[2] = sgx->fw.ddk_major << 16 | sgx->fw.ddk_minor << 8 | 17;
+	want[3] = sgx->fw.ddk_build;
+	want[4] = 545;
+	want[5] = want[0];		/* the ukernel's own revision: 1.0.13 */
+	want[6] = sgx->fw.build_options;
+	for (i = 0; i < 7; i++)
+		gma_sgx_expect(p, gma_sgx_feature_names[i], mi[1 + i], want[i],
+			       &bad);
+	for (i = 0; i < 13; i++) {
+		char what[16];
+
+		snprintf(what, sizeof(what), "struct size %d", i);
+		gma_sgx_expect(p, what, mi[8 + i],
+			       sgx->fw.meta[SGX_FW_META_STRUCT_SIZES + i], &bad);
+	}
+	drm_printf(p, "%s\n", bad ? "MISMATCHES" : "all values match");
+	return bad ? -EIO : 0;
+}
+
+static int gma_sgx_miscinfo_show(struct seq_file *m, void *unused)
+{
+	struct gma_sgx *sgx = m->private;
+	struct drm_printer p = drm_seq_file_printer(m);
+	int ret;
+
+	mutex_lock(&sgx->lock);
+	ret = gma_sgx_miscinfo(sgx, &p);
+	mutex_unlock(&sgx->lock);
+	return ret == -EIO ? 0 : ret;
+}
+DEFINE_SHOW_ATTRIBUTE(gma_sgx_miscinfo);
+
 /* Called from gma_sgx_interrupt; true when the event belongs to the EDM. */
 bool gma_sgx_irq(struct drm_device *dev, u32 stat_1, u32 stat_2)
 {
@@ -545,6 +668,7 @@ void gma_sgx_debugfs_init(struct drm_minor *minor)
 	debugfs_create_file("stop", 0200, dir, sgx, &gma_sgx_stop_fops);
 	debugfs_create_file("status", 0400, dir, sgx, &gma_sgx_status_fops);
 	debugfs_create_x32("heap_start", 0600, dir, &sgx->heap_start);
+	debugfs_create_file("miscinfo", 0400, dir, sgx, &gma_sgx_miscinfo_fops);
 	for (i = 0; i < SGX_FW_MAX_BUFFERS; i++) {
 		char name[8];
 
diff --git a/drivers/gpu/drm/gma500/sgx_seq.c b/drivers/gpu/drm/gma500/sgx_seq.c
index 11ce499eb372..02f8f4bd7edb 100644
--- a/drivers/gpu/drm/gma500/sgx_seq.c
+++ b/drivers/gpu/drm/gma500/sgx_seq.c
@@ -76,3 +76,35 @@ int sgx_seq_boot(const struct sgx_seq *s)
 	wr(s, SGX_EVENT_KICK2, 1);
 	return 0;
 }
+
+/*
+ * SGXScheduleCCBCommand: write the command at the CCB write offset, advance
+ * the write offset and the event-kicker word (both mod 256), then kick the
+ * EDM on EVENT_KICK. ctl[0] is the host's write offset, ctl[1] the EDM's read
+ * offset. service is the command's EDM handler (the kick table entry).
+ */
+int sgx_ccb_submit(const struct sgx_seq *s, u32 *ccb, u32 ctl[2], u32 *kicker,
+		   u32 service, u32 cache_control, const u32 *data,
+		   unsigned int ndata)
+{
+	u32 woff = ctl[0] % SGX_CCB_ENTRIES;
+	u32 *cmd = &ccb[woff * SGX_CCB_CMD_DWORDS];
+	unsigned int i;
+
+	if (ndata > SGX_CCB_DATA_DWORDS)
+		return -EINVAL;
+	if (!service)
+		return -ENOENT;		/* no EDM handler in this build */
+	if ((woff + 1) % SGX_CCB_ENTRIES == ctl[1])
+		return -EBUSY;		/* full */
+
+	cmd[0] = service;
+	cmd[1] = cache_control;
+	for (i = 0; i < SGX_CCB_DATA_DWORDS; i++)
+		cmd[2 + i] = i < ndata ? data[i] : 0;
+	ctl[0] = (woff + 1) % SGX_CCB_ENTRIES;
+	*kicker = (*kicker + 1) % SGX_CCB_ENTRIES;
+	s->wmb(s->ctx);		/* the EDM reads all of this after the kick */
+	wr(s, SGX_EVENT_KICK, 1);
+	return 0;
+}
diff --git a/drivers/gpu/drm/gma500/sgx_seq.h b/drivers/gpu/drm/gma500/sgx_seq.h
index af80e7648443..599d0e726ce2 100644
--- a/drivers/gpu/drm/gma500/sgx_seq.h
+++ b/drivers/gpu/drm/gma500/sgx_seq.h
@@ -45,6 +45,7 @@ struct sgx_seq {
 	void (*wr)(void *ctx, u32 reg, u32 val);
 	void (*udelay)(void *ctx, unsigned int us);
 	void (*pre_kick)(void *ctx);	/* memory writes before the kick */
+	void (*wmb)(void *ctx);		/* order memory writes before a kick */
 	void *ctx;
 
 	u32 clkgatectl, clkgatectl2;
@@ -56,4 +57,13 @@ struct sgx_seq {
 
 int sgx_seq_boot(const struct sgx_seq *s);
 
+/* Kernel CCB: 256 SGXMKIF_COMMANDs {service, cache control, data[6]}. */
+#define SGX_CCB_ENTRIES		256
+#define SGX_CCB_CMD_DWORDS	8
+#define SGX_CCB_DATA_DWORDS	6
+
+int sgx_ccb_submit(const struct sgx_seq *s, u32 *ccb, u32 ctl[2], u32 *kicker,
+		   u32 service, u32 cache_control, const u32 *data,
+		   unsigned int ndata);
+
 #endif
diff --git a/drivers/gpu/drm/gma500/sgx_seq_test.c b/drivers/gpu/drm/gma500/sgx_seq_test.c
index 9ccf031d9782..1035351e0dfd 100644
--- a/drivers/gpu/drm/gma500/sgx_seq_test.c
+++ b/drivers/gpu/drm/gma500/sgx_seq_test.c
@@ -12,6 +12,7 @@
 #define OP_DELAY	0xd0000000	/* delay marker: reg = microseconds */
 #define OP_PREKICK	0xd1000000	/* pre_kick() marker */
 #define OP_READ		0xd2000000	/* read marker: reg = register */
+#define OP_WMB		0xd3000000	/* wmb() marker */
 
 struct rec {
 	u32 op[MAX_OPS][2];
@@ -121,9 +122,71 @@ static void sgx_seq_test_bif_fault(struct kunit *test)
 	}
 }
 
+static void rec_wmb(void *ctx)
+{
+	rec_add(ctx, OP_WMB, 0);
+}
+
+/* SGXScheduleCCBCommand: command, write offset, kicker word, barrier, kick. */
+static void sgx_seq_test_ccb_submit(struct kunit *test)
+{
+	struct rec *r = kunit_kzalloc(test, sizeof(*r), GFP_KERNEL);
+	u32 *ccb = kunit_kzalloc(test, SGX_CCB_ENTRIES * SGX_CCB_CMD_DWORDS * 4,
+				 GFP_KERNEL);
+	static const u32 data[] = { 0, 0xf0006000 };
+	u32 ctl[2] = { 255, 255 }, kicker = 7;
+	struct sgx_seq s;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, r);
+	KUNIT_ASSERT_NOT_NULL(test, ccb);
+	seq(&s, r);
+	s.wmb = rec_wmb;
+	KUNIT_ASSERT_EQ(test, sgx_ccb_submit(&s, ccb, ctl, &kicker, 0x173, 0x2,
+					     data, ARRAY_SIZE(data)), 0);
+	KUNIT_EXPECT_EQ(test, ccb[255 * 8 + 0], 0x173u);
+	KUNIT_EXPECT_EQ(test, ccb[255 * 8 + 1], 0x2u);
+	KUNIT_EXPECT_EQ(test, ccb[255 * 8 + 2], 0u);
+	KUNIT_EXPECT_EQ(test, ccb[255 * 8 + 3], 0xf0006000u);
+	for (i = 4; i < 8; i++)
+		KUNIT_EXPECT_EQ(test, ccb[255 * 8 + i], 0u);
+	KUNIT_EXPECT_EQ(test, ctl[0], 0u);		/* wraps mod 256 */
+	KUNIT_EXPECT_EQ(test, kicker, 8u);
+	KUNIT_ASSERT_EQ(test, r->n, 2u);
+	KUNIT_EXPECT_EQ(test, r->op[0][0], (u32)OP_WMB);
+	KUNIT_EXPECT_EQ(test, r->op[1][0], (u32)SGX_EVENT_KICK);
+	KUNIT_EXPECT_EQ(test, r->op[1][1], 1u);
+}
+
+static void sgx_seq_test_ccb_errors(struct kunit *test)
+{
+	struct rec *r = kunit_kzalloc(test, sizeof(*r), GFP_KERNEL);
+	u32 *ccb = kunit_kzalloc(test, SGX_CCB_ENTRIES * SGX_CCB_CMD_DWORDS * 4,
+				 GFP_KERNEL);
+	static const u32 seven[7];
+	u32 ctl[2] = { 4, 5 }, kicker = 0;	/* write + 1 == read: full */
+	struct sgx_seq s;
+
+	KUNIT_ASSERT_NOT_NULL(test, r);
+	KUNIT_ASSERT_NOT_NULL(test, ccb);
+	seq(&s, r);
+	s.wmb = rec_wmb;
+	KUNIT_EXPECT_EQ(test, sgx_ccb_submit(&s, ccb, ctl, &kicker, 0x173, 0,
+					     NULL, 0), -EBUSY);
+	ctl[1] = 0;
+	KUNIT_EXPECT_EQ(test, sgx_ccb_submit(&s, ccb, ctl, &kicker, 0, 0,
+					     NULL, 0), -ENOENT);
+	KUNIT_EXPECT_EQ(test, sgx_ccb_submit(&s, ccb, ctl, &kicker, 0x173, 0,
+					     seven, 7), -EINVAL);
+	KUNIT_EXPECT_EQ(test, r->n, 0u);
+	KUNIT_EXPECT_EQ(test, ctl[0], 4u);
+}
+
 static struct kunit_case sgx_seq_test_cases[] = {
 	KUNIT_CASE(sgx_seq_test_boot),
 	KUNIT_CASE(sgx_seq_test_bif_fault),
+	KUNIT_CASE(sgx_seq_test_ccb_submit),
+	KUNIT_CASE(sgx_seq_test_ccb_errors),
 	{}
 };
 
