 	    get32(data + 28))
@@ -271,9 +399,14 @@ int sgx_fw_parse(struct sgx_fw *fw, const u8 *data, size_t len)
 		u32 off = get32(s + 4), size = get32(s + 8), arg = get32(s + 12);
