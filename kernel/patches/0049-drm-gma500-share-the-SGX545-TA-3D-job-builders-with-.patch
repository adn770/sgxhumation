diff --git a/drivers/gpu/drm/gma500/sgxfive/sgx_render.c b/drivers/gpu/drm/gma500/sgxfive/sgx_render.c
new file mode 100644
index 0000000000000..d7523fee22c86
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgx_render.c
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Builders for the kernel-owned side of an SGX545 TA + 3D job: the firmware
+ * structures of a render context (HW render context, PB descriptor and page
+ * table, RT data set) and, for each scene, the render details, the
+ * SGXMKIF_CMDTA and the background object, from the register words userspace
+ * gives (struct drm_sgxfive_render_cmd). Pure code: it writes into buffers it
+ * is given. The values are the first triangle's (design/sgx545_3d.md §12.6,
+ * §13, §14), which the debugfs test and the render node both build here.
+ */
+#include <linux/bits.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+#include "sgx_render.h"
+#include "sgx_xfer.h"
+
+static void put32(u8 *p, unsigned int off, u32 v)
+{
+	p[off] = v;
+	p[off + 1] = v >> 8;
+	p[off + 2] = v >> 16;
+	p[off + 3] = v >> 24;
+}
+
+/* §12.6 "once per render context"; the EDM owns the count and the lists. */
+void sgx_render_ctx(u32 *ctx, const struct sgx_render_addrs *a)
+{
+	memset(ctx, 0, SGX_RENDER_CTX_SIZE);
+	ctx[SGX_RENDER_CTX_FLAGS / 4] = SGX_RENDER_CTX_NEW;
+	ctx[SGX_RENDER_CTX_PD / 4] = a->pd_phys;
+	ctx[SGX_RENDER_CTX_CCB / 4] = a->ccb;
+	ctx[SGX_RENDER_CTX_CCB_CTL / 4] = a->ccb_ctl;
+	ctx[SGX_RENDER_CTX_PBDESC / 4] = a->pbdesc;
+	ctx[SGX_RENDER_CTX_PRIM / 4] = a->param_base + SGX_RENDER_PARAM_PRIM;
+}
+
+/*
+ * §12.4: the pages are contiguous from the slot's PB; the host builds the
+ * page table, one entry per page of the slot, linking them {previous << 16 |
+ * next} with 0xffff at both ends, and the descriptor's free list {tail << 16 |
+ * head}.
+ */
+void sgx_render_pb(u32 *desc, u32 *block, u32 *pt, const struct sgx_render_addrs *a)
+{
+	const u32 head = SGX_RENDER_PARAM_PB >> 12;
+	const u32 tail = head + SGX_RENDER_PB_PAGES - 1;
+	const u32 ht = tail << 16 | head, prev = (tail - 1) << 16;
+	u32 i;
+
+	memset(pt, 0, SGX_RENDER_PT_BYTES);
+	for (i = head; i <= tail; i++)
+		pt[i] = (i == head ? 0xffff : i - 1) << 16 |
+			(i == tail ? 0xffff : i + 1);
+
+	memset(desc, 0, SGX_RENDER_PBDESC_SIZE);
+	desc[SGX_RENDER_PB_NUMPAGES / 4] = SGX_RENDER_PB_PAGES;
+	desc[SGX_RENDER_PB_INIT_HT / 4] = ht;
+	desc[SGX_RENDER_PB_INIT_PREV / 4] = prev;
+	desc[SGX_RENDER_PB_PT / 4] = a->param_base + SGX_RENDER_PARAM_PT;
+	desc[SGX_RENDER_PB_HT / 4] = ht;
+	desc[SGX_RENDER_PB_PREV / 4] = prev;
+	/* The capture's thresholds: TA, ZLS, global, PDS. */
+	desc[SGX_RENDER_PB_TA_THRESH / 4] = 0x432;
+	desc[SGX_RENDER_PB_TA_THRESH / 4 + 1] = 0x400;
+	desc[SGX_RENDER_PB_TA_THRESH / 4 + 2] = 0x400;
+	desc[SGX_RENDER_PB_TA_THRESH / 4 + 3] = 0x300;
+	desc[SGX_RENDER_PB_BLOCKS / 4] = a->pbblock;
+
+	block[0] = SGX_RENDER_PB_PAGES;
+	block[1] = ht;
+	block[2] = a->pbdesc;
+	block[3] = 0;
+}
+
+/* §8 and §12.6: one RT data, free, with zeroed TA-data buffers. */
+void sgx_render_rtds(u32 *rtds, const struct sgx_render_addrs *a)
+{
+	u32 *rt = rtds + SGX_RENDER_RTDS_RT / 4;
+
+	memset(rtds, 0, SGX_RENDER_RTDS_SIZE);
+	rtds[SGX_RENDER_RTDS_PENDING / 4] = a->pending;
+	rtds[SGX_RENDER_RTDS_MTILEW / 4] = 8;
+	rtds[SGX_RENDER_RTDS_NUMRT / 4] = 1;
+	rt[SGX_RENDER_RT_CTX / 4] = a->ctx;
+	rt[SGX_RENDER_RT_BLOCKS / 4] = 1;
+	rt[SGX_RENDER_RT_RGNARRAY / 4] = 0xc0;
+	rt[SGX_RENDER_RT_BG / 4] = a->param_base + SGX_RENDER_PARAM_BG;
+	rt[SGX_RENDER_RT_STATE / 4] = a->tadata + SGX_RENDER_TD_STATE;
+	rt[SGX_RENDER_RT_CONTROL / 4] = a->tadata + SGX_RENDER_TD_CONTROL;
+	rt[SGX_RENDER_RT_OTPM / 4] = a->tadata + SGX_RENDER_TD_OTPM;
+	rt[SGX_RENDER_RT_TAIL / 4] = a->tadata + SGX_RENDER_TD_TAIL;
+	rt[SGX_RENDER_RT_TAILSIZE / 4] = SGX_RENDER_TAIL_SIZE;
+	rt[SGX_RENDER_RT_NUMRTS / 4] = 1;
+	rt[SGX_RENDER_RT_STATUS / 4] = a->rt_status;
+	rt[SGX_RENDER_RT_COMMON / 4] = SGX_RENDER_RT_FREE;
+}
+
+/*
+ * §7 and §12.6 "render details": the user's 3D registers, and the kernel's
+ * (the parameter slot, the region headers, the background object, no depth
+ * or stencil buffer, the pixel partitions). The EDM copies the command's
+ * per-kick fields in at the TA kick.
+ */
+void sgx_render_rd(u32 *rd, const struct sgx_render_addrs *a,
+		   const struct drm_sgxfive_render_cmd *c)
+{
+	memset(rd, 0, SGX_RENDER_RD_SIZE);
+	rd[SGX_RENDER_RD_REQBASE / 4] = a->param_base;
+	rd[SGX_RENDER_RD_PIXELBE / 4] = c->pixelbe;
+	rd[SGX_RENDER_RD_IPFMISC / 4] = c->isp_ipfmisc;
+	rd[SGX_RENDER_RD_AAMODE / 4] = c->aa_mode_3d;
+	rd[SGX_RENDER_RD_RGNBASE / 4] = a->tadata + SGX_RENDER_TD_RGN;
+	rd[SGX_RENDER_RD_ZLSEXTZ / 4] = a->tadata + SGX_RENDER_TD_ZLS;
+	rd[SGX_RENDER_RD_SLOAD / 4] = 0x80000000;	/* no stencil buffer */
+	rd[SGX_RENDER_RD_SSTORE / 4] = 0x80000000;
+	rd[SGX_RENDER_RD_BGDEPTH / 4] = c->isp_bgobjdepth;
+	rd[SGX_RENDER_RD_BGOBJ / 4] = c->isp_bgobj;
+	/* VERTEXPTR: the object, in 16-byte units from BIF_3D_REQ_BASE. */
+	rd[SGX_RENDER_RD_BGTAG / 4] = SGX_RENDER_PARAM_BG >> 4;
+	rd[SGX_RENDER_RD_MSCTL / 4] = c->isp_multisamplectl;
+	rd[SGX_RENDER_RD_TSPCONFIG / 4] = c->tsp_config;
+	rd[SGX_RENDER_RD_PIXEV_EXEC / 4] = c->event_pixel_pds_exec;
+	rd[SGX_RENDER_RD_PIXEV_DATA / 4] = c->event_pixel_pds_data;
+	rd[SGX_RENDER_RD_PIXEV_INFO / 4] = c->event_pixel_pds_info;
+	rd[SGX_RENDER_RD_FPUCTRL / 4] = c->isp_fpuctrl;
+	rd[SGX_RENDER_RD_DEPTHSORT / 4] = c->isp_depthsort;
+	rd[SGX_RENDER_RD_ACCESS / 4] = a->access;
+	rd[SGX_RENDER_RD_RTDS / 4] = a->rtds;
+	rd[SGX_RENDER_RD_RTDATA / 4] = a->rtds + SGX_RENDER_RTDS_RT;
+	rd[SGX_RENDER_RD_NUMRTS / 4] = 1;
+	rd[SGX_RENDER_RD_BGPRI_LIST / 4] = a->bgpri;
+	rd[SGX_RENDER_RD_NUMPIXPART / 4] = 0x07c00000;	/* 31, as for transfers */
+}
+
+/*
+ * §6 and §12.6 "SGXMKIF_CMDTA": one kick of the scene, with a TA and a 3D
+ * status word as its completion fences, the user's TA registers and the
+ * kernel's. READY goes last: the caller writes the command before it advances
+ * the CCB write offset. Returns the command's size in the CCB.
+ */
+u32 sgx_render_cmd(u8 *cmd, const struct sgx_render_addrs *a,
+		   const struct drm_sgxfive_render_cmd *c,
+		   const struct sgx_render_kick *k)
+{
+	const unsigned int ta = SGX_RENDER_CMD_TAREGS;
+	unsigned int i;
+
+	memset(cmd, 0, SGX_RENDER_CMD_STRIDE);
+	put32(cmd, SGX_RENDER_CMD_SIZE_W, SGX_RENDER_CMD_STRIDE);
+	put32(cmd, SGX_RENDER_CMD_FLAGS, k->flags);
+	/* The background object's dwords 0-2, which the EDM writes per render. */
+	for (i = 0; i < 3; i++)
+		put32(cmd, SGX_RENDER_CMD_SPEC + 4 * i, c->bgobj_words[i]);
+	put32(cmd, SGX_RENDER_CMD_VPART, 0x50000000);	/* 10, pre-shifted */
+	put32(cmd, SGX_RENDER_CMD_SPM_VPART, 0x50000000);
+	put32(cmd, SGX_RENDER_CMD_RFLAGS, k->render_flags);
+	put32(cmd, SGX_RENDER_CMD_FRAME, k->frame);
+	put32(cmd, SGX_RENDER_CMD_PBDESC, a->pbdesc);
+	put32(cmd, SGX_RENDER_CMD_RD, a->rd);
+	put32(cmd, SGX_RENDER_CMD_RTDS, a->rtds);
+	put32(cmd, SGX_RENDER_CMD_RTDATA, a->rtds + SGX_RENDER_RTDS_RT);
+
+	put32(cmd, SGX_RENDER_SH_NUM_TA, 1);
+	put32(cmd, SGX_RENDER_SH_NUM_3D, 1);
+	put32(cmd, SGX_RENDER_SH_TA_STATUS, a->ta_status);
+	put32(cmd, SGX_RENDER_SH_TA_STATUS + 4, k->ta_val);
+	put32(cmd, SGX_RENDER_SH_3D_STATUS, a->td_status);
+	put32(cmd, SGX_RENDER_SH_3D_STATUS + 4, k->td_val);
+
+	put32(cmd, ta + SGX_RENDER_TA_TEAA, c->te_aa);
+	put32(cmd, ta + SGX_RENDER_TA_TEMTILE1, c->te_mtile1);
+	put32(cmd, ta + SGX_RENDER_TA_TEMTILE2, c->te_mtile2);
+	put32(cmd, ta + SGX_RENDER_TA_TESCREEN, c->te_screen);
+	put32(cmd, ta + SGX_RENDER_TA_TEMTILESTRIDE, c->te_mtile_stride);
+	put32(cmd, ta + SGX_RENDER_TA_TEPSG, k->te_psg);
+	put32(cmd, ta + SGX_RENDER_TA_VDM, c->vdm_ctrl_stream_base);
+	put32(cmd, ta + SGX_RENDER_TA_MTECTRL, c->mte_ctrl);
+	put32(cmd, ta + SGX_RENDER_TA_PSGRGN, a->tadata + SGX_RENDER_TD_RGN);
+	put32(cmd, ta + SGX_RENDER_TA_TPC, a->tadata + SGX_RENDER_TD_TAIL);
+	put32(cmd, ta + SGX_RENDER_TA_WCOMPARE, c->mte_wcompare);
+	put32(cmd, ta + SGX_RENDER_TA_WCLAMP, c->mte_wclamp);
+	put32(cmd, ta + SGX_RENDER_TA_MTESCREEN, c->mte_screen);
+	put32(cmd, ta + SGX_RENDER_TA_REQBASE, a->param_base);
+	put32(cmd, ta + SGX_RENDER_TA_MTEMSCTRL, c->mte_multisamplectl);
+
+	put32(cmd, SGX_RENDER_SH_CTRL, 1);			/* READY */
+	return SGX_RENDER_CMD_STRIDE;
+}
+
+/*
+ * The kick of one render job: the whole scene at once (first and last kick,
+ * cache invalidations, render it, te_psg's end-of-scene bit), the job's
+ * number as the frame and value as both status values.
+ */
+void sgx_render_scene_kick(struct sgx_render_kick *k, u32 seqno, u32 status_val)
+{
+	k->flags = SGX_RENDER_TA_FIRST | SGX_RENDER_TA_LAST | SGX_RENDER_TA_INVAL;
+	k->render_flags = SGX_RENDER_SCENE;
+	k->te_psg = SGX_RENDER_TEPSG_END;
+	k->frame = seqno;
+	k->ta_val = status_val;
+	k->td_val = status_val;
+}
+
+/* S.8: the user's PDS words over the whole render target, zero layers. */
+void sgx_render_bgobj(u32 *bg, const struct drm_sgxfive_render_cmd *c)
+{
+	const struct sgx_xfer_rect r = {
+		0, 0, (c->mte_screen & 0xffff) + 1, (c->mte_screen >> 16) + 1,
+	};
+
+	sgx_xfer_bgobj_words(bg, c->bgobj_words, &r);
+}
+
+/*
+ * The render target must fit the kernel's tiling buffers: MTE_SCREEN and
+ * TE_SCREEN within SGX_RENDER_MAX_W x _H, no TE_SCREEN bits beyond its two
+ * fields; and ISP_BGOBJ may only set bits 8 and 9.
+ */
+int sgx_render_check_size(const struct drm_sgxfive_render_cmd *c)
+{
+	const u32 w = (c->mte_screen & 0xffff) + 1, h = (c->mte_screen >> 16) + 1;
+	const u32 tx = (c->te_screen & 0xfff) + 1, ty = ((c->te_screen >> 12) & 0xfff) + 1;
+
+	if (w > SGX_RENDER_MAX_W || h > SGX_RENDER_MAX_H)
+		return -EINVAL;
+	if (c->te_screen >> 24 || tx > SGX_RENDER_MAX_W / 32 ||
+	    ty > SGX_RENDER_MAX_H / 16)
+		return -EINVAL;
+	if (c->isp_bgobj & ~0x300u)
+		return -EINVAL;
+	return 0;
+}
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgx_render.h b/drivers/gpu/drm/gma500/sgxfive/sgx_render.h
new file mode 100644
index 0000000000000..38f817608944e
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgx_render.h
@@ -0,0 +1,233 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The kernel-owned side of an SGX545 TA + 3D job (design/sgx545_3d.md §4-§8,
+ * §12.6; design/sgx545_render_uapi.md §11): the firmware structures of one
+ * render context and the command of one scene, built from the register words
+ * userspace supplies (struct drm_sgxfive_render_cmd). Shared by the debugfs
+ * first-triangle test (sgx_tri.c) and the render node (sgxfive_render.c).
+ */
+#ifndef _GMA500_SGX_RENDER_H_
+#define _GMA500_SGX_RENDER_H_
+
+#include <linux/types.h>
+
+#include <drm/sgxfive_drm.h>
+
+/* Structure sizes in bytes (§4.1, §6-§8). */
+#define SGX_RENDER_CMD_SIZE	0x2b0	/* SGXMKIF_CMDTA, one reg_updates_3d pair */
+#define SGX_RENDER_CMD_STRIDE	0x2c0	/* its ui32Size: 64-byte units */
+#define SGX_RENDER_CTX_SIZE	0x44	/* SGXMKIF_HWRENDERCONTEXT */
+#define SGX_RENDER_RD_SIZE	0x1ec	/* hw_render_details */
+#define SGX_RENDER_RTDS_SIZE	0x50	/* hw_rt_data_set, one RT data */
+#define SGX_RENDER_PBDESC_SIZE	0x3c	/* hw_pb_desc */
+#define SGX_RENDER_PBBLOCK_SIZE	0x10	/* hw_pb_block */
+#define SGX_RENDER_CCB_SIZE	0x10000	/* the EDM masks the read offset */
+
+/* SGXMKIF_CMDTA (§6). */
+#define SGX_RENDER_CMD_SIZE_W	0x000
+#define SGX_RENDER_CMD_FLAGS	0x004
+#define SGX_RENDER_CMD_SPEC	0x008	/* spec_object[3] */
+#define SGX_RENDER_CMD_VPART	0x014
+#define SGX_RENDER_CMD_SPM_VPART 0x018
+#define SGX_RENDER_CMD_RFLAGS	0x01c
+#define SGX_RENDER_CMD_FRAME	0x020
+#define SGX_RENDER_CMD_PBDESC	0x024
+#define SGX_RENDER_CMD_RD	0x038
+#define SGX_RENDER_CMD_DSTSYNC	0x03c
+#define SGX_RENDER_CMD_RTDS	0x040
+#define SGX_RENDER_CMD_RTDATA	0x044
+#define SGX_RENDER_CMD_NUM3DREGS 0x054
+#define SGX_RENDER_CMD_SHARED	0x058	/* SGXMKIF_CMDTA_SHARED */
+#define SGX_RENDER_SH_CTRL	(SGX_RENDER_CMD_SHARED + 0x000)
+#define SGX_RENDER_SH_NUM_TA	(SGX_RENDER_CMD_SHARED + 0x004)
+#define SGX_RENDER_SH_NUM_3D	(SGX_RENDER_CMD_SHARED + 0x008)
+#define SGX_RENDER_SH_TATQ	(SGX_RENDER_CMD_SHARED + 0x00c)
+#define SGX_RENDER_SH_TA_STATUS	(SGX_RENDER_CMD_SHARED + 0x0c0) /* {addr, val}[32] */
+#define SGX_RENDER_SH_3D_STATUS	(SGX_RENDER_CMD_SHARED + 0x1c0) /* {addr, val}[4] */
+#define SGX_RENDER_CMD_TAREGS	0x238	/* hw_ta_registers */
+#define SGX_RENDER_CMD_3DREGUPD	0x2a8
+
+/* hw_ta_registers, from SGX_RENDER_CMD_TAREGS (§12.2 step 5). */
+#define SGX_RENDER_TA_TEAA	0x00
+#define SGX_RENDER_TA_TEMTILE1	0x04
+#define SGX_RENDER_TA_TEMTILE2	0x08
+#define SGX_RENDER_TA_TESCREEN	0x0c
+#define SGX_RENDER_TA_TEMTILESTRIDE 0x10
+#define SGX_RENDER_TA_TEPSG	0x14
+#define SGX_RENDER_TA_VDM	0x18
+#define SGX_RENDER_TA_MTECTRL	0x1c
+#define SGX_RENDER_TA_PSGRGN	0x20
+#define SGX_RENDER_TA_TPC	0x24
+#define SGX_RENDER_TA_WCOMPARE	0x28
+#define SGX_RENDER_TA_WCLAMP	0x2c
+#define SGX_RENDER_TA_MTESCREEN	0x30
+#define SGX_RENDER_TA_REQBASE	0x3c
+#define SGX_RENDER_TA_MTEMSCTRL	0x6c
+
+/* TA flags (ui32Flags) and render flags. */
+#define SGX_RENDER_TA_FIRST	0x01
+#define SGX_RENDER_TA_LAST	0x02
+#define SGX_RENDER_TA_INVAL	0x70	/* USE, PDS and data caches */
+#define SGX_RENDER_SCENE	0x400	/* render flag: render the scene */
+#define SGX_RENDER_TEPSG_END	0x400000	/* the scene's last kick [CAP] */
+
+/* SGXMKIF_HWRENDERCONTEXT (§4.1). */
+#define SGX_RENDER_CTX_FLAGS	0x00
+#define SGX_RENDER_CTX_PRIORITY	0x04
+#define SGX_RENDER_CTX_PD	0x08
+#define SGX_RENDER_CTX_CCB	0x0c
+#define SGX_RENDER_CTX_CCB_CTL	0x10
+#define SGX_RENDER_CTX_TACOUNT	0x14
+#define SGX_RENDER_CTX_PBDESC	0x18
+#define SGX_RENDER_CTX_PRIM	0x1c
+#define SGX_RENDER_CTX_PARTIAL	0x20	/* list heads: partial, complete */
+#define SGX_RENDER_CTX_COMPLETE	0x28
+#define SGX_RENDER_CTX_PID	0x40
+#define SGX_RENDER_CTX_NEW	0x1
+
+/* hw_render_details (§7): the 52 3D registers, then the rest. */
+#define SGX_RENDER_RD_REQBASE	0x000
+#define SGX_RENDER_RD_PIXELBE	0x008
+#define SGX_RENDER_RD_IPFMISC	0x00c
+#define SGX_RENDER_RD_AAMODE	0x010
+#define SGX_RENDER_RD_RGNBASE	0x020
+#define SGX_RENDER_RD_ZLSEXTZ	0x028
+#define SGX_RENDER_RD_ZLSCTL	0x02c
+#define SGX_RENDER_RD_SLOAD	0x038
+#define SGX_RENDER_RD_SSTORE	0x03c
+#define SGX_RENDER_RD_BGDEPTH	0x040
+#define SGX_RENDER_RD_BGOBJ	0x044
+#define SGX_RENDER_RD_BGTAG	0x048
+#define SGX_RENDER_RD_MSCTL	0x050
+#define SGX_RENDER_RD_TSPCONFIG	0x058
+#define SGX_RENDER_RD_PIXEV_EXEC 0x05c
+#define SGX_RENDER_RD_PIXEV_DATA 0x060
+#define SGX_RENDER_RD_PIXEV_INFO 0x064
+#define SGX_RENDER_RD_FPUCTRL	0x068
+#define SGX_RENDER_RD_DEPTHSORT	0x0cc
+#define SGX_RENDER_RD_ACCESS	0x0d0
+#define SGX_RENDER_RD_RFLAGS	0x0d4
+#define SGX_RENDER_RD_RTDS	0x0d8
+#define SGX_RENDER_RD_RTDATA	0x0dc
+#define SGX_RENDER_RD_TQSYNC	0x0e4
+#define SGX_RENDER_RD_NUMRTS	0x104
+#define SGX_RENDER_RD_NEXTRT	0x108
+#define SGX_RENDER_RD_PIXEV_UPD	0x10c
+#define SGX_RENDER_RD_BGPRI_LIST 0x114
+#define SGX_RENDER_RD_TESTATE	0x124
+#define SGX_RENDER_RD_SPEC	0x130
+#define SGX_RENDER_RD_NUMPIXPART 0x13c
+#define SGX_RENDER_RD_NUM3DSTATUS 0x144
+
+/* hw_rt_data_set (§8) and its hw_rt_data, at SGX_RENDER_RTDS_RT. */
+#define SGX_RENDER_RTDS_PENDING	0x00
+#define SGX_RENDER_RTDS_COMPLETE 0x04
+#define SGX_RENDER_RTDS_MTILEW	0x08
+#define SGX_RENDER_RTDS_NUMRT	0x14
+#define SGX_RENDER_RTDS_RT	0x18
+#define SGX_RENDER_RT_CTX	0x00
+#define SGX_RENDER_RT_RD	0x04
+#define SGX_RENDER_RT_BLOCKS	0x08
+#define SGX_RENDER_RT_RGNARRAY	0x0c
+#define SGX_RENDER_RT_BG	0x10
+#define SGX_RENDER_RT_STATE	0x14
+#define SGX_RENDER_RT_CONTROL	0x18
+#define SGX_RENDER_RT_OTPM	0x1c
+#define SGX_RENDER_RT_TAIL	0x20
+#define SGX_RENDER_RT_TAILSIZE	0x24
+#define SGX_RENDER_RT_NUMRTS	0x28
+#define SGX_RENDER_RT_RGNSTRIDE	0x2c
+#define SGX_RENDER_RT_STATUS	0x30
+#define SGX_RENDER_RT_COMMON	0x34
+#define SGX_RENDER_RT_FREE	0x10	/* CommonStatus: no render outstanding */
+
+/* hw_pb_desc and hw_pb_block (§5, §12.4). */
+#define SGX_RENDER_PB_FLAGS	0x00
+#define SGX_RENDER_PB_NUMPAGES	0x04
+#define SGX_RENDER_PB_INIT_HT	0x08
+#define SGX_RENDER_PB_INIT_PREV	0x0c
+#define SGX_RENDER_PB_PT	0x10
+#define SGX_RENDER_PB_ALLOC	0x14
+#define SGX_RENDER_PB_HT	0x18
+#define SGX_RENDER_PB_PREV	0x1c
+#define SGX_RENDER_PB_TA_THRESH	0x28
+#define SGX_RENDER_PB_BLOCKS	0x38
+
+/* The parameter buffer: the capture's size and thresholds (§12.4). */
+#define SGX_RENDER_PB_PAGES	0x422
+#define SGX_RENDER_PT_BYTES	0x40000	/* one entry per page of the heap */
+
+/*
+ * A render context's parameter slot (BIF_TA/3D_REQ_BASE at its base): the PB
+ * from the second page, so page index 0 is never handed out, then its page
+ * table, the scratch primitive block and the background object (whose tag is
+ * relative to the slot base). The first triangle's layout (§14.1).
+ */
+#define SGX_RENDER_PARAM_PB	0x1000
+#define SGX_RENDER_PARAM_PT	0x423000
+#define SGX_RENDER_PARAM_PRIM	0x463000
+#define SGX_RENDER_PARAM_BG	0x464000
+#define SGX_RENDER_PARAM_SIZE	0x465000
+
+/* The RT data's zeroed buffers (§12.4), a page each, in its TA-data slot. */
+#define SGX_RENDER_TD_TAIL	0x0000	/* tail pointers, 0x100 */
+#define SGX_RENDER_TD_CONTROL	0x1000	/* DPM context control */
+#define SGX_RENDER_TD_OTPM	0x2000
+#define SGX_RENDER_TD_STATE	0x3000	/* DPM context state */
+#define SGX_RENDER_TD_RGN	0x4000	/* region headers, 0x300 */
+#define SGX_RENDER_TD_ZLS	0x5000	/* ZLS external-Z region headers */
+#define SGX_RENDER_TD_SIZE	0x6000
+#define SGX_RENDER_TAIL_SIZE	0x100
+
+/*
+ * The render targets known to work (design/sgx545_render_uapi.md §11.4): up
+ * to 8 x 8 tiles. With more than 8 tile rows the TA faults on page 0 of the
+ * parameter slot (seen on hardware; the tail-pointer layout is suspected).
+ */
+#define SGX_RENDER_MAX_W	256
+#define SGX_RENDER_MAX_H	128
+
+/*
+ * Where one render context's kernel-owned items are, by device address. The
+ * parameter and TA-data slots are mapped in the context's page directory, the
+ * rest in the EDM's (and aliased read-only in the context's).
+ */
+struct sgx_render_addrs {
+	u32 pd_phys;		/* the context's page directory */
+	u32 param_base;		/* the parameter slot: SGX_RENDER_PARAM_* */
+	u32 tadata;		/* the TA-data slot: SGX_RENDER_TD_* */
+	u32 ctx;		/* SGXMKIF_HWRENDERCONTEXT */
+	u32 ccb, ccb_ctl;	/* the TA client CCB and {write, read} offsets */
+	u32 rtds;		/* the RT data set, its one RT data after it */
+	u32 pbdesc, pbblock;
+	u32 rd;			/* the render details */
+	u32 ta_status;		/* written at the TA end */
+	u32 td_status;		/* written at the render end: the fence */
+	u32 access;		/* the render details' access word */
+	u32 pending;		/* the RT data set's pending count */
+	u32 rt_status;		/* the render target's status word */
+	u32 bgpri;		/* the background primary-PDS update list */
+};
+
+/* What one kick sets in the command besides the user's registers. */
+struct sgx_render_kick {
+	u32 flags;		/* SGX_RENDER_TA_* */
+	u32 render_flags;
+	u32 te_psg;		/* te_psg */
+	u32 frame;
+	u32 ta_val, td_val;	/* written to ta_status and td_status when done */
+};
+
+void sgx_render_ctx(u32 *ctx, const struct sgx_render_addrs *a);
+void sgx_render_pb(u32 *desc, u32 *block, u32 *pt, const struct sgx_render_addrs *a);
+void sgx_render_rtds(u32 *rtds, const struct sgx_render_addrs *a);
+void sgx_render_rd(u32 *rd, const struct sgx_render_addrs *a,
+		   const struct drm_sgxfive_render_cmd *c);
+u32 sgx_render_cmd(u8 *cmd, const struct sgx_render_addrs *a,
+		   const struct drm_sgxfive_render_cmd *c,
+		   const struct sgx_render_kick *k);
+void sgx_render_bgobj(u32 *bg, const struct drm_sgxfive_render_cmd *c);
+void sgx_render_scene_kick(struct sgx_render_kick *k, u32 seqno, u32 status_val);
+int sgx_render_check_size(const struct drm_sgxfive_render_cmd *c);
+
+#endif
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgx_render_test.c b/drivers/gpu/drm/gma500/sgxfive/sgx_render_test.c
new file mode 100644
index 0000000000000..06aceecd4ec61
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgx_render_test.c
@@ -0,0 +1,415 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * KUnit tests for sgx_render.c: the kernel-owned side of a TA + 3D job. Field
+ * placement is checked against the dword offsets design/sgx545_3d.md §4-§12
+ * cites (CMDTA dwN, rd dwN, rtdata dwN, ctx dwN, pb dwN). The fixture is the
+ * first triangle as it rendered on the hardware (§14): its addresses (the
+ * debugfs test's REV1 layout) and its register words, so the values below are
+ * the ones the laptop ran.
+ */
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include "sgx_render.h"
+
+#define KD	0x32152000u	/* the debugfs test's kernel-data page */
+
+static const struct sgx_render_addrs addrs = {
+	.pd_phys = 0x039ea000, .param_base = 0x10000000, .tadata = 0x20001000,
+	.ctx = KD + 0x100, .ccb = 0x32140000, .ccb_ctl = KD + 0x000,
+	.rtds = KD + 0x200, .pbdesc = KD + 0x300, .pbblock = KD + 0x340,
+	.rd = KD + 0x800, .ta_status = KD + 0x400, .td_status = KD + 0x404,
+	.access = KD + 0x408, .pending = KD + 0x40c, .rt_status = KD + 0x410,
+	.bgpri = KD + 0x414,
+};
+
+/* The first triangle's register words (§14.1, §6, §7, S.6). */
+static const struct drm_sgxfive_render_cmd tri = {
+	.vdm_ctrl_stream_base = 0x3e001000, .te_aa = 0x20000000,
+	.te_mtile1 = 0x01004004, .te_mtile2 = 0x01004004, .te_screen = 0x3001,
+	.te_mtile_stride = 0x10, .mte_ctrl = 0xa2, .mte_wcompare = 0x358637bd,
+	.mte_wclamp = 0x358637bd, .mte_screen = 0x003f003f,
+	.mte_multisamplectl = 0x88, .pixelbe = 0x80, .isp_ipfmisc = 0x000f0000,
+	.aa_mode_3d = 0x80000000, .isp_bgobjdepth = 0x3f800000, .isp_bgobj = 0x300,
+	.isp_multisamplectl = 0x88, .tsp_config = 0x30,
+	.event_pixel_pds_exec = 0x2e001080, .event_pixel_pds_data = 5,
+	.event_pixel_pds_info = 1, .isp_fpuctrl = 1, .isp_depthsort = 0x100,
+	.bgobj_words = { 0x04000104, 0x00030000, 0x04000102 },
+};
+
+static u32 dw(const void *p, unsigned int off)
+{
+	const u8 *b = p;
+
+	return b[off] | b[off + 1] << 8 | b[off + 2] << 16 | (u32)b[off + 3] << 24;
+}
+
+/* Every offset the EDM trace names (§12.2-§12.4) lands on our field. */
+static void sgx_render_test_offsets(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CMD_VPART, 4 * 5);	/* CMDTA dw5 */
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CMD_RD, 4 * 14);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CMD_DSTSYNC, 4 * 15);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CMD_RTDATA, 4 * 17);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_SH_TATQ, 4 * 25);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CMD_TAREGS, 4 * 142);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CMD_3DREGUPD, 4 * 170);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CMD_SIZE, SGX_RENDER_CMD_3DREGUPD + 8);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CMD_STRIDE, ALIGN(SGX_RENDER_CMD_SIZE, 64));
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RD_TQSYNC, 4 * 57);	/* rd dw57 */
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RD_NEXTRT, 4 * 66);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RD_BGPRI_LIST, 4 * 69);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RD_TESTATE, 4 * 73);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RD_ACCESS, 4 * 52);	/* after 52 registers */
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RD_DEPTHSORT, 4 * 51);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RT_RD, 4 * 1);		/* rtdata dw1 */
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RT_STATE, 4 * 5);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RT_CONTROL, 4 * 6);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RT_OTPM, 4 * 7);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RT_COMMON, 4 * 13);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RTDS_RT, 0x18);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_RTDS_SIZE, 0x18 + 0x38);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CTX_TACOUNT, 4 * 5);	/* ctx dw5 */
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CTX_PBDESC, 4 * 6);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CTX_PARTIAL, 4 * 8);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_CTX_COMPLETE, 4 * 10);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_PB_ALLOC, 4 * 5);	/* pb dw5 */
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_PB_TA_THRESH, 4 * 10);
+	/* The parameter slot's items do not overlap and fit 8 MiB. */
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_PARAM_PB + SGX_RENDER_PB_PAGES * 4096,
+			SGX_RENDER_PARAM_PT);
+	KUNIT_EXPECT_EQ(test, SGX_RENDER_PARAM_PT + SGX_RENDER_PT_BYTES,
+			SGX_RENDER_PARAM_PRIM);
+	KUNIT_EXPECT_LE(test, SGX_RENDER_PARAM_BG + 4096, SGX_RENDER_PARAM_SIZE);
+	KUNIT_EXPECT_LE(test, SGX_RENDER_PARAM_SIZE, SZ_8M);
+	/* The UAPI command: version 1 and the struct agree. */
+	KUNIT_EXPECT_EQ(test, sizeof(struct drm_sgxfive_render_cmd),
+			(size_t)DRM_SGXFIVE_RENDER_CMD_SIZE_V1);
+}
+
+static void sgx_render_test_ctx(struct kunit *test)
+{
+	u32 *ctx = kunit_kzalloc(test, SGX_RENDER_CTX_SIZE, GFP_KERNEL);
+	unsigned int off;
+
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	memset(ctx, 0xa5, SGX_RENDER_CTX_SIZE);
+	sgx_render_ctx(ctx, &addrs);
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x00), 1u);		/* new context */
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x04), 0u);		/* priority 0 */
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x08), 0x039ea000u);
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x0c), 0x32140000u);	/* TA CCB */
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x10), KD + 0x000);
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x18), KD + 0x300);
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x1c), 0x10463000u);
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x14), 0u);		/* the EDM's */
+	for (off = 0x20; off < SGX_RENDER_CTX_SIZE; off += 4)
+		KUNIT_EXPECT_EQ_MSG(test, dw(ctx, off), 0u, "offset %#x", off);
+}
+
+/* §12.4: the capture's descriptor, block and page table for 0x422 pages. */
+static void sgx_render_test_pb(struct kunit *test)
+{
+	u32 *desc = kunit_kzalloc(test, SGX_RENDER_PBDESC_SIZE, GFP_KERNEL);
+	u32 *block = kunit_kzalloc(test, SGX_RENDER_PBBLOCK_SIZE, GFP_KERNEL);
+	u32 *pt = kunit_kzalloc(test, SGX_RENDER_PT_BYTES, GFP_KERNEL);
+	static const u32 want[] = {
+		0, 0x422, 0x04220001, 0x04210000, 0x10423000, 0, 0x04220001,
+		0x04210000, 0, 0, 0x432, 0x400, 0x400, 0x300,
+	};
+	unsigned int i, nonzero = 0;
+
+	KUNIT_ASSERT_NOT_NULL(test, pt);
+	KUNIT_ASSERT_NOT_NULL(test, desc);
+	KUNIT_ASSERT_NOT_NULL(test, block);
+	memset(pt, 0xa5, SGX_RENDER_PT_BYTES);
+	sgx_render_pb(desc, block, pt, &addrs);
+	for (i = 0; i < ARRAY_SIZE(want); i++)
+		KUNIT_EXPECT_EQ_MSG(test, desc[i], want[i], "dword %u", i);
+	KUNIT_EXPECT_EQ(test, desc[14], KD + 0x340);
+	KUNIT_EXPECT_EQ(test, block[0], 0x422u);
+	KUNIT_EXPECT_EQ(test, block[1], 0x04220001u);
+	KUNIT_EXPECT_EQ(test, block[2], KD + 0x300);
+	KUNIT_EXPECT_EQ(test, block[3], 0u);
+	KUNIT_EXPECT_EQ(test, pt[0], 0u);
+	KUNIT_EXPECT_EQ(test, pt[1], 0xffff0002u);
+	KUNIT_EXPECT_EQ(test, pt[2], 0x00010003u);
+	KUNIT_EXPECT_EQ(test, pt[0x421], 0x04200422u);
+	KUNIT_EXPECT_EQ(test, pt[0x422], 0x0421ffffu);
+	for (i = 0; i < SGX_RENDER_PT_BYTES / 4; i++)
+		nonzero += pt[i] != 0;
+	KUNIT_EXPECT_EQ(test, nonzero, 0x422u);
+}
+
+static void sgx_render_test_rtds(struct kunit *test)
+{
+	u32 *r = kunit_kzalloc(test, SGX_RENDER_RTDS_SIZE, GFP_KERNEL);
+	const u8 *rt;
+
+	KUNIT_ASSERT_NOT_NULL(test, r);
+	memset(r, 0xa5, SGX_RENDER_RTDS_SIZE);
+	sgx_render_rtds(r, &addrs);
+	rt = (const u8 *)r + SGX_RENDER_RTDS_RT;
+	KUNIT_EXPECT_EQ(test, dw(r, 0x00), KD + 0x40c);		/* pending */
+	KUNIT_EXPECT_EQ(test, dw(r, 0x04), 0u);
+	KUNIT_EXPECT_EQ(test, dw(r, 0x08), 8u);			/* MTileWidth */
+	KUNIT_EXPECT_EQ(test, dw(r, 0x0c), 0u);
+	KUNIT_EXPECT_EQ(test, dw(r, 0x10), 0u);
+	KUNIT_EXPECT_EQ(test, dw(r, 0x14), 1u);			/* one RT data */
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x00), KD + 0x100);
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x04), 0u);		/* the EDM's */
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x08), 1u);
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x0c), 0xc0u);
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x10), 0x10464000u);
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x14), 0x20004000u);	/* DPM state */
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x18), 0x20002000u);	/* DPM control */
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x1c), 0x20003000u);	/* OTPM */
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x20), 0x20001000u);	/* tail pointers */
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x24), 0x100u);
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x28), 1u);
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x2c), 0u);
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x30), KD + 0x410);	/* RT status */
+	KUNIT_EXPECT_EQ(test, dw(rt, 0x34), 0x10u);		/* free */
+}
+
+/* §12.6 "render details": the first triangle's, as the laptop ran it. */
+static void sgx_render_test_rd(struct kunit *test)
+{
+	u32 *rd = kunit_kzalloc(test, SGX_RENDER_RD_SIZE, GFP_KERNEL);
+	static const struct { u16 off; u32 val; } want[] = {
+		{ 0x000, 0x10000000 }, { 0x008, 0x80 }, { 0x00c, 0x000f0000 },
+		{ 0x010, 0x80000000 }, { 0x020, 0x20005000 }, { 0x028, 0x20006000 },
+		{ 0x038, 0x80000000 }, { 0x03c, 0x80000000 }, { 0x040, 0x3f800000 },
+		{ 0x044, 0x300 }, { 0x048, 0x46400 }, { 0x050, 0x88 }, { 0x058, 0x30 },
+		{ 0x05c, 0x2e001080 }, { 0x060, 5 }, { 0x064, 1 }, { 0x068, 1 },
+		{ 0x0cc, 0x100 }, { 0x0d0, 0x32152408 }, { 0x0d8, 0x32152200 },
+		{ 0x0dc, 0x32152218 }, { 0x104, 1 }, { 0x114, 0x32152414 },
+		{ 0x13c, 0x07c00000 },
+	};
+	unsigned int i, j;
+
+	KUNIT_ASSERT_NOT_NULL(test, rd);
+	memset(rd, 0xa5, SGX_RENDER_RD_SIZE);
+	sgx_render_rd(rd, &addrs, &tri);
+	for (i = 0; i < SGX_RENDER_RD_SIZE; i += 4) {
+		u32 v = 0;
+
+		for (j = 0; j < ARRAY_SIZE(want); j++)
+			if (want[j].off == i)
+				v = want[j].val;
+		KUNIT_EXPECT_EQ_MSG(test, dw(rd, i), v, "offset %#x", i);
+	}
+}
+
+/*
+ * Each user 3D register lands in its own render-details word, and the
+ * kernel's words do not move whatever the user's are.
+ */
+static void sgx_render_test_rd_user(struct kunit *test)
+{
+	u32 *rd = kunit_kzalloc(test, SGX_RENDER_RD_SIZE, GFP_KERNEL);
+	struct drm_sgxfive_render_cmd c = tri;
+
+	KUNIT_ASSERT_NOT_NULL(test, rd);
+	c.pixelbe = 0x101;
+	c.isp_ipfmisc = 0x102;
+	c.aa_mode_3d = 0x103;
+	c.isp_bgobjdepth = 0x104;
+	c.isp_bgobj = 0x200;
+	c.isp_multisamplectl = 0x106;
+	c.tsp_config = 0x107;
