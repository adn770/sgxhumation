diff --git a/drivers/gpu/drm/gma500/sgx_xfer.c b/drivers/gpu/drm/gma500/sgx_xfer.c
new file mode 100644
index 000000000000..9271e16c0e14
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgx_xfer.c
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Builders for the SGX545 transfer queue (design/sgx545_transfer.md). A dummy
+ * transfer runs the EDM's whole queue path except the render: the sync test,
+ * the BIF directory-list switch, the memory updates, the status writes, the
+ * SW_EVENT interrupt and the client CCB advance.
+ */
+#include "sgx_xfer.h"
+
+static void put32(u8 *p, unsigned int off, u32 v)
+{
+	p[off] = v;
+	p[off + 1] = v >> 8;
+	p[off + 2] = v >> 16;
+	p[off + 3] = v >> 24;
+}
+
+/* Returns the command's size in the CCB: its used part, in 64-byte units. */
+u32 sgx_xfer_dummy(u8 *cmd, u32 status_addr, u32 status_val, u32 update_addr,
+		   u32 update_val)
+{
+	const u32 size = (SGX_XFER_UPDATES + 8 + 0x3f) & ~0x3fu;
+	unsigned int i;
+
+	for (i = 0; i < SGX_XFER_CMD_SIZE; i++)
+		cmd[i] = 0;
+	put32(cmd, SGX_XFER_SIZE, size);
+	put32(cmd, SGX_XFER_FLAGS, SGX_XFER_FLAG_DUMMY);
+	put32(cmd, SGX_XFER_NUM_STATUS, 1);
+	put32(cmd, SGX_XFER_STATUS, status_addr);
+	put32(cmd, SGX_XFER_STATUS + 4, status_val);
+	put32(cmd, SGX_XFER_NUM_UPDATES, 1);
+	put32(cmd, SGX_XFER_UPDATES, update_addr);
+	put32(cmd, SGX_XFER_UPDATES + 4, update_val);
+	return size;
+}
+
+/* A priority-0 context: the EDM scans only that queue. */
+void sgx_xfer_ctx_init(u8 *ctx, u32 pd_phys, u32 ccb, u32 ccb_ctl)
+{
+	unsigned int i;
+
+	for (i = 0; i < SGX_XFER_CTX_SIZE; i++)
+		ctx[i] = 0;
+	put32(ctx, SGX_XFER_CTX_PD, pd_phys);
+	put32(ctx, SGX_XFER_CTX_CCB, ccb);
+	put32(ctx, SGX_XFER_CTX_CCB_CTL, ccb_ctl);
+}
diff --git a/drivers/gpu/drm/gma500/sgx_xfer.h b/drivers/gpu/drm/gma500/sgx_xfer.h
new file mode 100644
index 000000000000..b328b6b16146
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgx_xfer.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * SGX545 transfer-queue structures: SGXMKIF_TRANSFERCMD (0x4c8 bytes) and
+ * SGXMKIF_HWTRANSFERCONTEXT (0xb4), laid out as design/sgx545_transfer.md §2.
+ */
+#ifndef _GMA500_SGX_XFER_H_
+#define _GMA500_SGX_XFER_H_
+
+#include "sgx_fw_types.h"
+
+#define SGX_XFER_CMD_SIZE	0x4c8
+#define SGX_XFER_CTX_SIZE	0xb4
+#define SGX_XFER_CCB_SIZE	0x10000		/* the EDM masks the read offset */
+
+/* SGXMKIF_HWTRANSFERCONTEXT */
+#define SGX_XFER_CTX_FLAGS	0x00
+#define SGX_XFER_CTX_PRIORITY	0x04
+#define SGX_XFER_CTX_PD		0x08
+#define SGX_XFER_CTX_CCB	0x0c
+#define SGX_XFER_CTX_CCB_CTL	0x10
+#define SGX_XFER_CTX_COUNT	0x14
+
+/* SGXMKIF_TRANSFERCMD */
+#define SGX_XFER_SIZE		0x0a4
+#define SGX_XFER_FLAGS		0x0a8
+#define SGX_XFER_SHARED		0x0ac
+#define SGX_XFER_NUM_STATUS	(SGX_XFER_SHARED + 0xb8)
+#define SGX_XFER_STATUS		(SGX_XFER_SHARED + 0xbc)	/* {addr, val}[4] */
+#define SGX_XFER_NUM_UPDATES	0x19c
+#define SGX_XFER_UPDATES	0x1a0				/* {addr, val}[101] */
+#define SGX_XFER_FLAG_DUMMY	0x20		/* SGXMKIF_TQFLAGS_DUMMYTRANSFER */
+
+u32 sgx_xfer_dummy(u8 *cmd, u32 status_addr, u32 status_val, u32 update_addr,
+		   u32 update_val);
+void sgx_xfer_ctx_init(u8 *ctx, u32 pd_phys, u32 ccb, u32 ccb_ctl);
+
+#endif
diff --git a/drivers/gpu/drm/gma500/sgx_xfer_test.c b/drivers/gpu/drm/gma500/sgx_xfer_test.c
new file mode 100644
index 000000000000..ab92645fa070
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgx_xfer_test.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for sgx_xfer.c: SGXMKIF_TRANSFERCMD and SGXMKIF_HWTRANSFERCONTEXT
+ * as built for a dummy transfer (design/sgx545_transfer.md §2, §4.1).
+ */
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include "sgx_xfer.h"
+
+static u32 dw(const u8 *p, unsigned int off)
+{
+	return p[off] | p[off + 1] << 8 | p[off + 2] << 16 | (u32)p[off + 3] << 24;
+}
+
+static void sgx_xfer_test_dummy_cmd(struct kunit *test)
+{
+	u8 *cmd = kunit_kzalloc(test, SGX_XFER_CMD_SIZE, GFP_KERNEL);
+	unsigned int off;
+	u32 size;
+
+	KUNIT_ASSERT_NOT_NULL(test, cmd);
+	memset(cmd, 0xa5, SGX_XFER_CMD_SIZE);
+	size = sgx_xfer_dummy(cmd, 0xf0122004, 0x1234, 0xf0122000, 0xcafe);
+
+	KUNIT_EXPECT_EQ(test, size, 0x1c0u);
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0a4), 0x1c0u);		/* ui32Size */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0a8), 0x20u);		/* DUMMYTRANSFER */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0ac + 0x00), 0u);	/* no src syncs */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0ac + 0x84), 0u);	/* no dst syncs */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0ac + 0x9c), 0u);	/* no TA sync */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0ac + 0xac), 0u);	/* no 3D sync */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0ac + 0xb8), 1u);	/* one status */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0ac + 0xbc), 0xf0122004u);
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0ac + 0xc0), 0x1234u);
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x19c), 1u);		/* one update */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x1a0), 0xf0122000u);
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x1a4), 0xcafeu);
+	/* Everything else is zero, including the register block. */
+	for (off = 0; off < SGX_XFER_CMD_SIZE; off += 4) {
+		if (off == 0x0a4 || off == 0x0a8 || off == 0x0ac + 0xb8 ||
+		    off == 0x0ac + 0xbc || off == 0x0ac + 0xc0 || off == 0x19c ||
+		    off == 0x1a0 || off == 0x1a4)
+			continue;
+		KUNIT_EXPECT_EQ_MSG(test, dw(cmd, off), 0u, "offset %#x", off);
+	}
+}
+
+static void sgx_xfer_test_ctx(struct kunit *test)
+{
+	u8 *ctx = kunit_kzalloc(test, SGX_XFER_CTX_SIZE, GFP_KERNEL);
+	unsigned int off;
+
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	memset(ctx, 0xa5, SGX_XFER_CTX_SIZE);
+	sgx_xfer_ctx_init(ctx, 0x39ea000, 0xf0100000, 0xf0120000);
+
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x00), 0u);		/* flags */
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x04), 0u);		/* priority 0 */
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x08), 0x39ea000u);	/* PD */
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x0c), 0xf0100000u);	/* CCB base */
+	KUNIT_EXPECT_EQ(test, dw(ctx, 0x10), 0xf0120000u);	/* CCB control */
+	for (off = 0x14; off < SGX_XFER_CTX_SIZE; off += 4)
+		KUNIT_EXPECT_EQ_MSG(test, dw(ctx, off), 0u, "offset %#x", off);
+}
+
+static struct kunit_case sgx_xfer_test_cases[] = {
+	KUNIT_CASE(sgx_xfer_test_dummy_cmd),
+	KUNIT_CASE(sgx_xfer_test_ctx),
+	{}
+};
+
+static struct kunit_suite sgx_xfer_test_suite = {
+	.name = "gma500_sgx_xfer",
+	.test_cases = sgx_xfer_test_cases,
+};
+
+kunit_test_suite(sgx_xfer_test_suite);
