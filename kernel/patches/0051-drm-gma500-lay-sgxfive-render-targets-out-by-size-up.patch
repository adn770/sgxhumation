index d7523fee22c86..218283b838da1 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgx_render.c
+++ b/drivers/gpu/drm/gma500/sgxfive/sgx_render.c
@@ -74,27 +74,79 @@ void sgx_render_pb(u32 *desc, u32 *block, u32 *pt, const struct sgx_render_addrs
