diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump.c
new file mode 100644
index 0000000000000..65b302fe33f70
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump.c
@@ -0,0 +1,278 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The sgxfive error state. A recovery reset that is about to reset captures,
+ * under the device lock and before it touches the hardware, a snapshot of
+ * why (the detector, the suspect job, the guilty context), the registers and
+ * firmware control blocks sgxfive_dump() shows, and each context's unfinished
+ * jobs with their saved firmware commands. Once the reset is done the
+ * snapshot goes to devcoredump on the gma500 PCI device, which shows it as
+ * /sys/class/devcoredump/devcdN/data; the text is formatted on each read
+ * with drm_coredump_printer, so nothing large is allocated at capture.
+ *
+ * Capture runs in the recovery paths, one of them the drm_sched timeout, so
+ * it allocates with GFP_NOWAIT and does without a dump when that fails.
+ * devcoredump keeps one dump per device until it is read and written to (or
+ * for five minutes); while one is pending no new one is allocated.
+ */
+#include <linux/devcoredump.h>
+#include <linux/dma-fence.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/utsname.h>
+
+#include <drm/drm_device.h>
+#include <drm/drm_print.h>
+
+#include "sgxfive_coredump.h"
+#include "sgxfive_ctx.h"
+#include "sgxfive_priv.h"
+
+static void sgxfive_print_words(struct drm_printer *p, const char *name,
+				const u32 *w, unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i += 8)
+		drm_printf(p, "%s[%2u]: %*ph\n", name, i,
+			   (int)(min(8u, n - i) * 4), &w[i]);
+}
+
+void sgxfive_devstate_print(struct drm_printer *p, const struct sgxfive_devstate *d)
+{
+	unsigned int i;
+
+	drm_printf(p, "loaded %d live %d sw_events %d bif_faults %d ccb_sent %llu deferred %u\n",
+		   d->loaded, d->live, d->sw_events, d->bif_faults, d->ccb_sent,
+		   d->ndeferred);
+	for (i = 0; i < SGXFIVE_DUMP_NREGS; i++)
+		drm_printf(p, "reg %#05x = %#010x\n", d->regs[i].reg, d->regs[i].val);
+	if (!d->loaded)
+		return;
+	sgxfive_print_words(p, "hostctl", d->hostctl, SGXFIVE_HC_DWORDS);
+	sgxfive_print_words(p, "ta3dctl", d->ta3dctl, SGXFIVE_TA3D_CTL_DWORDS);
+	sgxfive_print_words(p, "ccbctl", d->ccbctl, 2);
+}
+
+/* Under ctx's fence_lock: its unfinished jobs, as many as there is room for. */
+static void sgxfive_coredump_jobs(struct sgxfive_coredump *cd,
+				  struct sgxfive_cd_ctx *c, struct sgxfive_ctx *ctx)
+{
+	struct sgxfive_fence *f;
+
+	c->first_job = cd->njobs;
+	list_for_each_entry(f, &ctx->pending, link) {
+		struct sgxfive_cd_job *j;
+
+		c->npending++;
+		if (cd->njobs == SGXFIVE_CD_MAX_JOBS)
+			continue;
+		j = &cd->jobs[cd->njobs++];
+		c->njobs++;
+		j->seqno = f->base.seqno;
+		j->order = f->order;
+		j->size = f->size;
+		memcpy(j->cmd, f->cmd, min_t(u32, f->size, SGXFIVE_CD_CMD_BYTES));
+	}
+}
+
+static void sgxfive_coredump_ctx(struct sgxfive_coredump *cd, struct sgxfive_ctx *ctx)
+{
+	const u32 *ctl = sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_CTL_OFF);
+	struct sgxfive_cd_ctx *c;
+	unsigned long flags;
+
+	cd->nctxs_seen++;
+	if (cd->nctxs == SGXFIVE_CD_MAX_CTXS)
+		return;
+	c = &cd->ctxs[cd->nctxs++];
+	c->fence_context = ctx->fence_context;
+	if (ctx->client) {
+		c->pid = ctx->client->pid;
+		strscpy(c->comm, ctx->client->comm);
+	}
+	c->lost = READ_ONCE(ctx->lost);
+	c->done = READ_ONCE(*(u32 *)sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_FENCE_OFF));
+	c->woff = READ_ONCE(ctl[0]);
+	c->roff = READ_ONCE(ctl[1]);
+	spin_lock_irqsave(&ctx->fence_lock, flags);
+	sgxfive_coredump_jobs(cd, c, ctx);
+	spin_unlock_irqrestore(&ctx->fence_lock, flags);
+}
+
+/*
+ * Under the device's ctx_lock, before the guilty context's jobs are failed:
+ * every context on ctxs, the guilty one (if any) first.
+ */
+void sgxfive_coredump_ctxs(struct sgxfive_coredump *cd, struct list_head *ctxs,
+			   struct sgxfive_ctx *guilty)
+{
+	struct sgxfive_ctx *ctx;
+
+	cd->guilty = -1;
+	if (guilty) {
+		cd->guilty = cd->nctxs;
+		sgxfive_coredump_ctx(cd, guilty);
+	}
+	list_for_each_entry(ctx, ctxs, link)
+		if (ctx != guilty)
+			sgxfive_coredump_ctx(cd, ctx);
+}
+
+static const char *sgxfive_hang_name(enum sgxfive_hang hang)
+{
+	switch (hang) {
+	case SGXFIVE_HANG_FAULT:
+		return "bif-fault";
+	case SGXFIVE_HANG_TIMEOUT:
+		return "job-timeout";
+	default:
+		return "manual";
+	}
+}
+
+static const char *sgxfive_comm(const struct sgxfive_cd_ctx *c)
+{
+	return c->comm[0] ? c->comm : "?";
+}
+
+/* The non-zero 32-byte lines of a job's command. */
+static void sgxfive_print_cmd(struct drm_printer *p, const struct sgxfive_cd_job *j)
+{
+	u32 n = min_t(u32, j->size, SGXFIVE_CD_CMD_BYTES), off;
+
+	for (off = 0; off < n; off += 32) {
+		u32 len = min(32u, n - off);
+
+		if (memchr_inv(j->cmd + off, 0, len))
+			drm_printf(p, "    cmd[%#05x]: %*ph\n", off, (int)len, j->cmd + off);
+	}
+}
+
+void sgxfive_coredump_print(struct drm_printer *p, const struct sgxfive_coredump *cd)
+{
+	u64 up = cd->uptime_ns;
+	u32 up_ns = do_div(up, NSEC_PER_SEC);
+	unsigned int i, k;
+
+	drm_puts(p, "**** sgxfive error state ****\n");
+	drm_printf(p, "kernel: %s\n", init_utsname()->release);
+	drm_printf(p, "time: %lld.%09ld\n", (long long)cd->time.tv_sec,
+		   cd->time.tv_nsec);
+	drm_printf(p, "uptime: %llu.%09u\n", up, up_ns);
+	drm_printf(p, "detector: %s\n", sgxfive_hang_name(cd->hang));
+	if (cd->suspect == U64_MAX)
+		drm_puts(p, "suspect: none\n");
+	else
+		drm_printf(p, "suspect: %llu\n", cd->suspect);
+	if (cd->guilty < 0)
+		drm_puts(p, "guilty: none\n");
+	else
+		drm_printf(p, "guilty: pid %d comm %s\n", cd->ctxs[cd->guilty].pid,
+			   sgxfive_comm(&cd->ctxs[cd->guilty]));
+	if (cd->result)
+		drm_printf(p, "recovery: failed %d\n", cd->result);
+	else
+		drm_puts(p, "recovery: ok\n");
+	drm_printf(p, "BIF_INT_STAT: %#010x\n", cd->bif_int_stat);
+	drm_printf(p, "BIF_FAULT: %#010x\n", cd->bif_fault);
+
+	drm_puts(p, "**** device ****\n");
+	sgxfive_devstate_print(p, &cd->dev);
+
+	drm_printf(p, "**** contexts ****\ncontexts: %u (%u saved)\n",
+		   cd->nctxs_seen, cd->nctxs);
+	for (i = 0; i < cd->nctxs; i++) {
+		const struct sgxfive_cd_ctx *c = &cd->ctxs[i];
+
+		drm_printf(p, "ctx %llu%s pid %d comm %s", c->fence_context,
+			   (int)i == cd->guilty ? " guilty" : "", c->pid, sgxfive_comm(c));
+		drm_printf(p, " done %u woff %#x roff %#x lost %d pending %u\n",
+			   c->done, c->woff, c->roff, c->lost, c->npending);
+		for (k = c->first_job; k < c->first_job + c->njobs; k++) {
+			const struct sgxfive_cd_job *j = &cd->jobs[k];
+
+			drm_printf(p, "  job %u order %llu size %#x\n", j->seqno,
+				   j->order, j->size);
+			sgxfive_print_cmd(p, j);
+		}
+		if (c->npending > c->njobs)
+			drm_printf(p, "  %u jobs not saved\n", c->npending - c->njobs);
+	}
+	drm_puts(p, "**** end ****\n");
+}
+
+/* devcoredump's read: the text from offset, at most count bytes of it. */
+ssize_t sgxfive_coredump_read(char *buf, loff_t offset, size_t count, void *data,
+			      size_t datalen)
+{
+	struct drm_print_iterator iter = {
+		.data = buf, .start = offset, .remain = count,
+	};
+	struct drm_printer p = drm_coredump_printer(&iter);
+
+	sgxfive_coredump_print(&p, data);
+	return count - iter.remain;
+}
+
+#define SGXFIVE_CD_PENDING	0	/* bit in sgx->coredump: one with devcoredump */
+
+/*
+ * A snapshot for a recovery that is about to reset, or NULL: without
+ * devcoredump, while a dump is still pending, or when memory is short.
+ */
+struct sgxfive_coredump *sgxfive_coredump_alloc(struct sgxfive *sgx,
+						enum sgxfive_hang hang, u64 suspect)
+{
+	struct sgxfive_coredump *cd;
+
+	if (!IS_ENABLED(CONFIG_DEV_COREDUMP) ||
+	    test_and_set_bit(SGXFIVE_CD_PENDING, &sgx->coredump))
+		return NULL;
+	cd = kzalloc_obj(*cd, GFP_NOWAIT | __GFP_NOWARN);
+	if (!cd) {
+		clear_bit(SGXFIVE_CD_PENDING, &sgx->coredump);
+		return NULL;
+	}
+	cd->sgx = sgx;
+	ktime_get_real_ts64(&cd->time);
+	cd->uptime_ns = ktime_get_boottime_ns();
+	cd->hang = hang;
+	cd->suspect = suspect;
+	cd->guilty = -1;
+	return cd;
+}
+
+/* A snapshot that is not used, or devcoredump is done with it. */
+static void sgxfive_coredump_free(void *data)
+{
+	struct sgxfive_coredump *cd = data;
+
+	clear_bit(SGXFIVE_CD_PENDING, &cd->sgx->coredump);
+	kfree(cd);
+}
+
+void sgxfive_coredump_discard(struct sgxfive_coredump *cd)
+{
+	if (cd)
+		sgxfive_coredump_free(cd);
+}
+
+/* Outside the device lock: hand the snapshot to devcoredump. */
+void sgxfive_coredump_emit(struct sgxfive_coredump *cd)
+{
+	if (!cd)
+		return;
+	drm_info(cd->sgx->dev, "sgxfive: error state captured in /sys/class/devcoredump\n");
+	dev_coredumpm(cd->sgx->dev->dev, THIS_MODULE, cd, sizeof(*cd),
+		      GFP_NOWAIT | __GFP_NOWARN, sgxfive_coredump_read,
+		      sgxfive_coredump_free);
+}
+
+/* Teardown: free a dump still pending, so its callbacks run while sgx lives. */
+void sgxfive_coredump_fini(struct sgxfive *sgx)
+{
+	dev_coredump_put(sgx->dev->dev);
+}
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump.h b/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump.h
new file mode 100644
index 0000000000000..ba9ffddabbf52
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump.h
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * sgxfive error state (sgxfive_coredump.c): what a recovery reset captures
+ * before it resets, handed to devcoredump and formatted when it is read.
+ */
+#ifndef _SGXFIVE_COREDUMP_H_
+#define _SGXFIVE_COREDUMP_H_
+
+#include <linux/list.h>
+#include <linux/sched.h>
+#include <linux/time64.h>
+#include <linux/types.h>
+
+struct drm_printer;
+struct sgxfive;
+struct sgxfive_ctx;
+
+/* What sgxfive_dump() shows: registers, HostCtl, TA3DCtl, CCB control. */
+#define SGXFIVE_DUMP_NREGS	17
+#define SGXFIVE_HC_DWORDS	17
+#define SGXFIVE_TA3D_CTL_DWORDS	(0xec / 4)
+
+struct sgxfive_devstate {
+	bool loaded, live;
+	int sw_events, bif_faults;
+	u64 ccb_sent;
+	unsigned int ndeferred;
+	struct { u32 reg, val; } regs[SGXFIVE_DUMP_NREGS];
+	u32 hostctl[SGXFIVE_HC_DWORDS];
+	u32 ta3dctl[SGXFIVE_TA3D_CTL_DWORDS];
+	u32 ccbctl[2];
+};
+
+void sgxfive_devstate_print(struct drm_printer *p, const struct sgxfive_devstate *d);
+
+/* Which detector found the hang. */
+enum sgxfive_hang {
+	SGXFIVE_HANG_MANUAL,		/* debugfs reset */
+	SGXFIVE_HANG_FAULT,		/* the BIF fault watchdog */
+	SGXFIVE_HANG_TIMEOUT,		/* the drm_sched job timeout */
+};
+
+/*
+ * Bounds: the guilty context first, then the others in creation order, and
+ * the command words of the first SGXFIVE_CD_MAX_JOBS unfinished jobs. The
+ * text stays below SGXFIVE_COREDUMP_MAX.
+ */
+#define SGXFIVE_CD_MAX_CTXS	8
+#define SGXFIVE_CD_MAX_JOBS	8
+#define SGXFIVE_CD_CMD_BYTES	0x1c0	/* a transfer's size in the client CCB */
+#define SGXFIVE_COREDUMP_MAX	(32 * 1024)
+
+struct sgxfive_cd_job {
+	u64 order;			/* device-wide, when the firmware got it */
+	u32 seqno, size;
+	u8 cmd[SGXFIVE_CD_CMD_BYTES];
+};
+
+struct sgxfive_cd_ctx {
+	u64 fence_context;
+	pid_t pid;			/* of the process that opened the file */
+	char comm[TASK_COMM_LEN];
+	bool lost;
+	u32 done;			/* the fence word: last job finished */
+	u32 woff, roff;			/* client CCB offsets */
+	u32 npending;			/* unfinished jobs */
+	u32 first_job, njobs;		/* the saved ones, in jobs[] */
+};
+
+struct sgxfive_coredump {
+	struct sgxfive *sgx;
+	struct timespec64 time;		/* wall clock at capture */
+	u64 uptime_ns;			/* boot time, as in dmesg */
+	enum sgxfive_hang hang;
+	u64 suspect;			/* the job's order, U64_MAX: none */
+	int guilty;			/* index in ctxs, -1: none */
+	int result;			/* of the reset */
+	u32 bif_int_stat, bif_fault;
+	struct sgxfive_devstate dev;
+	u32 nctxs, nctxs_seen;
+	u32 njobs;
+	struct sgxfive_cd_ctx ctxs[SGXFIVE_CD_MAX_CTXS];
+	struct sgxfive_cd_job jobs[SGXFIVE_CD_MAX_JOBS];
+};
+
+void sgxfive_coredump_ctxs(struct sgxfive_coredump *cd, struct list_head *ctxs,
+			   struct sgxfive_ctx *guilty);
+void sgxfive_coredump_print(struct drm_printer *p, const struct sgxfive_coredump *cd);
+ssize_t sgxfive_coredump_read(char *buf, loff_t offset, size_t count, void *data,
+			      size_t datalen);
+
+struct sgxfive_coredump *sgxfive_coredump_alloc(struct sgxfive *sgx,
+						enum sgxfive_hang hang, u64 suspect);
+void sgxfive_coredump_discard(struct sgxfive_coredump *cd);
+void sgxfive_coredump_emit(struct sgxfive_coredump *cd);
+void sgxfive_coredump_fini(struct sgxfive *sgx);
+
+#endif
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump_test.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump_test.c
new file mode 100644
index 0000000000000..84b5f32f5aec9
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_coredump_test.c
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the sgxfive error state (sgxfive_coredump.c): what a
+ * recovery captures of the contexts and their unfinished jobs, its bounds,
+ * and the text devcoredump reads, whole or in pieces.
+ */
+#include <kunit/test.h>
+#include <linux/dma-fence.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include <drm/drm_print.h>
+
+#include "sgx_xfer.h"
+#include "sgxfive_coredump.h"
+#include "sgxfive_ctx.h"
+#include "sgxfive_priv.h"
+
+static struct sgxfive_ctx *fake_ctx(struct kunit *test, struct list_head *list,
+				    struct sgxfive_client *client)
+{
+	struct sgxfive_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->mem.va = kunit_kzalloc(test, SGXFIVE_CTX_MEM_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->mem.va);
+	ctx->fence_context = dma_fence_context_alloc(1);
+	ctx->client = client;
+	spin_lock_init(&ctx->fence_lock);
+	INIT_LIST_HEAD(&ctx->pending);
+	list_add_tail(&ctx->link, list);
+	return ctx;
+}
+
+/* Job seqno of ctx, given to the firmware as order; fill marks its command. */
+static struct dma_fence *fake_job(struct kunit *test, struct sgxfive_ctx *ctx,
+				  u32 seqno, u64 order, u8 fill)
+{
+	struct sgxfive_fence *hw = sgxfive_fence_alloc();
+
+	KUNIT_ASSERT_NOT_NULL(test, hw);
+	memset(hw->cmd, 0, SGX_XFER_CMD_SIZE);
+	hw->cmd[0] = fill;
+	hw->cmd[0x40] = fill;		/* the line at 0x40; 0x20 stays zero */
+	return sgxfive_fence_init(hw, ctx, seqno, order, 0x1c0);
+}
+
+static void put_jobs(struct sgxfive_ctx *ctx, struct dma_fence **f, int n)
+{
+	int i;
+
+	sgxfive_fence_fail_all(ctx, -EIO);
+	for (i = 0; i < n; i++)
+		dma_fence_put(f[i]);
+}
+
+static struct sgxfive_coredump *new_dump(struct kunit *test)
+{
+	struct sgxfive_coredump *cd = kunit_kzalloc(test, sizeof(*cd), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, cd);
+	cd->hang = SGXFIVE_HANG_FAULT;
+	cd->suspect = 11;
+	cd->guilty = -1;
+	return cd;
+}
+
+/* The whole text, as one read from offset 0 would return it. */
+static char *dump_text(struct kunit *test, struct sgxfive_coredump *cd,
+		       ssize_t *len)
+{
+	char *buf = kunit_kzalloc(test, SGXFIVE_COREDUMP_MAX + 1, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	*len = sgxfive_coredump_read(buf, 0, SGXFIVE_COREDUMP_MAX, cd, sizeof(*cd));
+	KUNIT_ASSERT_GT(test, *len, 0);
+	KUNIT_ASSERT_LT(test, *len, SGXFIVE_COREDUMP_MAX);
+	return buf;
+}
+
+/*
+ * The guilty context comes first with its unfinished jobs and their command
+ * words, then the others; signalled jobs are not in it.
+ */
+static void sgxfive_coredump_test_capture(struct kunit *test)
+{
+	struct sgxfive_client client = { .pid = 4242 };
+	struct sgxfive_coredump *cd = new_dump(test);
+	struct sgxfive_ctx *a, *b;
+	struct dma_fence *fa[2], *fb[3];
+	LIST_HEAD(list);
+	int i;
+
+	strscpy(client.comm, "faulter");
+	a = fake_ctx(test, &list, NULL);
+	b = fake_ctx(test, &list, &client);
+	fa[0] = fake_job(test, a, 1, 10, 0xa1);
+	fa[1] = fake_job(test, a, 2, 12, 0xa2);
+	for (i = 0; i < 3; i++)
+		fb[i] = fake_job(test, b, 5 + i, 11 + 2 * i, 0xb0 + i);
+	*(u32 *)sgxfive_ctx_cpu(b, SGXFIVE_CTX_FENCE_OFF) = 4;
+	*(u32 *)sgxfive_ctx_cpu(b, SGXFIVE_CTX_CTL_OFF) = 0x540;
+	*(u32 *)sgxfive_ctx_cpu(b, SGXFIVE_CTX_CTL_OFF + 4) = 0x1c0;
+
+	sgxfive_coredump_ctxs(cd, &list, b);
+
+	KUNIT_EXPECT_EQ(test, cd->nctxs, 2);
+	KUNIT_EXPECT_EQ(test, cd->nctxs_seen, 2);
+	KUNIT_EXPECT_EQ(test, cd->guilty, 0);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].fence_context, b->fence_context);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].pid, 4242);
+	KUNIT_EXPECT_STREQ(test, cd->ctxs[0].comm, "faulter");
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].done, 4);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].woff, 0x540);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].roff, 0x1c0);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].npending, 3);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].njobs, 3);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[1].fence_context, a->fence_context);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[1].pid, 0);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[1].first_job, 3);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[1].njobs, 2);
+	KUNIT_EXPECT_EQ(test, cd->njobs, 5);
+	KUNIT_EXPECT_EQ(test, cd->jobs[0].seqno, 5);
+	KUNIT_EXPECT_EQ(test, cd->jobs[0].order, 11);
+	KUNIT_EXPECT_EQ(test, cd->jobs[0].size, 0x1c0);
+	KUNIT_EXPECT_EQ(test, cd->jobs[0].cmd[0], 0xb0);
+	KUNIT_EXPECT_EQ(test, cd->jobs[2].cmd[0x40], 0xb2);
+	KUNIT_EXPECT_EQ(test, cd->jobs[4].seqno, 2);
+
+	/* Signalled jobs are no longer pending. */
+	*(u32 *)sgxfive_ctx_cpu(a, SGXFIVE_CTX_FENCE_OFF) = 1;
+	sgxfive_fence_signal(a);
+	cd = new_dump(test);
+	sgxfive_coredump_ctxs(cd, &list, NULL);
+	KUNIT_EXPECT_EQ(test, cd->guilty, -1);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].fence_context, a->fence_context);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].npending, 1);
+	KUNIT_EXPECT_EQ(test, cd->jobs[0].seqno, 2);
+
+	put_jobs(a, fa, 2);
+	put_jobs(b, fb, 3);
+}
+
+/* At most SGXFIVE_CD_MAX_JOBS commands and SGXFIVE_CD_MAX_CTXS contexts. */
+static void sgxfive_coredump_test_bounds(struct kunit *test)
+{
+	struct sgxfive_coredump *cd = new_dump(test);
+	struct sgxfive_ctx *ctx[SGXFIVE_CD_MAX_CTXS + 2];
+	struct dma_fence *f[SGXFIVE_CD_MAX_CTXS + 2][2];
+	unsigned int i, n = ARRAY_SIZE(ctx);
+	char *text;
+	ssize_t len;
+	LIST_HEAD(list);
+
+	for (i = 0; i < n; i++) {
+		ctx[i] = fake_ctx(test, &list, NULL);
+		f[i][0] = fake_job(test, ctx[i], 1, 2 * i, 0x11);
+		f[i][1] = fake_job(test, ctx[i], 2, 2 * i + 1, 0x22);
+	}
+	sgxfive_coredump_ctxs(cd, &list, ctx[n - 1]);
+
+	KUNIT_EXPECT_EQ(test, cd->nctxs, SGXFIVE_CD_MAX_CTXS);
+	KUNIT_EXPECT_EQ(test, cd->nctxs_seen, n);
+	KUNIT_EXPECT_EQ(test, cd->guilty, 0);	/* kept although it is last */
+	KUNIT_EXPECT_EQ(test, cd->ctxs[0].fence_context, ctx[n - 1]->fence_context);
+	KUNIT_EXPECT_EQ(test, cd->njobs, SGXFIVE_CD_MAX_JOBS);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[SGXFIVE_CD_MAX_CTXS - 1].npending, 2);
+	KUNIT_EXPECT_EQ(test, cd->ctxs[SGXFIVE_CD_MAX_CTXS - 1].njobs, 0);
+
+	text = dump_text(test, cd, &len);
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "contexts: 10 (8 saved)\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "  2 jobs not saved\n"));
+
+	for (i = 0; i < n; i++)
+		put_jobs(ctx[i], f[i], 2);
+}
+
+/* The header lines, the device state and each job's non-zero command lines. */
+static void sgxfive_coredump_test_print(struct kunit *test)
+{
+	struct sgxfive_client client = { .pid = 77 };
+	struct sgxfive_coredump *cd = new_dump(test);
+	struct sgxfive_ctx *a;
+	struct dma_fence *f[1];
+	LIST_HEAD(list);
+	ssize_t len;
+	char *text;
+
+	strscpy(client.comm, "igt");
+	a = fake_ctx(test, &list, &client);
+	f[0] = fake_job(test, a, 3, 11, 0x5a);
+	sgxfive_coredump_ctxs(cd, &list, a);
+	cd->time.tv_sec = 1700000000;
+	cd->time.tv_nsec = 5;
+	cd->uptime_ns = 12ULL * NSEC_PER_SEC + 345000;
+	cd->bif_int_stat = 0x1;
+	cd->bif_fault = 0x3e100000;
+	cd->result = 0;
+	cd->dev.loaded = true;
+	cd->dev.live = true;
+	cd->dev.regs[0].reg = 0xc08;
+	cd->dev.regs[0].val = 0x3e100000;
+	cd->dev.hostctl[0] = 0x1;
+
+	text = dump_text(test, cd, &len);
+	KUNIT_EXPECT_EQ(test, strncmp(text, "**** sgxfive error state ****\n", 30), 0);
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\ntime: 1700000000.000000005\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nuptime: 12.000345000\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\ndetector: bif-fault\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nsuspect: 11\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nrecovery: ok\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nBIF_INT_STAT: 0x00000001\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nBIF_FAULT: 0x3e100000\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nguilty: pid 77 comm igt\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nloaded 1 live 1 "));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nreg 0xc08 = 0x3e100000\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nhostctl[ 0]: 01 00 00 00 "));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\ncontexts: 1 (1 saved)\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, " guilty pid 77 comm igt done 0 "));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\n  job 3 order 11 size 0x1c0\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\n    cmd[0x000]: 5a 00 "));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\n    cmd[0x040]: 5a 00 "));
+	KUNIT_EXPECT_NULL(test, strstr(text, "cmd[0x020]"));	/* all zero */
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\n**** end ****\n"));
+
+	/* A manual reset blames no one; a failed one says so. */
+	cd->hang = SGXFIVE_HANG_MANUAL;
+	cd->suspect = U64_MAX;
+	cd->guilty = -1;
+	cd->result = -ETIMEDOUT;
+	text = dump_text(test, cd, &len);
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\ndetector: manual\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nsuspect: none\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nguilty: none\n"));
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\nrecovery: failed -110\n"));
+	cd->hang = SGXFIVE_HANG_TIMEOUT;
+	text = dump_text(test, cd, &len);
+	KUNIT_EXPECT_NOT_NULL(test, strstr(text, "\ndetector: job-timeout\n"));
+
+	put_jobs(a, f, 1);
+}
+
+/* Reads in small pieces at increasing offsets give the same text. */
+static void sgxfive_coredump_test_read(struct kunit *test)
+{
+	struct sgxfive_coredump *cd = new_dump(test);
+	struct sgxfive_ctx *a;
+	struct dma_fence *f[2];
+	char *whole, *pieces;
+	ssize_t len, off = 0, n;
+	LIST_HEAD(list);
+
+	a = fake_ctx(test, &list, NULL);
+	f[0] = fake_job(test, a, 1, 1, 0x33);
+	f[1] = fake_job(test, a, 2, 2, 0x44);
+	sgxfive_coredump_ctxs(cd, &list, a);
+	whole = dump_text(test, cd, &len);
+	pieces = kunit_kzalloc(test, len + 64, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, pieces);
+	do {
+		n = sgxfive_coredump_read(pieces + off, off, 37, cd, sizeof(*cd));
+		KUNIT_ASSERT_GE(test, n, 0);
+		KUNIT_ASSERT_LE(test, n, 37);
+		off += n;
+	} while (n && off <= len);
+	KUNIT_EXPECT_EQ(test, off, len);
+	KUNIT_EXPECT_EQ(test, memcmp(whole, pieces, len), 0);
+	KUNIT_EXPECT_EQ(test, sgxfive_coredump_read(pieces, len, 37, cd, sizeof(*cd)), 0);
+
+	put_jobs(a, f, 2);
+}
+
+static struct kunit_case sgxfive_coredump_test_cases[] = {
+	KUNIT_CASE(sgxfive_coredump_test_capture),
+	KUNIT_CASE(sgxfive_coredump_test_bounds),
+	KUNIT_CASE(sgxfive_coredump_test_print),
+	KUNIT_CASE(sgxfive_coredump_test_read),
+	{}
+};
+
+static struct kunit_suite sgxfive_coredump_test_suite = {
+	.name = "gma500_sgxfive_coredump",
+	.test_cases = sgxfive_coredump_test_cases,
+};
+
+kunit_test_suite(sgxfive_coredump_test_suite);
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.h b/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.h
index a3852f5a88d0a..86c0486184337 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.h
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.h
@@ -9,6 +9,7 @@
 #include <linux/kref.h>
 #include <linux/list.h>
 #include <linux/mutex.h>
+#include <linux/sched.h>
 #include <linux/spinlock.h>
 
 #include <drm/drm_mm.h>
@@ -30,6 +31,8 @@ struct sgxfive_client {
 	unsigned long faults[SGXFIVE_FAULT_BUDGET];	/* jiffies, a ring */
 	unsigned int nfaults;
 	bool banned;
+	pid_t pid;			/* who opened the file, for error states */
+	char comm[TASK_COMM_LEN];
 };
 
 /* A context's kernel memory: the client CCB, then one page of control data. */
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_priv.h b/drivers/gpu/drm/gma500/sgxfive/sgxfive_priv.h
index 1a29b39a17704..7954c933c36c4 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_priv.h
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_priv.h
@@ -18,6 +18,7 @@
 #include <drm/sgxfive_drm.h>
 
 #include "sgx_fw.h"
+#include "sgxfive_coredump.h"
 
 struct drm_device;
 struct drm_file;
