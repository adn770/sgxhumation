diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.c
new file mode 100644
index 000000000000..aebca4b8a061
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.c
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * sgxfive transfer contexts. Each one is a firmware HW transfer context with
+ * its own client CCB, in kernel memory the EDM reads through its own page
+ * directory, bound for its lifetime to one client VM whose directory the
+ * firmware gives the context's 3D work (design/sgx545_transfer.md §2.2).
+ */
+#include <linux/slab.h>
+#include <linux/xarray.h>
+
+#include <drm/drm_file.h>
+
+#include "sgx_xfer.h"
+#include "sgxfive.h"
+#include "sgxfive_ctx.h"
+#include "sgxfive_priv.h"
+
+static void sgxfive_ctx_release(struct kref *ref)
+{
+	struct sgxfive_ctx *ctx = container_of(ref, struct sgxfive_ctx, ref);
+
+	sgxfive_kmem_free(ctx->sgx, &ctx->node, &ctx->mem);
+	sgxfive_vm_put(ctx->vm);
+	kfree(ctx);
+}
+
+void sgxfive_ctx_put(struct sgxfive_ctx *ctx)
+{
+	kref_put(&ctx->ref, sgxfive_ctx_release);
+}
+
+struct sgxfive_ctx *sgxfive_ctx_get(struct sgxfive_file *f, u32 handle)
+{
+	struct sgxfive_ctx *ctx;
+
+	xa_lock(&f->ctxs);
+	ctx = xa_load(&f->ctxs, handle);
+	if (ctx)
+		kref_get(&ctx->ref);
+	xa_unlock(&f->ctxs);
+	return ctx;
+}
+
+int sgxfive_ioctl_create_ctx(struct sgxfive *sgx, void *data,
+			     struct drm_file *file)
+{
+	struct drm_sgxfive_create_context_args *a = data;
+	struct sgxfive_file *f = file->driver_priv;
+	struct sgxfive_ctx *ctx;
+	int ret;
+
+	if (a->type != DRM_SGXFIVE_CTX_TYPE_TRANSFER || a->flags ||
+	    a->priority != DRM_SGXFIVE_CTX_PRIORITY_NORMAL || a->_padding_14)
+		return -EINVAL;
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->vm = sgxfive_vm_get(f, a->vm_context_handle);
+	if (!ctx->vm) {
+		kfree(ctx);
+		return -EINVAL;
+	}
+	ret = sgxfive_ensure_live(sgx);
+	if (!ret)
+		ret = sgxfive_kmem_alloc(sgx, &ctx->node, &ctx->mem,
+					 SGXFIVE_CTX_MEM_SIZE);
+	if (ret) {
+		sgxfive_vm_put(ctx->vm);
+		kfree(ctx);
+		return ret;
+	}
+	ctx->sgx = sgx;
+	kref_init(&ctx->ref);
+	/* Priority 0, the client CCB and its control block, the client PD. */
+	sgx_xfer_ctx_init(sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_HW_OFF),
+			  sgxfive_vm_pd_phys(ctx->vm),
+			  ctx->mem.addr + SGXFIVE_CTX_CCB_OFF,
+			  ctx->mem.addr + SGXFIVE_CTX_CTL_OFF);
+	ret = xa_alloc(&f->ctxs, &a->handle, ctx, xa_limit_32b, GFP_KERNEL);
+	if (ret)
+		sgxfive_ctx_put(ctx);
+	return ret;
+}
+
+int sgxfive_ioctl_destroy_ctx(struct sgxfive *sgx, void *data,
+			      struct drm_file *file)
+{
+	struct drm_sgxfive_destroy_context_args *a = data;
+	struct sgxfive_file *f = file->driver_priv;
+	struct sgxfive_ctx *ctx;
+
+	if (a->_padding_4)
+		return -EINVAL;
+	ctx = xa_erase(&f->ctxs, a->handle);
+	if (!ctx)
+		return -EINVAL;
+	sgxfive_ctx_put(ctx);
+	return 0;
+}
+
+/* On close: contexts go before the VMs they hold. */
+void sgxfive_ctx_close_all(struct sgxfive_file *f)
+{
+	struct sgxfive_ctx *ctx;
+	unsigned long i;
+
+	xa_for_each(&f->ctxs, i, ctx)
+		sgxfive_ctx_put(ctx);
+	xa_destroy(&f->ctxs);
+}
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.h b/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.h
new file mode 100644
index 000000000000..3a0c163ed21a
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_ctx.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * sgxfive transfer contexts (sgxfive_ctx.c).
+ */
+#ifndef _SGXFIVE_CTX_H_
+#define _SGXFIVE_CTX_H_
+
+#include <linux/kref.h>
+
+#include <drm/drm_mm.h>
+
+#include "sgx_xfer.h"
+#include "sgxfive_priv.h"
+
+/* A context's kernel memory: the client CCB, then one page of control data. */
+#define SGXFIVE_CTX_CCB_OFF	0
+#define SGXFIVE_CTX_PAGE_OFF	ALIGN(SGX_XFER_CCB_SIZE + SGX_XFER_CMD_SIZE, PAGE_SIZE)
+#define SGXFIVE_CTX_HW_OFF	(SGXFIVE_CTX_PAGE_OFF + 0x000)	/* HW context */
+#define SGXFIVE_CTX_CTL_OFF	(SGXFIVE_CTX_PAGE_OFF + 0x100)	/* CCB control */
+#define SGXFIVE_CTX_FENCE_OFF	(SGXFIVE_CTX_PAGE_OFF + 0x200)	/* last seqno */
+#define SGXFIVE_CTX_MEM_SIZE	(SGXFIVE_CTX_PAGE_OFF + PAGE_SIZE)
+
+struct sgxfive_ctx {
+	struct kref ref;
+	struct sgxfive *sgx;
+	struct sgxfive_vm *vm;		/* holds a reference */
+	struct drm_mm_node node;	/* in the kernel data heap */
+	struct sgxfive_buf mem;
+};
+
+static inline void *sgxfive_ctx_cpu(struct sgxfive_ctx *ctx, u32 off)
+{
+	return (u8 *)ctx->mem.va + off;
+}
+
+struct sgxfive_ctx *sgxfive_ctx_get(struct sgxfive_file *f, u32 handle);
+void sgxfive_ctx_put(struct sgxfive_ctx *ctx);
+void sgxfive_ctx_close_all(struct sgxfive_file *f);
+int sgxfive_ioctl_create_ctx(struct sgxfive *sgx, void *data,
+			     struct drm_file *file);
+int sgxfive_ioctl_destroy_ctx(struct sgxfive *sgx, void *data,
+			      struct drm_file *file);
+
+#endif
