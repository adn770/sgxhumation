diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive.c
index ab872ff06b155..36357c0545f7d 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive.c
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive.c
@@ -434,9 +434,9 @@ static void sgxfive_dump(struct sgxfive *sgx, struct drm_printer *p)
 {
 	unsigned int i;
 
-	drm_printf(p, "loaded %d live %d sw_events %d bif_faults %d\n",
+	drm_printf(p, "loaded %d live %d sw_events %d bif_faults %d ccb_sent %llu deferred %u\n",
 		   sgx->loaded, sgx->live, atomic_read(&sgx->sw_events),
-		   atomic_read(&sgx->bif_faults));
+		   atomic_read(&sgx->bif_faults), sgx->ccb_sent, sgx->ndeferred);
 	for (i = 0; i < ARRAY_SIZE(sgxfive_dump_regs); i++)
 		drm_printf(p, "reg %#05x = %#010x\n", sgxfive_dump_regs[i],
 			   sgx_rd(sgx, sgxfive_dump_regs[i]));
@@ -470,6 +470,9 @@ static void sgxfive_halt(struct sgxfive *sgx)
 	WRITE_ONCE(sgx->live, false);
 	drm_info(sgx->dev, "SGX stopped, %d events seen\n",
 		 atomic_read(&sgx->sw_events));
+	/* The BIF is held in reset: nothing deferred is reachable any more. */
+	if (sgx->ndeferred)
+		mod_delayed_work(system_dfl_wq, &sgx->reaper, 0);
 }
 
 static void sgxfive_stop(struct sgxfive *sgx)
@@ -751,6 +754,69 @@ int sgxfive_kick_transfer(struct sgxfive *sgx, u32 hw_ctx_addr)
 	return sgxfive_command(sgx, SGX_CMD_TRANSFER, data, ARRAY_SIZE(data));
 }
 
+#define SGXFIVE_REAP_MS	10
+
+/*
+ * Free, once the firmware cannot reach it, memory it might have cached
+ * translations for: the next kernel-CCB command invalidates the BIF caches
+ * (design §3.3), and the item goes when that command has been processed,
+ * that is when the EDM's read offset has passed it. With the firmware halted
+ * the BIF is in reset, so it goes at once.
+ */
+void sgxfive_defer(struct sgxfive *sgx, struct sgxfive_deferred *d)
+{
+	mutex_lock(&sgx->lock);
+	if (!sgx->live) {
+		mutex_unlock(&sgx->lock);
+		d->free(d);
+		return;
+	}
+	sgx->cache_control |= SGX_CC_INVAL_BIF;
+	d->after = sgx->ccb_sent + 1;
+	list_add_tail(&d->link, &sgx->deferred);
+	sgx->ndeferred++;
+	mutex_unlock(&sgx->lock);
+	queue_delayed_work(system_dfl_wq, &sgx->reaper,
+			   msecs_to_jiffies(SGXFIVE_REAP_MS));
+}
+
+/* Under lock: move what may be freed to due. */
+static void sgxfive_reap_locked(struct sgxfive *sgx, struct list_head *due)
+{
+	u64 done = U64_MAX;
+
+	if (sgx->live) {
+		u32 *ctl = sgxfive_words(sgx, BUF_CCB_CTL);
+
+		rmb(); /* the read offset the EDM wrote */
+		done = sgxfive_ccb_done(sgx->ccb_sent, READ_ONCE(ctl[0]),
+					READ_ONCE(ctl[1]));
+	}
+	sgx->ndeferred -= sgxfive_reap(&sgx->deferred, done, due);
+}
+
+static void sgxfive_reaper(struct work_struct *work)
+{
+	struct sgxfive *sgx = container_of(to_delayed_work(work), struct sgxfive,
+					   reaper);
+	struct sgxfive_deferred *last;
+	LIST_HEAD(due);
+	bool more;
+
+	mutex_lock(&sgx->lock);
+	sgxfive_reap_locked(sgx, &due);
+	last = list_last_entry_or_null(&sgx->deferred, struct sgxfive_deferred, link);
+	/* No command has carried the invalidation yet: send one that does. */
+	if (last && last->after > sgx->ccb_sent)
+		sgxfive_command(sgx, SGX_CMD_PROCESS_QUEUES, NULL, 0);
+	more = sgx->ndeferred;
+	mutex_unlock(&sgx->lock);
+	sgxfive_free_all(&due);
+	if (more)
+		queue_delayed_work(system_dfl_wq, &sgx->reaper,
+				   msecs_to_jiffies(SGXFIVE_REAP_MS));
+}
+
 #define SGXFIVE_WATCHDOG_MS	50
 
 /*
@@ -826,8 +892,10 @@ static int sgxfive_command(struct sgxfive *sgx, unsigned int cmd,
 			     sgxfive_words(sgx, BUF_KICKER),
 			     sgx->fw.meta[SGX_FW_META_KICK + cmd],
 			     sgx->cache_control, data, ndata);
-	if (!ret)
+	if (!ret) {
 		sgx->cache_control = 0;
+		sgx->ccb_sent++;
+	}
 	return ret;
 }
 
@@ -1743,6 +1811,8 @@ struct sgxfive *sgxfive_create(const struct sgxfive_host *host)
 	spin_lock_init(&sgx->ctx_lock);
 	INIT_LIST_HEAD(&sgx->ctx_list);
 	INIT_DELAYED_WORK(&sgx->watchdog, sgxfive_watchdog);
+	INIT_LIST_HEAD(&sgx->deferred);
+	INIT_DELAYED_WORK(&sgx->reaper, sgxfive_reaper);
 	sgx->fault_oldest = U64_MAX;
 	if (sgxfive_sched_init(sgx)) {
 		drm_mm_takedown(&sgx->kmem);
@@ -1792,6 +1862,9 @@ void sgxfive_destroy(struct sgxfive *sgx)
 	mutex_lock(&sgx->lock);
 	sgxfive_unload(sgx);
 	mutex_unlock(&sgx->lock);
+	/* Halted now: whatever is still deferred goes. */
+	cancel_delayed_work_sync(&sgx->reaper);
+	sgxfive_reaper(&sgx->reaper.work);
 	sgxfive_sched_fini(sgx);
 	mutex_destroy(&sgx->lock);
 	drm_mm_takedown(&sgx->kmem);
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_priv.h b/drivers/gpu/drm/gma500/sgxfive/sgxfive_priv.h
index 3be496c17eff2..1a29b39a17704 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_priv.h
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_priv.h
@@ -7,6 +7,7 @@
 #define _SGXFIVE_PRIV_H_
 
 #include <linux/debugfs.h>
+#include <linux/list.h>
 #include <linux/mutex.h>
 #include <linux/wait.h>
 #include <linux/workqueue.h>
@@ -76,12 +77,34 @@ struct sgxfive {
 	u64 kicks;			/* jobs given to the firmware, under lock */
 	u64 hang_oldest;		/* oldest job at the last timeout */
 	struct delayed_work watchdog;	/* BIF fault poll while jobs run */
+
+	/* Deferred release (sgxfive_defer), under lock. */
+	u64 ccb_sent;			/* kernel-CCB commands submitted */
+	struct list_head deferred;	/* in order of after */
+	unsigned int ndeferred;
+	struct delayed_work reaper;
 	u64 fault_oldest;		/* oldest job when a fault was last seen */
 };
 
 struct sgxfive_vm;
 struct sgxfive_client;
 
+/*
+ * Memory the GPU may still reach through stale BIF state: page directories,
+ * page tables and pinned BO pages. Freed by free() once kernel-CCB command
+ * number after, which carries the BIF invalidation, has been processed.
+ */
+struct sgxfive_deferred {
+	struct list_head link;
+	u64 after;
+	void (*free)(struct sgxfive_deferred *d);
+};
+
+u64 sgxfive_ccb_done(u64 sent, u32 woff, u32 roff);
+unsigned int sgxfive_reap(struct list_head *list, u64 done, struct list_head *due);
+void sgxfive_free_all(struct list_head *due);
+void sgxfive_defer(struct sgxfive *sgx, struct sgxfive_deferred *d);
+
 /* Per-open-file state of the render node. */
 struct sgxfive_file {
 	struct xarray vms;		/* handle -> struct sgxfive_vm */
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c
index 395eeebe66a1d..500ca783598d3 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c
@@ -15,6 +15,7 @@
 #include <drm/drm_mm.h>
 
 #include "sgx_mmu.h"
+#include "sgx_seq.h"
 #include "sgxfive.h"
 #include "sgxfive_ctx.h"
 #include "sgxfive_priv.h"
@@ -25,13 +26,45 @@ struct sgxfive_vm {
 	struct mutex lock;		/* the range tracker and the page tables */
 	struct sgx_mmu_pd *pd;
 	struct drm_mm mm;		/* one reserved node per mapping */
+	struct sgxfive_deferred release;	/* of the page directory */
 };
 
 struct sgxfive_mapping {
 	struct drm_mm_node node;
 	struct drm_gem_shmem_object *shmem;	/* pinned while mapped */
+	struct sgxfive_deferred release;	/* of the pages */
 };
 
+u64 sgxfive_ccb_done(u64 sent, u32 woff, u32 roff)
+{
+	return sent - (woff - roff) % SGX_CCB_ENTRIES;
+}
+
+/* Move the items of list whose command is done, in order, to due. */
+unsigned int sgxfive_reap(struct list_head *list, u64 done, struct list_head *due)
+{
+	struct sgxfive_deferred *d, *next;
+	unsigned int n = 0;
+
+	list_for_each_entry_safe(d, next, list, link) {
+		if (d->after > done)
+			break;
+		list_move_tail(&d->link, due);
+		n++;
+	}
+	return n;
+}
+
+void sgxfive_free_all(struct list_head *due)
+{
+	struct sgxfive_deferred *d, *next;
+
+	list_for_each_entry_safe(d, next, due, link) {
+		list_del(&d->link);
+		d->free(d);
+	}
+}
+
 /* A VM_MAP range: page aligned, non-empty, inside one present user heap. */
 int sgxfive_vm_check_range(const struct drm_sgxfive_heap *heaps, unsigned int n,
 			   u64 addr, u64 size)
@@ -51,19 +84,35 @@ int sgxfive_vm_check_range(const struct drm_sgxfive_heap *heaps, unsigned int n,
 	return -EINVAL;
 }
 
-static void sgxfive_mapping_free(struct sgxfive_vm *vm, struct sgxfive_mapping *m)
+static void sgxfive_mapping_release(struct sgxfive_deferred *d)
 {
-	sgx_mmu_unmap(vm->pd, m->node.start, m->node.size >> PAGE_SHIFT);
-	drm_mm_remove_node(&m->node);
-	/*
-	 * TODO (P5): with jobs, the pages must stay pinned until the GPU can no
-	 * longer reach them (after the next command's PT invalidation).
-	 */
+	struct sgxfive_mapping *m = container_of(d, struct sgxfive_mapping, release);
+
 	drm_gem_shmem_unpin(m->shmem);
 	drm_gem_object_put(&m->shmem->base);
 	kfree(m);
 }
 
+/*
+ * The range is free for new mappings at once; the pages stay pinned until
+ * the GPU's stale TLB entries for it are gone (design §3.3).
+ */
+static void sgxfive_mapping_free(struct sgxfive_vm *vm, struct sgxfive_mapping *m)
+{
+	sgx_mmu_unmap(vm->pd, m->node.start, m->node.size >> PAGE_SHIFT);
+	drm_mm_remove_node(&m->node);
+	m->release.free = sgxfive_mapping_release;
+	sgxfive_defer(vm->sgx, &m->release);
+}
+
+static void sgxfive_vm_pd_release(struct sgxfive_deferred *d)
+{
+	struct sgxfive_vm *vm = container_of(d, struct sgxfive_vm, release);
+
+	sgx_mmu_pd_destroy(vm->pd);
+	kfree(vm);
+}
+
 static void sgxfive_vm_release(struct kref *ref)
 {
 	struct sgxfive_vm *vm = container_of(ref, struct sgxfive_vm, ref);
@@ -73,18 +122,16 @@ static void sgxfive_vm_release(struct kref *ref)
 		sgxfive_mapping_free(vm, container_of(node, struct sgxfive_mapping,
 						      node));
 	drm_mm_takedown(&vm->mm);
+	mutex_destroy(&vm->lock);
 	/*
 	 * The EDM keeps directory-list assignments by PD address and its BIF
-	 * caches what it read through them, so a later VM whose PD lands on
-	 * this page would run on stale entries: the tiling engine and cache
-	 * requestors fault at page 0 and the job stalls. The next command
-	 * makes the BIF drop them. (Freeing only after that command has been
-	 * processed, design §3.3, is still to come.)
+	 * caches what it read through them, so a later VM whose PD landed on
+	 * this page would run on stale entries (seen: the tiling engine and
+	 * cache requestors fault at page 0 and the job stalls). The directory
+	 * and its tables go only after a command has made the BIF drop them.
 	 */
-	sgxfive_need_bif_inval(vm->sgx);
-	sgx_mmu_pd_destroy(vm->pd);
-	mutex_destroy(&vm->lock);
-	kfree(vm);
+	vm->release.free = sgxfive_vm_pd_release;
+	sgxfive_defer(vm->sgx, &vm->release);
 }
 
 struct sgxfive_vm *sgxfive_vm_get(struct sgxfive_file *f, u32 handle)
