From e4e3b7c1e7be86483b42b4a9939815890f5a74bf Mon Sep 17 00:00:00 2001
From: Josep Torra <n770galaxy@gmail.com>
Date: Tue, 20 Oct 2026 19:48:32 +0200
Subject: [PATCH 12/34] drm/gma500: fill arbitrary rectangles on the SGX545

Give the firmware parser's fill parameters a rectangle origin: the PBE clip
window becomes the rectangle while the surface base stays pixel (0, 0), and the
stride may be padded. dri/N/sgx/xfer_fill now runs four cases (a whole
surface, an inset rectangle on a padded stride, a rectangle crossing tile
boundaries, a single pixel) and checks every dword of the destination area:
the colour inside the rectangle and the untouched sentinel outside. All four
are exact on the GMA3600.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Josep Torra <n770galaxy@gmail.com>
---
 drivers/gpu/drm/gma500/sgx_boot.c    | 71 ++++++++++++++++++----------
 drivers/gpu/drm/gma500/sgx_fw.c      | 15 +++---
 drivers/gpu/drm/gma500/sgx_fw.h      |  7 ++-
 drivers/gpu/drm/gma500/sgx_fw_test.c | 15 ++++++
 4 files changed, 76 insertions(+), 32 deletions(-)

diff --git a/drivers/gpu/drm/gma500/sgx_boot.c b/drivers/gpu/drm/gma500/sgx_boot.c
index e355fa94fedf..52cbf446001e 100644
--- a/drivers/gpu/drm/gma500/sgx_boot.c
+++ b/drivers/gpu/drm/gma500/sgx_boot.c
@@ -860,29 +860,42 @@ static const struct {
 	[SGX_FW_TQ_USE_EOR] = { XB_USE, 0x60 },
 };
 
-#define FILL_W		64
-#define FILL_H		32
-#define FILL_COLOUR	0xff336699
 #define FILL_SENTINEL	0xdeadbeef
 
 /*
- * A solid fill (§4.2): 64 x 32 ARGB8888 into the first two destination pages.
- * The command comes from sgx_xfer_fill_cmd() and is checked word for word
- * against the firmware file's TQ_CMD list before the kick.
+ * Fill cases: a rectangle of a surface at the start of the destination area,
+ * whose stride may be padded. Every dword of the three destination pages is
+ * checked: the colour inside the rectangle, the sentinel everywhere else.
  */
-static int gma_sgx_xfer_fill(struct gma_sgx *sgx, struct drm_printer *p)
+static const struct gma_sgx_fill_case {
+	const char *name;
+	u32 x, y, w, h, stride, colour;
+} gma_sgx_fill_cases[] = {
+	{ "whole 64x32", 0, 0, 64, 32, 256, 0xff336699 },
+	{ "32x16 at (8,4), stride 320", 8, 4, 32, 16, 320, 0xff00ff00 },
+	{ "33x16 at (20,10), across tiles", 20, 10, 33, 16, 256, 0x80112233 },
+	{ "one pixel at (63,31)", 63, 31, 1, 1, 256, 0x12345678 },
+};
+
+/*
+ * A solid fill (§4.2) of one case. The command comes from sgx_xfer_fill_cmd()
+ * and is checked word for word against the firmware file's TQ_CMD list
+ * before the kick.
+ */
+static int gma_sgx_xfer_fill(struct gma_sgx *sgx, struct drm_printer *p,
+			     const struct gma_sgx_fill_case *fc)
 {
 	struct sgx_fw_layout *l = &sgx->layout;
 	u8 *progs[SGX_FW_TQ_MAX] = { NULL };
 	u32 params[SGX_FW_TQ_NUM_PARAMS];
 	const struct sgx_fw_tq_fill tf = {
-		.dest = sgx->xbuf[XB_DST].addr, .width = FILL_W, .height = FILL_H,
-		.stride = 4 * FILL_W, .colour = FILL_COLOUR,
+		.dest = sgx->xbuf[XB_DST].addr, .width = fc->w, .height = fc->h,
+		.stride = fc->stride, .colour = fc->colour, .x = fc->x, .y = fc->y,
 	};
 	const struct sgx_fw_tq *pri = sgx_fw_tq(&sgx->fw, SGX_FW_TQ_PDS_PRIM);
 	const struct sgx_fw_tq *sec = sgx_fw_tq(&sgx->fw, SGX_FW_TQ_PDS_SEC);
 	struct sgx_xfer_fill f = {
-		.rect = { 0, 0, FILL_W, FILL_H },
+		.rect = { fc->x, fc->y, fc->x + fc->w, fc->y + fc->h },
 		.bg = sgx->xbuf[XB_BG].addr,
 		.req_base = sgx->xbuf[XB_BG].addr & 0xfff00000,
 		.pds_exec_base = sgx->xbuf[XB_PDS].addr,
@@ -894,7 +907,7 @@ static int gma_sgx_xfer_fill(struct gma_sgx *sgx, struct drm_printer *p)
 	u32 *dst = sgx->xbuf[XB_DST].va, *ctx = sgx->xbuf[XB_CTX].va;
 	u8 *cmd = (u8 *)sgx->xbuf[XB_CCB].va + sgx->xfer_woff;
 	const u32 data[] = { 0, sgx->xbuf[XB_CTX].addr };
-	unsigned int i, good = 0, guard = 0, first_bad = ~0u;
+	unsigned int i, wrong = 0, first_bad = ~0u;
 	int n, ret, sw0, bad = 0;
 	ktime_t start;
 	u32 size, done;
@@ -971,20 +984,23 @@ static int gma_sgx_xfer_fill(struct gma_sgx *sgx, struct drm_printer *p)
 		usleep_range(50, 100);
 	rmb(); /* fresh reads of what the GPU wrote */
 
-	for (i = 0; i < 2 * PAGE_SIZE / 4; i++) {
-		if (READ_ONCE(dst[i]) == FILL_COLOUR)
-			good++;
-		else if (first_bad == ~0u)
-			first_bad = i;
+	for (i = 0; i < 3 * PAGE_SIZE / 4; i++) {
+		u32 x = i % (fc->stride / 4), y = i / (fc->stride / 4);
+		bool in = x >= fc->x && x < fc->x + fc->w &&
+			  y >= fc->y && y < fc->y + fc->h;
+
+		if (READ_ONCE(dst[i]) != (in ? fc->colour : FILL_SENTINEL)) {
+			wrong++;
+			if (first_bad == ~0u)
+				first_bad = i;
+		}
 	}
-	for (; i < 3 * PAGE_SIZE / 4; i++)
-		guard += READ_ONCE(dst[i]) == FILL_SENTINEL;
-	drm_printf(p, "dst[0..7]: %*ph\n", 32, dst);
+	drm_printf(p, "fill %s:\n", fc->name);
 	if (first_bad != ~0u)
-		drm_printf(p, "first wrong dword %u = %#x\n", first_bad,
+		drm_printf(p, "first wrong dword %u (x %u, y %u) = %#x\n", first_bad,
+			   first_bad % (fc->stride / 4), first_bad / (fc->stride / 4),
 			   READ_ONCE(dst[first_bad]));
-	gma_sgx_check(p, "filled dwords", good, 2 * PAGE_SIZE / 4, &bad);
-	gma_sgx_check(p, "guard intact", guard, PAGE_SIZE / 4, &bad);
+	gma_sgx_check(p, "wrong dwords", wrong, 0, &bad);
 	gma_sgx_check(p, "status F", READ_ONCE(scr[SCR_F]), f.fence_id + 1, &bad);
 	gma_sgx_check(p, "ccb read off", READ_ONCE(ctl[1]), done, &bad);
 	gma_sgx_check(p, "ctx count", READ_ONCE(ctx[SGX_XFER_CTX_COUNT / 4]), 0,
@@ -999,10 +1015,17 @@ static int gma_sgx_xfer_fill_show(struct seq_file *m, void *unused)
 {
 	struct gma_sgx *sgx = m->private;
 	struct drm_printer p = drm_seq_file_printer(m);
-	int ret;
+	unsigned int i;
+	int ret = 0, r;
 
 	mutex_lock(&sgx->lock);
-	ret = gma_sgx_xfer_fill(sgx, &p);
+	for (i = 0; i < ARRAY_SIZE(gma_sgx_fill_cases); i++) {
+		r = gma_sgx_xfer_fill(sgx, &p, &gma_sgx_fill_cases[i]);
+		if (r && !ret)
+			ret = r;
+		if (r && r != -EIO)
+			break;		/* the queue itself failed */
+	}
 	if (ret)
 		gma_sgx_dump(sgx, &p);
 	mutex_unlock(&sgx->lock);
diff --git a/drivers/gpu/drm/gma500/sgx_fw.c b/drivers/gpu/drm/gma500/sgx_fw.c
index a2503830e07a..b15e8f310e1d 100644
--- a/drivers/gpu/drm/gma500/sgx_fw.c
+++ b/drivers/gpu/drm/gma500/sgx_fw.c
@@ -711,17 +711,18 @@ int sgx_fw_place(const struct sgx_fw_buffer *bufs, unsigned int n,
 int sgx_fw_tq_fill_params(const struct sgx_fw_tq_fill *f,
 			  u32 params[SGX_FW_TQ_NUM_PARAMS])
 {
-	if (f->width < 1 || f->width > 0x2000 || f->height < 1 ||
-	    f->height > 0x2000)
+	u64 right = (u64)f->x + f->width, bottom = (u64)f->y + f->height;
+
+	if (f->width < 1 || f->height < 1 || right > 0x2000 || bottom > 0x2000)
 		return -EINVAL;
-	if (f->stride % 8 || f->stride < 4 * f->width || f->stride > 0x8000)
+	if (f->stride % 8 || f->stride < 4 * right || f->stride > 0x8000)
 		return -EINVAL;
-	if (f->dest % 4 || (u64)f->dest + (u64)f->stride * (f->height - 1) +
-	    4 * f->width > 0x100000000ull)
+	if (f->dest % 4 || (u64)f->dest + (u64)f->stride * (bottom - 1) +
+	    4 * right > 0x100000000ull)
 		return -EINVAL;
 	params[0] = f->colour;
-	params[1] = 0;					/* XMIN, YMIN */
-	params[2] = (f->width - 1) | (f->height - 1) << 16;
+	params[1] = f->x | f->y << 16;				/* XMIN, YMIN */
+	params[2] = (u32)(right - 1) | (u32)(bottom - 1) << 16;	/* XMAX, YMAX */
 	params[3] = 0x8000 | (f->stride / 8 - 1) << 16;	/* COUNT, LINESTRIDE */
 	params[4] = f->dest;				/* FBADDR */
 	params[5] = 0x200;				/* TILERELATIVE */
diff --git a/drivers/gpu/drm/gma500/sgx_fw.h b/drivers/gpu/drm/gma500/sgx_fw.h
index 608f7181504b..25a8ab54378d 100644
--- a/drivers/gpu/drm/gma500/sgx_fw.h
+++ b/drivers/gpu/drm/gma500/sgx_fw.h
@@ -110,13 +110,18 @@ struct sgx_fw_layout {
 	u32 tq_set;
 };
 
-/* An ARGB8888 fill of a whole linear surface (format §9.6). */
+/*
+ * An ARGB8888 fill of a width x height rectangle at (x, y) of a linear
+ * surface (format §9.6); the PBE clips to the rectangle.
+ */
 struct sgx_fw_tq_fill {
 	u32 dest;		/* device virtual address of pixel (0, 0) */
 	u32 width;
 	u32 height;
 	u32 stride;		/* bytes per line */
 	u32 colour;		/* 0xAARRGGBB */
+	u32 x;
+	u32 y;
 };
 
 /* One register write of an init script. */
diff --git a/drivers/gpu/drm/gma500/sgx_fw_test.c b/drivers/gpu/drm/gma500/sgx_fw_test.c
index 031944c01d13..af9ad798cb6f 100644
--- a/drivers/gpu/drm/gma500/sgx_fw_test.c
+++ b/drivers/gpu/drm/gma500/sgx_fw_test.c
@@ -426,6 +426,21 @@ static void sgx_fw_test_tq_fill_params(struct kunit *test)
 	f = tiny_fill;
 	f.dest = 0xfffff000;			/* surface past 4 GiB */
 	KUNIT_EXPECT_EQ(test, sgx_fw_tq_fill_params(&f, p), -EINVAL);
+
+	/* A 32 x 16 rectangle at (8, 4) of a 320-byte-stride surface. */
+	f = tiny_fill;
+	f.width = 32;
+	f.height = 16;
+	f.stride = 320;
+	f.x = 8;
+	f.y = 4;
+	KUNIT_ASSERT_EQ(test, sgx_fw_tq_fill_params(&f, p), 0);
+	KUNIT_EXPECT_EQ(test, p[1], 0x00040008u);
+	KUNIT_EXPECT_EQ(test, p[2], 0x00130027u);
+	KUNIT_EXPECT_EQ(test, p[3], 0x00278000u);
+	KUNIT_EXPECT_EQ(test, p[4], 0xf0200000u);
+	f.x = 72;				/* x + width past the stride */
+	KUNIT_EXPECT_EQ(test, sgx_fw_tq_fill_params(&f, p), -EINVAL);
 }
 
 static void sgx_fw_test_emitpix_sb(struct kunit *test)
-- 
2.56.0

