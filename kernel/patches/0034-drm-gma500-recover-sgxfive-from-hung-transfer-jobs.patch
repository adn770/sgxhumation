diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_fence.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_fence.c
index 58f856ca9a1b7..16af0a27141d8 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_fence.c
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_fence.c
@@ -6,16 +6,24 @@
  * SW_EVENT the interrupt handler signals each context's pending fences up to
  * the number in its fence word. Contexts run their jobs in order, so the
  * word only moves forward.
+ *
+ * A fence keeps its job's firmware command until it signals, so that after a
+ * recovery reset the context's client CCB can be rebuilt with the commands
+ * the firmware has not finished (sgxfive_ctx_rewind).
  */
 #include <linux/dma-fence.h>
 #include <linux/slab.h>
 
+#include "sgx_xfer.h"
 #include "sgxfive_ctx.h"
 #include "sgxfive_priv.h"
 
 struct sgxfive_fence {
 	struct dma_fence base;
 	struct list_head link;		/* in the context's pending list */
+	u64 order;			/* when the firmware got it, device-wide */
+	u32 size;			/* in the client CCB */
+	u8 cmd[SGX_XFER_CMD_SIZE];
 };
 
 bool sgxfive_seqno_passed(u32 done, u32 seqno)
@@ -38,14 +46,22 @@ static const struct dma_fence_ops sgxfive_fence_ops = {
 	.get_timeline_name = sgxfive_fence_timeline_name,
 };
 
-/* A fence for the context's job number seqno, pending until it completes. */
-struct dma_fence *sgxfive_fence_create(struct sgxfive_ctx *ctx, u32 seqno)
+/*
+ * A fence for the context's job number seqno, pending until it completes:
+ * order is the job's place among all jobs given to the firmware, cmd its
+ * command and size the space it takes in the client CCB.
+ */
+struct dma_fence *sgxfive_fence_create(struct sgxfive_ctx *ctx, u32 seqno,
+				       u64 order, const u8 *cmd, u32 size)
 {
 	struct sgxfive_fence *f = kzalloc_obj(*f);
 	unsigned long flags;
 
 	if (!f)
 		return ERR_PTR(-ENOMEM);
+	f->order = order;
+	f->size = size;
+	memcpy(f->cmd, cmd, SGX_XFER_CMD_SIZE);
 	dma_fence_init(&f->base, &sgxfive_fence_ops, &ctx->fence_lock,
 		       ctx->fence_context, seqno);
 	spin_lock_irqsave(&ctx->fence_lock, flags);
@@ -75,11 +91,58 @@ static void sgxfive_fence_retire(struct sgxfive_ctx *ctx, int error)
 	spin_unlock_irqrestore(&ctx->fence_lock, flags);
 }
 
+void sgxfive_fence_signal(struct sgxfive_ctx *ctx)
+{
+	sgxfive_fence_retire(ctx, 0);
+}
+
 void sgxfive_fence_fail_all(struct sgxfive_ctx *ctx, int error)
 {
 	sgxfive_fence_retire(ctx, error);
 }
 
+/* The order of the context's oldest unfinished job; false if it has none. */
+bool sgxfive_ctx_oldest(struct sgxfive_ctx *ctx, u64 *order)
+{
+	struct sgxfive_fence *f;
+	unsigned long flags;
+
+	spin_lock_irqsave(&ctx->fence_lock, flags);
+	f = list_first_entry_or_null(&ctx->pending, struct sgxfive_fence, link);
+	if (f)
+		*order = f->order;
+	spin_unlock_irqrestore(&ctx->fence_lock, flags);
+	return f;
+}
+
+/*
+ * With the firmware stopped: rewrite the client CCB from offset 0 with the
+ * commands of the context's unfinished jobs, in order, and set the fence word
+ * to the job before the first of them. Returns how many there are.
+ */
+u32 sgxfive_ctx_rewind(struct sgxfive_ctx *ctx)
+{
+	u32 *ctl = sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_CTL_OFF);
+	u8 *ccb = sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_CCB_OFF);
+	struct sgxfive_fence *f;
+	unsigned long flags;
+	u32 n = 0, woff = 0;
+
+	spin_lock_irqsave(&ctx->fence_lock, flags);
+	list_for_each_entry(f, &ctx->pending, link) {
+		if (!n++)
+			WRITE_ONCE(*(u32 *)sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_FENCE_OFF),
+				   (u32)f->base.seqno - 1);
+		memcpy(ccb + woff, f->cmd, SGX_XFER_CMD_SIZE);
+		woff = (woff + f->size) & (SGX_XFER_CCB_SIZE - 1);
+	}
+	spin_unlock_irqrestore(&ctx->fence_lock, flags);
+	ctx->woff = woff;
+	WRITE_ONCE(ctl[0], woff);	/* host write offset */
+	WRITE_ONCE(ctl[1], 0);		/* firmware read offset */
+	return n;
+}
+
 /* From the SW_EVENT interrupt: every live context. */
 void sgxfive_fences_irq(struct sgxfive *sgx)
 {
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_job_test.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_job_test.c
index 6216cc6a215eb..26f402656f175 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_job_test.c
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_job_test.c
@@ -1,9 +1,11 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * KUnit tests for sgxfive_job.c's pure parts: turning the UAPI transfer
- * register block into the firmware's SGXMKIF_TRANSFERCMD, and its checks.
+ * KUnit tests for the pure parts of sgxfive jobs: turning the UAPI transfer
+ * register block into the firmware's SGXMKIF_TRANSFERCMD, its checks, and
+ * the client CCB a context is rebuilt with after a recovery reset.
  */
 #include <kunit/test.h>
+#include <linux/dma-fence.h>
 #include <linux/module.h>
 #include <linux/string.h>
 
@@ -128,11 +130,89 @@ static void sgxfive_job_test_seqno(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, sgxfive_seqno_passed(0xfffffffe, 2));
 }
 
+/* A context with its memory in a plain buffer, as far as fences need one. */
+static struct sgxfive_ctx *fake_ctx(struct kunit *test)
+{
+	struct sgxfive_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	ctx->mem.va = kunit_kzalloc(test, SGXFIVE_CTX_MEM_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ctx->mem.va);
+	ctx->fence_context = dma_fence_context_alloc(1);
+	spin_lock_init(&ctx->fence_lock);
+	INIT_LIST_HEAD(&ctx->pending);
+	return ctx;
+}
+
+/*
+ * After a reset the client CCB holds the context's unfinished commands from
+ * offset 0, in order, and the fence word the last job it finished.
+ */
+static void sgxfive_job_test_rewind(struct kunit *test)
+{
+	struct sgxfive_ctx *ctx = fake_ctx(test);
+	u8 *ccb = sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_CCB_OFF);
+	u32 *ctl = sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_CTL_OFF);
+	u32 *done = sgxfive_ctx_cpu(ctx, SGXFIVE_CTX_FENCE_OFF);
+	struct dma_fence *f[3];
+	u8 *cmd[3];
+	u64 order;
+	int i;
+
+	for (i = 0; i < 3; i++) {
+		cmd[i] = kunit_kzalloc(test, SGX_XFER_CMD_SIZE, GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, cmd[i]);
+		memset(cmd[i], 0x11 * (i + 1), SGX_XFER_CMD_SIZE);
+		f[i] = sgxfive_fence_create(ctx, i + 1, 10 + i, cmd[i], 0x100);
+		KUNIT_ASSERT_FALSE(test, IS_ERR(f[i]));
+	}
+	KUNIT_EXPECT_TRUE(test, sgxfive_ctx_oldest(ctx, &order));
+	KUNIT_EXPECT_EQ(test, order, 10);
+
+	/* The first job completes. */
+	*done = 1;
+	sgxfive_fence_signal(ctx);
+	KUNIT_EXPECT_TRUE(test, dma_fence_is_signaled(f[0]));
+	KUNIT_EXPECT_FALSE(test, dma_fence_is_signaled(f[1]));
+	KUNIT_EXPECT_TRUE(test, sgxfive_ctx_oldest(ctx, &order));
+	KUNIT_EXPECT_EQ(test, order, 11);
+
+	/* Stale state from before the reset. */
+	ctx->woff = 0x300;
+	ctl[0] = 0x300;
+	ctl[1] = 0x200;
+	memset(ccb, 0xee, 0x400);
+	*done = 0xdead;
+
+	KUNIT_EXPECT_EQ(test, sgxfive_ctx_rewind(ctx), 2);
+	KUNIT_EXPECT_EQ(test, ctx->woff, 0x200);
+	KUNIT_EXPECT_EQ(test, ctl[0], 0x200);
+	KUNIT_EXPECT_EQ(test, ctl[1], 0);
+	KUNIT_EXPECT_EQ(test, *done, 1);
+	KUNIT_EXPECT_EQ(test, memcmp(ccb, cmd[1], 0x100), 0);
+	KUNIT_EXPECT_EQ(test, memcmp(ccb + 0x100, cmd[2], SGX_XFER_CMD_SIZE), 0);
+	KUNIT_EXPECT_FALSE(test, dma_fence_is_signaled(f[1]));
+	KUNIT_EXPECT_FALSE(test, dma_fence_is_signaled(f[2]));
+
+	/* A guilty context's jobs fail instead. */
+	sgxfive_fence_fail_all(ctx, -EIO);
+	for (i = 1; i < 3; i++) {
+		KUNIT_EXPECT_TRUE(test, dma_fence_is_signaled(f[i]));
+		KUNIT_EXPECT_EQ(test, f[i]->error, -EIO);
+	}
+	KUNIT_EXPECT_FALSE(test, sgxfive_ctx_oldest(ctx, &order));
+	KUNIT_EXPECT_EQ(test, sgxfive_ctx_rewind(ctx), 0);
+	KUNIT_EXPECT_EQ(test, ctx->woff, 0);
+	for (i = 0; i < 3; i++)
+		dma_fence_put(f[i]);
+}
+
 static struct kunit_case sgxfive_job_test_cases[] = {
 	KUNIT_CASE(sgxfive_job_test_build),
 	KUNIT_CASE(sgxfive_job_test_dummy),
 	KUNIT_CASE(sgxfive_job_test_check),
 	KUNIT_CASE(sgxfive_job_test_seqno),
+	KUNIT_CASE(sgxfive_job_test_rewind),
 	{}
 };
 
