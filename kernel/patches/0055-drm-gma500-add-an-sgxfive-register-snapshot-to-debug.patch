+	KUNIT_CASE(sgxfive_regdump_test_print),
+	{}
+};
+
+static struct kunit_suite sgxfive_regdump_test_suite = {
+	.name = "gma500_sgxfive_regdump",
+	.test_cases = sgxfive_regdump_test_cases,
+};
+
+kunit_test_suite(sgxfive_regdump_test_suite);
