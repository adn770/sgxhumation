diff --git a/drivers/gpu/drm/gma500/sgx_seq.c b/drivers/gpu/drm/gma500/sgx_seq.c
new file mode 100644
index 000000000000..11ce499eb372
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgx_seq.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * The SGX545 boot register sequence, as the DDK's SGXInitialise runs it on the
+ * first power-on (design/sgx545_boot_sequence.md, phase C): clock gating, init
+ * script part 1, the hardware-recovery variant of SGXReset, init script part 2,
+ * then the boot kick on EVENT_KICK2. The caller polls HostCtl.ui32InitStatus.
+ *
+ * Unlike the DDK this does not page-map BIF faults seen during the reset: it
+ * stops with the BIF still held, so the fault can be inspected.
+ */
+#include "sgx_seq.h"
+
+static void wr(const struct sgx_seq *s, u32 reg, u32 val)
+{
+	s->wr(s->ctx, reg, val);
+}
+
+static void delay(const struct sgx_seq *s)
+{
+	s->udelay(s->ctx, 1);	/* SGXWaitClocks(100) at 400 MHz, rounded up */
+}
+
+static void script(const struct sgx_seq *s, const struct sgx_fw_write *w,
+		   unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		wr(s, w[i].reg, w[i].val);
+}
+
+static void inval_dc(const struct sgx_seq *s)
+{
+	wr(s, SGX_BIF_CTRL, SGX_BIF_CTRL_INVALDC);
+	wr(s, SGX_BIF_CTRL, 0);
+	delay(s);
+}
+
+int sgx_seq_boot(const struct sgx_seq *s)
+{
+	unsigned int i;
+
+	wr(s, SGX_CLKGATECTL, s->clkgatectl);
+	wr(s, SGX_CLKGATECTL2, s->clkgatectl2);
+	script(s, s->part1, s->npart1);
+
+	/* SGXReset(bHWR): all blocks into reset, the BIF contexts cleared. */
+	wr(s, SGX_SOFT_RESET, SGX_SOFT_RESET_ALL);
+	delay(s);
+	wr(s, SGX_BIF_CTRL, 0);
+	wr(s, SGX_BIF_BANK_SET, 0);
+	wr(s, SGX_BIF_BANK0, 0);
+	wr(s, SGX_BIF_DIR_LIST_BASE0, 0);
+	for (i = 0; i < 15; i++)
+		wr(s, SGX_BIF_DIR_LIST_BASE1 + 4 * i, 0);
+
+	/* Release the BIF alone on the reset PD and check it is quiet. */
+	wr(s, SGX_BIF_DIR_LIST_BASE0, s->reset_pd);
+	delay(s);
+	wr(s, SGX_SOFT_RESET, SGX_SOFT_RESET_ALL & ~SGX_SOFT_RESET_BIF);
+	delay(s);
+	inval_dc(s);
+	if (s->rd(s->ctx, SGX_BIF_INT_STAT) & SGX_BIF_FAULT_REQ)
+		return -EIO;
+
+	/* The EDM translates through directory list 15. */
+	wr(s, SGX_BIF_BANK0, SGX_BIF_BANK0_EDM15);
+	wr(s, SGX_BIF_DIR_LIST_BASE15, s->edm_pd);
+	inval_dc(s);
+	wr(s, SGX_SOFT_RESET, 0);
+	delay(s);
+
+	script(s, s->part2, s->npart2);
+	s->pre_kick(s->ctx);
+	/* SGX_FEATURE_MULTI_EVENT_KICK: the boot kick does not bump the kicker. */
+	wr(s, SGX_EVENT_KICK2, 1);
+	return 0;
+}
diff --git a/drivers/gpu/drm/gma500/sgx_seq.h b/drivers/gpu/drm/gma500/sgx_seq.h
new file mode 100644
index 000000000000..af80e7648443
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgx_seq.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The SGX545 boot register sequence, from clock gating to the EDM kick.
+ * Register access goes through callbacks so the order can be unit tested.
+ */
+#ifndef _GMA500_SGX_SEQ_H_
+#define _GMA500_SGX_SEQ_H_
+
+#include "sgx_fw.h"
+
+/* SGX545 register offsets (sgx545defs.h). */
+#define SGX_CLKGATECTL		0x000
+#define SGX_CLKGATECTL2		0x004
+#define SGX_CLKGATESTATUS	0x008
+#define SGX_CORE_ID		0x01c
+#define SGX_CORE_REVISION	0x020
+#define SGX_SOFT_RESET		0x080
+#define SGX_EVENT_HOST_CLEAR2	0x114
+#define SGX_EVENT_STATUS2	0x118
+#define SGX_EVENT_STATUS	0x12c
+#define SGX_EVENT_HOST_ENABLE	0x130
+#define SGX_EVENT_HOST_CLEAR	0x134
+#define SGX_EVENT_KICK		0xac8
+#define SGX_EVENT_KICK2		0xae8
+#define SGX_USE0_SERV_EVENT	0xb14
+#define SGX_USE1_SERV_EVENT	0xb20
+#define SGX_BIF_CTRL		0xc00
+#define SGX_BIF_INT_STAT	0xc04
+#define SGX_BIF_FAULT		0xc08
+#define SGX_BIF_DIR_LIST_BASE1	0xc38	/* 1..15, 4 bytes apart */
+#define SGX_BIF_DIR_LIST_BASE15	0xc70
+#define SGX_BIF_BANK_SET	0xc74
+#define SGX_BIF_BANK0		0xc78
+#define SGX_BIF_DIR_LIST_BASE0	0xc84
+#define SGX_BIF_MEM_REQ_STAT	0xc8c
+
+#define SGX_SOFT_RESET_ALL	0x3f	/* BIF, DPM, TA, USE, ISP, TSP */
+#define SGX_SOFT_RESET_BIF	0x01
+#define SGX_BIF_CTRL_INVALDC	0x8
+#define SGX_BIF_FAULT_REQ	0xffff	/* BIF_INT_STAT */
+#define SGX_BIF_BANK0_EDM15	0xf	/* the EDM requester uses list 15 */
+
+struct sgx_seq {
+	u32 (*rd)(void *ctx, u32 reg);
+	void (*wr)(void *ctx, u32 reg, u32 val);
+	void (*udelay)(void *ctx, unsigned int us);
+	void (*pre_kick)(void *ctx);	/* memory writes before the kick */
+	void *ctx;
+
+	u32 clkgatectl, clkgatectl2;
+	const struct sgx_fw_write *part1, *part2;
+	unsigned int npart1, npart2;
+	u32 reset_pd;		/* DIR_LIST_BASE0 during and after the reset */
+	u32 edm_pd;		/* DIR_LIST_BASE15: the EDM's page directory */
+};
+
+int sgx_seq_boot(const struct sgx_seq *s);
+
+#endif
diff --git a/drivers/gpu/drm/gma500/sgx_seq_test.c b/drivers/gpu/drm/gma500/sgx_seq_test.c
new file mode 100644
index 000000000000..9ccf031d9782
--- /dev/null
+++ b/drivers/gpu/drm/gma500/sgx_seq_test.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for sgx_seq.c: the SGX545 boot register sequence must be exactly
+ * the DDK's (design/sgx545_boot_sequence.md, rows C1-C4, R1-R22, C8, C12).
+ */
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include "sgx_seq.h"
+
+#define MAX_OPS		128
+#define OP_DELAY	0xd0000000	/* delay marker: reg = microseconds */
+#define OP_PREKICK	0xd1000000	/* pre_kick() marker */
+#define OP_READ		0xd2000000	/* read marker: reg = register */
+
+struct rec {
+	u32 op[MAX_OPS][2];
+	unsigned int n;
+	u32 int_stat;		/* what BIF_INT_STAT reads as */
+};
+
+static void rec_add(struct rec *r, u32 a, u32 b)
+{
+	if (r->n < MAX_OPS) {
+		r->op[r->n][0] = a;
+		r->op[r->n][1] = b;
+	}
+	r->n++;
+}
+
+static u32 rec_rd(void *ctx, u32 reg)
+{
+	struct rec *r = ctx;
+
+	rec_add(r, OP_READ, reg);
+	return reg == SGX_BIF_INT_STAT ? r->int_stat : 0xffffffff;
+}
+
+static void rec_wr(void *ctx, u32 reg, u32 val)
+{
+	rec_add(ctx, reg, val);
+}
+
+static void rec_udelay(void *ctx, unsigned int us)
+{
+	rec_add(ctx, OP_DELAY, us);
+}
+
+static void rec_pre_kick(void *ctx)
+{
+	rec_add(ctx, OP_PREKICK, 0);
+}
+
+static const struct sgx_fw_write part1[] = { { 0xa58, 0 }, { 0xacc, 0 } };
+static const struct sgx_fw_write part2[] = { { 0x818, 0x7ff }, { 0xa58, 0x2204b00f } };
+
+static void seq(struct sgx_seq *s, struct rec *r)
+{
+	*s = (struct sgx_seq) {
+		.rd = rec_rd, .wr = rec_wr, .udelay = rec_udelay,
+		.pre_kick = rec_pre_kick, .ctx = r,
+		.clkgatectl = 0xa6aa, .clkgatectl2 = 0xaaaaaa,
+		.part1 = part1, .npart1 = ARRAY_SIZE(part1),
+		.part2 = part2, .npart2 = ARRAY_SIZE(part2),
+		.reset_pd = 0x1000, .edm_pd = 0x3ebf000,
+	};
+}
+
+static void sgx_seq_test_boot(struct kunit *test)
+{
+	static const u32 want[][2] = {
+		{ 0x000, 0xa6aa }, { 0x004, 0xaaaaaa },		/* C1-C2 */
+		{ 0xa58, 0 }, { 0xacc, 0 },			/* C3-C4 */
+		{ 0x080, 0x3f }, { OP_DELAY, 1 },		/* R1-R2 */
+		{ 0xc00, 0 }, { 0xc74, 0 }, { 0xc78, 0 },	/* R3-R5 */
+		{ 0xc84, 0 },					/* R6 */
+		{ 0xc38, 0 }, { 0xc3c, 0 }, { 0xc40, 0 }, { 0xc44, 0 },
+		{ 0xc48, 0 }, { 0xc4c, 0 }, { 0xc50, 0 }, { 0xc54, 0 },
+		{ 0xc58, 0 }, { 0xc5c, 0 }, { 0xc60, 0 }, { 0xc64, 0 },
+		{ 0xc68, 0 }, { 0xc6c, 0 }, { 0xc70, 0 },	/* R7 */
+		{ 0xc84, 0x1000 }, { OP_DELAY, 1 },		/* R8-R9 */
+		{ 0x080, 0x3e }, { OP_DELAY, 1 },		/* R10-R11 */
+		{ 0xc00, 0x8 }, { 0xc00, 0 }, { OP_DELAY, 1 },	/* R12-R14 */
+		{ OP_READ, 0xc04 },				/* R15 */
+		{ 0xc78, 0xf }, { 0xc70, 0x3ebf000 },		/* R16-R17 */
+		{ 0xc00, 0x8 }, { 0xc00, 0 }, { OP_DELAY, 1 },	/* R18-R20 */
+		{ 0x080, 0 }, { OP_DELAY, 1 },			/* R21-R22 */
+		{ 0x818, 0x7ff }, { 0xa58, 0x2204b00f },	/* C8 */
+		{ OP_PREKICK, 0 },				/* C7, C9-C11 */
+		{ 0xae8, 1 },					/* C12 */
+	};
+	struct rec *r = kunit_kzalloc(test, sizeof(*r), GFP_KERNEL);
+	struct sgx_seq s;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, r);
+	seq(&s, r);
+	KUNIT_ASSERT_EQ(test, sgx_seq_boot(&s), 0);
+	KUNIT_ASSERT_EQ(test, r->n, (unsigned int)ARRAY_SIZE(want));
+	for (i = 0; i < ARRAY_SIZE(want); i++) {
+		KUNIT_EXPECT_EQ_MSG(test, r->op[i][0], want[i][0], "op %u", i);
+		KUNIT_EXPECT_EQ_MSG(test, r->op[i][1], want[i][1], "op %u", i);
+	}
+}
+
+/* A BIF fault after the reset PD goes in: stop with the BIF still in reset. */
+static void sgx_seq_test_bif_fault(struct kunit *test)
+{
+	struct rec *r = kunit_kzalloc(test, sizeof(*r), GFP_KERNEL);
+	struct sgx_seq s;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, r);
+	r->int_stat = 0x1;
+	seq(&s, r);
+	KUNIT_EXPECT_EQ(test, sgx_seq_boot(&s), -EIO);
+	KUNIT_EXPECT_EQ(test, r->op[r->n - 1][0], (u32)OP_READ);
+	for (i = 0; i < r->n; i++) {
+		KUNIT_EXPECT_NE(test, r->op[i][0], (u32)SGX_EVENT_KICK2);
+		KUNIT_EXPECT_NE(test, r->op[i][0], (u32)OP_PREKICK);
+	}
+}
+
+static struct kunit_case sgx_seq_test_cases[] = {
+	KUNIT_CASE(sgx_seq_test_boot),
+	KUNIT_CASE(sgx_seq_test_bif_fault),
+	{}
+};
+
+static struct kunit_suite sgx_seq_test_suite = {
+	.name = "gma500_sgx_seq",
+	.test_cases = sgx_seq_test_cases,
+};
+
+kunit_test_suite(sgx_seq_test_suite);
-- 
