@@ -726,10 +742,51 @@ int sgx_fw_tq_fill_params(const struct sgx_fw_tq_fill *f,
 	params[3] = 0x8000 | (f->stride / 8 - 1) << 16;	/* COUNT, LINESTRIDE */
