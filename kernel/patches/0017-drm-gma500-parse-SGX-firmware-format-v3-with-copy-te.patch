 drivers/gpu/drm/gma500/sgx_fw.h      |  50 +++++-
 drivers/gpu/drm/gma500/sgx_fw_test.c | 251 ++++++++++++++++++++++++---
 3 files changed, 360 insertions(+), 42 deletions(-)

