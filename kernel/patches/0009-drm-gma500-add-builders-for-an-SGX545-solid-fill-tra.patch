From ed9c2e4861c64d0f3fb3a345d4df6cbc7dd9b590 Mon Sep 17 00:00:00 2001
From: Josep Torra <n770galaxy@gmail.com>
Date: Tue, 20 Oct 2026 19:19:24 +0200
Subject: [PATCH 09/31] drm/gma500: add builders for an SGX545 solid-fill
 transfer

Add the data a fill needs besides its programs: the FASTSCALE background
object (PDS state words and three fixed-point vertices), the five PBE state
words for a linear destination, and the transfer command's register words,
render box, fence and size. KUnit pins each against the values worked out in
the transfer spec. Nothing uses them yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Josep Torra <n770galaxy@gmail.com>
---
 drivers/gpu/drm/gma500/sgx_xfer.c      | 80 +++++++++++++++++++++++++
 drivers/gpu/drm/gma500/sgx_xfer.h      | 26 ++++++++
 drivers/gpu/drm/gma500/sgx_xfer_test.c | 82 ++++++++++++++++++++++++++
 3 files changed, 188 insertions(+)

diff --git a/drivers/gpu/drm/gma500/sgx_xfer.c b/drivers/gpu/drm/gma500/sgx_xfer.c
index 1035e88a4062..2743a967c1e4 100644
--- a/drivers/gpu/drm/gma500/sgx_xfer.c
+++ b/drivers/gpu/drm/gma500/sgx_xfer.c
@@ -58,3 +58,83 @@ void sgx_xfer_ctx_init(u8 *ctx, u32 pd_phys, u32 ccb, u32 ccb_ctl)
 	put32(ctx, SGX_XFER_CTX_CCB, ccb);
 	put32(ctx, SGX_XFER_CTX_CCB_CTL, ccb_ctl);
 }
+
+/* Vertex coordinates: 24-bit fixed point, 8 fraction bits, offset 4096. */
+static u32 vtx(u32 c)
+{
+	return ((c + 0x1000) << 8) & 0xffffff;
+}
+
+/*
+ * The background object of a FASTSCALE render (design/sgx545_transfer.md
+ * §4.2.3): the PDS state for the secondary and primary programs, then three
+ * vertices (top-left, top-right, bottom-left) packed two to five dwords.
+ * pri_data and sec_data are the programs' data-segment sizes in bytes.
+ */
+void sgx_xfer_bgobj(u32 bg[SGX_XFER_BGOBJ_DWORDS], u32 pds_base, u32 pri,
+		    u32 pri_data, u32 sec, u32 sec_data,
+		    const struct sgx_xfer_rect *r)
+{
+	u32 x0 = vtx(r->x0), y0 = vtx(r->y0), x1 = vtx(r->x1), y1 = vtx(r->y1);
+	unsigned int i;
+
+	for (i = 0; i < SGX_XFER_BGOBJ_DWORDS; i++)
+		bg[i] = 0;
+	bg[0] = ((sec - pds_base) >> 4) | (sec_data >> 4) << 26;
+	bg[1] = 3 << 16;		/* USETASKSIZE; no attributes */
+	bg[2] = ((pri - pds_base) >> 4) | (pri_data >> 4) << 26;
+	/* vertex 0 (even slot at dword 9), Z = 0 */
+	bg[9] = y0 | (x0 & 0xff) << 24;
+	bg[10] = x0 >> 8;
+	/* vertex 1 (odd slot from the high half of dword 11) */
+	bg[11] = (y0 & 0xffff) << 16;
+	bg[12] = (y0 >> 16) | x1 << 8;
+	/* vertex 2 (even slot at dword 14) */
+	bg[14] = y1 | (x0 & 0xff) << 24;
+	bg[15] = x0 >> 8;
+}
+
+/* The PBE state of a linear destination (§4.2.5); stride_px must be even. */
+void sgx_xfer_pbe(u32 pbe[SGX_XFER_PBE_WORDS], const struct sgx_xfer_rect *r,
+		  u32 stride_px, u32 addr, u32 packmode)
+{
+	pbe[0] = r->x0 | r->y0 << 16;
+	pbe[1] = (r->x1 - 1) | (r->y1 - 1) << 16;
+	pbe[2] = 0x80 << 8 | (stride_px / 2 - 1) << 16;	/* COUNT, LINESTRIDE */
+	pbe[3] = addr & ~3u;
+	pbe[4] = 0x200 | packmode;			/* TILERELATIVE */
+}
+
+/* setup_transfer_regs for a fill (§4.2.6); returns the command size. */
+u32 sgx_xfer_fill_cmd(u8 *cmd, const struct sgx_xfer_fill *f)
+{
+	const struct sgx_xfer_rect *r = &f->rect;
+	const u32 size = 0x1c0;
+	unsigned int i;
+
+	for (i = 0; i < SGX_XFER_CMD_SIZE; i++)
+		cmd[i] = 0;
+	put32(cmd, 0x000, (f->bg - f->req_base) >> 4);	/* ISPBgObjTag */
+	put32(cmd, 0x004, 0x200);			/* ISPBgObj: ENABLEBGTAG */
+	put32(cmd, 0x008, 0x3f800000);			/* ISPBgObjDepth: 1.0f */
+	put32(cmd, 0x00c, 3);				/* ISPRender: FASTSCALE */
+	put32(cmd, 0x014, 0x100);			/* ISPIPFMisc: PROCESSEMPTY */
+	put32(cmd, 0x018, f->req_base);			/* Bif3DReqBase */
+	put32(cmd, 0x01c, 0x80000000);			/* 3DAAMode */
+	put32(cmd, 0x020, 0x88);			/* ISPMultiSampCtl */
+	put32(cmd, 0x024, f->pixev_exec & ~0xfu);	/* EDMPixelPDSExec */
+	put32(cmd, 0x028, 5);				/* ...Data: 0x50 bytes */
+	put32(cmd, 0x02c, 1);				/* ...Info: 1 attribute */
+	put32(cmd, 0x030, (r->y0 >> 4) | (r->x0 >> 5) << 16);
+	put32(cmd, 0x034, (((r->y1 + 15) >> 4) - 1) |
+			  (((r->x1 + 31) >> 5) - 1) << 16);
+	put32(cmd, 0x038, 0x80);			/* PixelBE */
+	put32(cmd, 0x03c, f->pds_exec_base);		/* PDSExecBase */
+	put32(cmd, SGX_XFER_SIZE, size);
+	put32(cmd, SGX_XFER_NUM_STATUS, 1);
+	put32(cmd, SGX_XFER_STATUS, f->status_addr);
+	put32(cmd, SGX_XFER_STATUS + 4, f->fence_id + 1);
+	put32(cmd, 0x194, 0x07c00000);			/* NumPixelPartitions */
+	put32(cmd, 0x198, f->fence_id);			/* FenceID */
+	return size;
+}
diff --git a/drivers/gpu/drm/gma500/sgx_xfer.h b/drivers/gpu/drm/gma500/sgx_xfer.h
index cd04b880fe91..eebb2fc0852b 100644
--- a/drivers/gpu/drm/gma500/sgx_xfer.h
+++ b/drivers/gpu/drm/gma500/sgx_xfer.h
@@ -41,6 +41,32 @@ struct sgx_xfer_sync {
 	u32 write_pending, write_complete;
 };
 
+/* A transfer rectangle in pixels; x1 and y1 are exclusive. */
+struct sgx_xfer_rect {
+	u32 x0, y0, x1, y1;
+};
+
+#define SGX_XFER_BGOBJ_DWORDS	17	/* the background object, no layers */
+#define SGX_XFER_PBE_WORDS	5	/* emit1 src0/1, emit2 src0/1, sideband */
+
+/* What a solid fill's command needs besides its programs (§4.2.6). */
+struct sgx_xfer_fill {
+	struct sgx_xfer_rect rect;
+	u32 bg;			/* background object address */
+	u32 req_base;		/* BIF_3D_REQ_BASE: 1 MiB window holding bg */
+	u32 pixev_exec;		/* the pixel-event PDS program */
+	u32 pds_exec_base;	/* PDS_EXEC_BASE */
+	u32 status_addr;	/* the fence word */
+	u32 fence_id;		/* written there as fence_id + 1 */
+};
+
+void sgx_xfer_bgobj(u32 bg[SGX_XFER_BGOBJ_DWORDS], u32 pds_base, u32 pri,
+		    u32 pri_data, u32 sec, u32 sec_data,
+		    const struct sgx_xfer_rect *r);
+void sgx_xfer_pbe(u32 pbe[SGX_XFER_PBE_WORDS], const struct sgx_xfer_rect *r,
+		  u32 stride_px, u32 addr, u32 packmode);
+u32 sgx_xfer_fill_cmd(u8 *cmd, const struct sgx_xfer_fill *f);
+
 u32 sgx_xfer_dummy(u8 *cmd, u32 status_addr, u32 status_val, u32 update_addr,
 		   u32 update_val, const struct sgx_xfer_sync *dst);
 void sgx_xfer_ctx_init(u8 *ctx, u32 pd_phys, u32 ccb, u32 ccb_ctl);
diff --git a/drivers/gpu/drm/gma500/sgx_xfer_test.c b/drivers/gpu/drm/gma500/sgx_xfer_test.c
index a83f9665ee73..0e1ea1da7e66 100644
--- a/drivers/gpu/drm/gma500/sgx_xfer_test.c
+++ b/drivers/gpu/drm/gma500/sgx_xfer_test.c
@@ -66,6 +66,84 @@ static void sgx_xfer_test_dst_sync(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dw(cmd, 0x0ac + 0xb8), 1u);	/* status kept */
 }
 
+static const struct sgx_xfer_rect rect64x32 = { 0, 0, 64, 32 };
+
+/* design/sgx545_transfer.md §4.2.3: (0,0)-(64,32), primary at P, secondary P+0x20. */
+static void sgx_xfer_test_bgobj(struct kunit *test)
+{
+	static const u32 want[SGX_XFER_BGOBJ_DWORDS] = {
+		0x04000002, 0x00030000, 0x04000000, 0, 0, 0, 0, 0,
+		0, 0x00100000, 0x00001000, 0, 0x10400010, 0, 0x00102000, 0x00001000,
+		0,
+	};
+	u32 bg[SGX_XFER_BGOBJ_DWORDS];
+	unsigned int i;
+
+	memset(bg, 0xa5, sizeof(bg));
+	sgx_xfer_bgobj(bg, 0xe4000000, 0xe4000000, 0x10, 0xe4000020, 0x10,
+		       &rect64x32);
+	for (i = 0; i < SGX_XFER_BGOBJ_DWORDS; i++)
+		KUNIT_EXPECT_EQ_MSG(test, bg[i], want[i], "dword %u", i);
+}
+
+/* §4.2.5: 64 x 32 at A with a 256-byte (64-pixel) stride, ARGB8888. */
+static void sgx_xfer_test_pbe(struct kunit *test)
+{
+	u32 pbe[SGX_XFER_PBE_WORDS];
+
+	sgx_xfer_pbe(pbe, &rect64x32, 64, 0xf0200000, 0);
+	KUNIT_EXPECT_EQ(test, pbe[0], 0x00000000u);
+	KUNIT_EXPECT_EQ(test, pbe[1], 0x001f003fu);
+	KUNIT_EXPECT_EQ(test, pbe[2], 0x001f8000u);
+	KUNIT_EXPECT_EQ(test, pbe[3], 0xf0200000u);
+	KUNIT_EXPECT_EQ(test, pbe[4], 0x00000200u);
+}
+
+/* §4.2.6 and §4.2.7 step 9. */
+static void sgx_xfer_test_fill_cmd(struct kunit *test)
+{
+	static const struct sgx_xfer_fill f = {
+		.rect = { 0, 0, 64, 32 }, .bg = 0xf0130000, .req_base = 0xf0100000,
+		.pixev_exec = 0xe4000040, .pds_exec_base = 0xe4000000,
+		.status_addr = 0xf0122004, .fence_id = 7,
+	};
+	static const u32 want[][2] = {
+		{ 0x000, 0x3000 }, { 0x004, 0x200 }, { 0x008, 0x3f800000 },
+		{ 0x00c, 3 }, { 0x014, 0x100 }, { 0x018, 0xf0100000 },
+		{ 0x01c, 0x80000000 }, { 0x020, 0x88 }, { 0x024, 0xe4000040 },
+		{ 0x028, 5 }, { 0x02c, 1 }, { 0x034, 0x00010001 }, { 0x038, 0x80 },
+		{ 0x03c, 0xe4000000 }, { 0x0a4, 0x1c0 },
+		{ 0x0ac + 0xb8, 1 }, { 0x0ac + 0xbc, 0xf0122004 }, { 0x0ac + 0xc0, 8 },
+		{ 0x194, 0x07c00000 }, { 0x198, 7 },
+	};
+	u8 *cmd = kunit_kzalloc(test, SGX_XFER_CMD_SIZE, GFP_KERNEL);
+	unsigned int i, off, n = 0;
+
+	KUNIT_ASSERT_NOT_NULL(test, cmd);
+	memset(cmd, 0xa5, SGX_XFER_CMD_SIZE);
+	KUNIT_EXPECT_EQ(test, sgx_xfer_fill_cmd(cmd, &f), 0x1c0u);
+	for (i = 0; i < ARRAY_SIZE(want); i++)
+		KUNIT_EXPECT_EQ_MSG(test, dw(cmd, want[i][0]), want[i][1],
+				    "offset %#x", want[i][0]);
+	for (off = 0; off < SGX_XFER_CMD_SIZE; off += 4)
+		n += dw(cmd, off) != 0;
+	KUNIT_EXPECT_EQ(test, n, (unsigned int)ARRAY_SIZE(want));	/* rest 0 */
+}
+
+/* §2.4: the render box in 32 x 16 tiles, inclusive. */
+static void sgx_xfer_test_render_box(struct kunit *test)
+{
+	static const struct sgx_xfer_fill f = {
+		.rect = { 40, 20, 100, 33 },
+	};
+	u8 *cmd = kunit_kzalloc(test, SGX_XFER_CMD_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, cmd);
+	sgx_xfer_fill_cmd(cmd, &f);
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x030), 1u | 1u << 16);	/* y 20/16, x 40/32 */
+	KUNIT_EXPECT_EQ(test, dw(cmd, 0x034), 2u | 3u << 16);	/* y 47/16-1, x 131/32-1 */
+}
+
 static void sgx_xfer_test_ctx(struct kunit *test)
 {
 	u8 *ctx = kunit_kzalloc(test, SGX_XFER_CTX_SIZE, GFP_KERNEL);
@@ -88,6 +166,10 @@ static struct kunit_case sgx_xfer_test_cases[] = {
 	KUNIT_CASE(sgx_xfer_test_dummy_cmd),
 	KUNIT_CASE(sgx_xfer_test_dst_sync),
 	KUNIT_CASE(sgx_xfer_test_ctx),
+	KUNIT_CASE(sgx_xfer_test_bgobj),
+	KUNIT_CASE(sgx_xfer_test_pbe),
+	KUNIT_CASE(sgx_xfer_test_fill_cmd),
+	KUNIT_CASE(sgx_xfer_test_render_box),
 	{}
 };
 
