From b6b4c078e8f14d4c8ddb2d69b2ef5eb04272ac8c Mon Sep 17 00:00:00 2001
From: Josep Torra <n770galaxy@gmail.com>
Date: Wed, 21 Oct 2026 00:59:45 +0200
Subject: [PATCH 38/41] drm/gma500: fix sgxfive results userspace could not see

The IGT tests for the render node found three places where the kernel
did not give userspace what the UAPI promises. SUBMIT_JOBS was an
_IOW ioctl, so the failing job's index the kernel stores in jobs.count
never reached userspace; make it _IOWR. CREATE_BO rounded the size up
but did not report it; write the size back. A GEM handle that does not
exist returned -EINVAL from GET_BO_MMAP_OFFSET and VM_MAP; return
-ENOENT, as other DRM drivers do for failed lookups, and say so in the
UAPI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Josep Torra <n770galaxy@gmail.com>
---
 drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c | 3 ++-
 drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c  | 2 +-
 include/uapi/drm/sgxfive_drm.h               | 8 ++++----
 3 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c
index fcb533a38bcd..489610d0eadc 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_drv.c
@@ -214,6 +214,7 @@ static int sgxfive_ioctl_create_bo(struct sgxfive *sgx, void *data,
 	mapping_set_gfp_mask(shmem->base.filp->f_mapping, GFP_USER);
 	bo = to_sgxfive_bo(&shmem->base);
 	bo->flags = a->flags;
+	a->size = shmem->base.size;
 	ret = drm_gem_handle_create(file, &shmem->base, &a->handle);
 	drm_gem_object_put(&shmem->base);	/* the handle holds it now */
 	return ret;
@@ -230,7 +231,7 @@ static int sgxfive_ioctl_get_bo_mmap_offset(void *data, struct drm_file *file)
 		return -EINVAL;
 	obj = drm_gem_object_lookup(file, a->handle);
 	if (!obj)
-		return -EINVAL;
+		return -ENOENT;
 	bo = to_sgxfive_bo(obj);
 	ret = bo && (bo->flags & DRM_SGXFIVE_BO_ALLOW_CPU_ACCESS) ?
 	      drm_gem_create_mmap_offset(obj) : -EINVAL;
diff --git a/drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c b/drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c
index fdf6fd4031b1..76a8f553f9cc 100644
--- a/drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c
+++ b/drivers/gpu/drm/gma500/sgxfive/sgxfive_vm.c
@@ -161,7 +161,7 @@ int sgxfive_ioctl_vm_map(struct sgxfive *sgx, void *data, struct drm_file *file)
 		return ret;
 	obj = drm_gem_object_lookup(file, a->handle);
 	if (!obj)
-		return -EINVAL;
+		return -ENOENT;
 	if (!sgxfive_is_bo(obj) || a->offset > obj->size ||
 	    a->size > obj->size - a->offset) {
 		drm_gem_object_put(obj);
diff --git a/include/uapi/drm/sgxfive_drm.h b/include/uapi/drm/sgxfive_drm.h
index a3c8868a6be6..0a3c0129d0b7 100644
--- a/include/uapi/drm/sgxfive_drm.h
+++ b/include/uapi/drm/sgxfive_drm.h
@@ -103,7 +103,7 @@ struct drm_sgxfive_obj_array {
 #define DRM_IOCTL_SGXFIVE_DESTROY_CONTEXT \
 	SGXFIVE_IOCTL(DESTROY_CONTEXT, DRM_IOW, destroy_context)
 #define DRM_IOCTL_SGXFIVE_SUBMIT_JOBS \
-	SGXFIVE_IOCTL(SUBMIT_JOBS, DRM_IOW, submit_jobs)
+	SGXFIVE_IOCTL(SUBMIT_JOBS, DRM_IOWR, submit_jobs)
 
 /**
  * DOC: sgxfive DEV_QUERY
@@ -353,7 +353,7 @@ struct drm_sgxfive_dev_query_args {
  * struct drm_sgxfive_create_bo_args - Arguments for %DRM_IOCTL_SGXFIVE_CREATE_BO.
  */
 struct drm_sgxfive_create_bo_args {
-	/** @size: [IN] Size in bytes, non-zero; rounded up to 4 KiB. */
+	/** @size: [IN/OUT] Size in bytes, non-zero; on return, rounded up to 4 KiB. */
 	__u64 size;
 
 	/** @handle: [OUT] GEM handle. */
@@ -371,7 +371,7 @@ struct drm_sgxfive_create_bo_args {
  * %DRM_IOCTL_SGXFIVE_GET_BO_MMAP_OFFSET.
  */
 struct drm_sgxfive_get_bo_mmap_offset_args {
-	/** @handle: [IN] GEM handle of a CPU-accessible BO. */
+	/** @handle: [IN] GEM handle of a CPU-accessible BO; -ENOENT if there is none. */
 	__u32 handle;
 
 	/** @_padding_4: Reserved, zero. */
@@ -434,7 +434,7 @@ struct drm_sgxfive_vm_map_args {
 	/** @device_addr: [IN] GPU address: 4 KiB aligned, non-zero, in one user heap. */
 	__u64 device_addr;
 
-	/** @handle: [IN] GEM handle of the BO. */
+	/** @handle: [IN] GEM handle of the BO; -ENOENT if there is none. */
 	__u32 handle;
 
 	/** @_padding_14: Reserved, zero. */
-- 
