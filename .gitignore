# Third-party reference corpus — upstream clones (~1.3 GB, their own licenses).
# Track only our own catalog; never vendor the clones into this tree.
/reference/*
!/reference/CATALOG.md

# Local RE tool builds (radare2 source + prefix). Rebuild from source per tools/README.md;
# only the setup notes are tracked.
/tools/*
!/tools/README.md
# ...except our own USSE disassembler source (track source, ignore build outputs).
!/tools/usse-dis/
/tools/usse-dis/*.o
/tools/usse-dis/usse-dis
/tools/usse-dis/pds-dis
/tools/usse-dis/r2/*.dylib
/tools/usse-dis/r2/*.so
# refdisasm: built binaries + generated disassembly are regenerable (build.sh);
# only main.c/pdsmain.c/build.sh/README.md are tracked.
/tools/usse-dis/refdisasm/refdisasm540
/tools/usse-dis/refdisasm/refdisasm545
/tools/usse-dis/refdisasm/refpds545
/tools/usse-dis/refdisasm/*.txt
# arch32: our i686 build containers (scripts only).
!/tools/arch32/
# usse-asm: our USSE/PDS assembler (track source, ignore build outputs).
!/tools/usse-asm/
/tools/usse-asm/usse-asm
/tools/usse-asm/pds-asm
# sgx545-fwcutter: track the tool; its output carries Imagination code, like extracted/.
!/tools/fwcutter/
/tools/fwcutter/*.fw

# Throwaway development artifacts (logs, dumps, experiments); safe to delete anytime.
/debug/*
!/debug/.gitkeep

# Extracted USSE microkernel binaries — derivatives of the proprietary libsrv_init
# blob. Reproducible from it (see extracted/MANIFEST.md); only the manifest is tracked.
/harness/ukernel-extract/extracted/*.bin
/harness/ukernel-extract/extracted/layout_*/
# 3D captures of the closed GLES2 stack (README "3D capture"); only the manifest is tracked.
/harness/ukernel-extract/extracted/gles2_tri/*
!/harness/ukernel-extract/extracted/gles2_tri/MANIFEST.md

# Python virtualenv (pytest for harness tools)
/.venv
/**/__pycache__/
/.pytest_cache/

# sgx_fw userspace harness build outputs (kernel/sgx_fw/Makefile).
/kernel/sgx_fw/fwdump
/kernel/sgx_fw/*.o

# Local-only files: agent notes, Claude Code state, and the machine-specific
# settings of the test scripts (see kernel/scripts/local.env.example).
/AGENTS.md
/.claude/
/kernel/scripts/local.env
