 tests/sgxfive/meson.build         |  16 ++
 tests/sgxfive/sgxfive_ctx.c       |  90 +++++++++++
 tests/sgxfive/sgxfive_dev_query.c | 115 ++++++++++++++
 tests/sgxfive/sgxfive_gem.c       |  86 +++++++++++
 tests/sgxfive/sgxfive_submit.c    | 247 ++++++++++++++++++++++++++++++
 tests/sgxfive/sgxfive_vm.c        | 116 ++++++++++++++
 7 files changed, 671 insertions(+)
 create mode 100644 tests/sgxfive/meson.build
 create mode 100644 tests/sgxfive/sgxfive_ctx.c
