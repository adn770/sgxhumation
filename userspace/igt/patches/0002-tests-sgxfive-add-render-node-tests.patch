diff --git a/tests/sgxfive/sgxfive_ctx.c b/tests/sgxfive/sgxfive_ctx.c
new file mode 100644
index 000000000..e9bcb7d27
--- /dev/null
+++ b/tests/sgxfive/sgxfive_ctx.c
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Copyright (c) 2026 Josep Torra
+ *
+ * CREATE_CONTEXT and DESTROY_CONTEXT: transfer contexts at normal priority on
+ * an existing VM; every other value is rejected.
+ */
+#include <errno.h>
+
+#include "igt.h"
+#include "igt_sgxfive.h"
+
+/* Arguments CREATE_CONTEXT accepts; each subtest breaks one field. */
+static struct drm_sgxfive_create_context_args valid(uint32_t vm)
+{
+	return (struct drm_sgxfive_create_context_args){
+		.type = DRM_SGXFIVE_CTX_TYPE_TRANSFER,
+		.priority = DRM_SGXFIVE_CTX_PRIORITY_NORMAL,
+		.vm_context_handle = vm,
+	};
+}
+
+int igt_main()
+{
+	struct drm_sgxfive_create_context_args args;
+	uint32_t vm = 0;
+	int fd = -1;
+
+	igt_fixture() {
+		fd = igt_sgxfive_open();
+		vm = igt_sgxfive_create_vm(fd);
+	}
+
+	igt_subtest("create-destroy") {
+		uint32_t a = igt_sgxfive_create_ctx(fd, vm);
+		uint32_t b = igt_sgxfive_create_ctx(fd, vm);	/* several per VM */
+
+		igt_assert(a != b);
+		igt_sgxfive_destroy_ctx(fd, a);
+		igt_sgxfive_destroy_ctx(fd, b);
+		igt_assert_eq(__igt_sgxfive_destroy_ctx(fd, a), -EINVAL);
+	}
+
+	igt_subtest("outlives-its-vm-handle") {
+		uint32_t v = igt_sgxfive_create_vm(fd);
+		uint32_t c = igt_sgxfive_create_ctx(fd, v);
+
+		igt_sgxfive_destroy_vm(fd, v);		/* the context holds the VM */
+		igt_sgxfive_submit_dummy(fd, c, 0, 0);
+		igt_sgxfive_destroy_ctx(fd, c);
+	}
+
+	igt_subtest("bad-type") {
+		args = valid(vm);
+		args.type = 1;
+		igt_assert_eq(__igt_sgxfive_create_ctx(fd, &args), -EINVAL);
+	}
+
+	igt_subtest("bad-priority") {
+		args = valid(vm);
+		args.priority = 1;
+		igt_assert_eq(__igt_sgxfive_create_ctx(fd, &args), -EINVAL);
+	}
+
+	igt_subtest("bad-flags") {
+		args = valid(vm);
+		args.flags = 1;
+		igt_assert_eq(__igt_sgxfive_create_ctx(fd, &args), -EINVAL);
+	}
+
+	igt_subtest("bad-padding") {
+		args = valid(vm);
+		args._padding_14 = 1;
+		igt_assert_eq(__igt_sgxfive_create_ctx(fd, &args), -EINVAL);
+	}
+
+	igt_subtest("bad-vm") {
+		args = valid(vm);
+		args.vm_context_handle = 0xdead;
+		igt_assert_eq(__igt_sgxfive_create_ctx(fd, &args), -EINVAL);
+	}
+
+	igt_subtest("destroy-bad-handle")
+		igt_assert_eq(__igt_sgxfive_destroy_ctx(fd, 0xdead), -EINVAL);
+
+	igt_fixture() {
+		igt_sgxfive_destroy_vm(fd, vm);
+		drm_close_driver(fd);
+	}
+}
diff --git a/tests/sgxfive/sgxfive_dev_query.c b/tests/sgxfive/sgxfive_dev_query.c
new file mode 100644
index 000000000..a11ea4672
--- /dev/null
+++ b/tests/sgxfive/sgxfive_dev_query.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Copyright (c) 2026 Josep Torra
+ *
+ * DEV_QUERY: what the device reports, and the size rules (a NULL pointer
+ * asks for the size, a short buffer gets a truncated copy).
+ */
+#include <errno.h>
+#include <string.h>
+
+#include "igt.h"
+#include "igt_sgxfive.h"
+
+int igt_main()
+{
+	int fd = -1;
+
+	igt_fixture()
+		fd = igt_sgxfive_open();
+
+	igt_subtest("gpu-info") {
+		struct drm_sgxfive_dev_query_gpu_info g = { };
+
+		igt_sgxfive_dev_query(fd, DRM_SGXFIVE_DEV_QUERY_GPU_INFO, &g, sizeof(g));
+		igt_assert_eq_u32(g.core_id, 0x01150000);	/* SGX545 */
+		igt_assert(g.core_revision);
+		igt_assert_eq_u64(g.quirks & ~DRM_SGXFIVE_QUIRKS_MASK, 0);
+		/* Host bridges below revision 4 need the sample-cache layout. */
+		igt_assert_eq_u64(g.quirks & DRM_SGXFIVE_QUIRK_SAMPLE_CACHE,
+				  g.host_bridge_rev < 4 ? DRM_SGXFIVE_QUIRK_SAMPLE_CACHE : 0);
+	}
+
+	igt_subtest("fw-info") {
+		struct drm_sgxfive_dev_query_fw_info f = { };
+		uint32_t vm = igt_sgxfive_create_vm(fd);
+		uint32_t ctx = igt_sgxfive_create_ctx(fd, vm);	/* boots the firmware */
+
+		igt_sgxfive_dev_query(fd, DRM_SGXFIVE_DEV_QUERY_FW_INFO, &f, sizeof(f));
+		igt_assert_eq_u32(f.state, DRM_SGXFIVE_FW_STATE_ON);
+		igt_assert(f.ddk_build);
+		igt_assert(f.fw_format >= 1);
+		igt_assert_eq_u32(f._padding_14, 0);
+		igt_sgxfive_destroy_ctx(fd, ctx);
+		igt_sgxfive_destroy_vm(fd, vm);
+	}
+
+	igt_subtest("heap-info") {
+		struct drm_sgxfive_heap h[DRM_SGXFIVE_HEAP_COUNT] = { };
+
+		igt_assert_eq_u32(igt_sgxfive_heaps(fd, h, DRM_SGXFIVE_HEAP_COUNT),
+				  DRM_SGXFIVE_HEAP_COUNT);
+		for (int i = 0; i < DRM_SGXFIVE_HEAP_COUNT; i++) {
+			bool kernel = i == DRM_SGXFIVE_HEAP_KERNEL_CODE ||
+				      i == DRM_SGXFIVE_HEAP_KERNEL_DATA;
+
+			igt_assert_eq_u32(h[i].flags & ~DRM_SGXFIVE_HEAP_FLAGS_MASK, 0);
+			igt_assert_eq(!!(h[i].flags & DRM_SGXFIVE_HEAP_RESERVED), kernel);
+			igt_assert_eq_u32(h[i].page_size_log2, 12);
+			igt_assert(h[i].base + h[i].size <= 1ULL << 32);
+		}
+		igt_assert(h[DRM_SGXFIVE_HEAP_GENERAL].size);
+		igt_assert(h[DRM_SGXFIVE_HEAP_PDS_PIXEL].size);
+		igt_assert(h[DRM_SGXFIVE_HEAP_USSE_PIXEL].size);
+	}
+
+	igt_subtest("job-info") {
+		struct drm_sgxfive_dev_query_job_info j = { };
+
+		igt_sgxfive_dev_query(fd, DRM_SGXFIVE_DEV_QUERY_JOB_INFO, &j, sizeof(j));
+		igt_assert_eq_u64(j.job_types, DRM_SGXFIVE_JOB_TYPE_TRANSFER_BIT);
+		igt_assert(j.max_jobs >= 1);
+		igt_assert(j.max_sync_ops >= 2);
+		igt_assert_eq_u32(j.transfer_cmd_size, sizeof(struct drm_sgxfive_transfer_cmd));
+		igt_assert_eq_u32(j.max_updates, 0);
+	}
+
+	igt_subtest("runtime-info") {
+		struct drm_sgxfive_dev_query_runtime_info r = { };
+
+		igt_sgxfive_dev_query(fd, DRM_SGXFIVE_DEV_QUERY_RUNTIME_INFO, &r, sizeof(r));
+		igt_assert(r.num_pixel_partitions);
+		igt_assert(r.tile_width && r.tile_height);
+		igt_assert_eq_u32(r._padding_c, 0);
+	}
+
+	igt_subtest("size-only") {
+		uint32_t size = 0;
+
+		igt_assert_eq(__igt_sgxfive_dev_query(fd, DRM_SGXFIVE_DEV_QUERY_GPU_INFO, NULL,
+						      &size), 0);
+		igt_assert_eq_u32(size, sizeof(struct drm_sgxfive_dev_query_gpu_info));
+	}
+
+	igt_subtest("short-buffer") {
+		struct drm_sgxfive_dev_query_gpu_info g;
+		uint32_t size = 8;
+
+		memset(&g, 0xa5, sizeof(g));
+		igt_assert_eq(__igt_sgxfive_dev_query(fd, DRM_SGXFIVE_DEV_QUERY_GPU_INFO, &g,
+						      &size), 0);
+		igt_assert_eq_u32(size, 8);
+		igt_assert_eq_u32(g.core_id, 0x01150000);
+		igt_assert_eq_u32(g.core_id_sw, 0xa5a5a5a5);	/* past the 8 bytes */
+	}
+
+	igt_subtest("bad-type") {
+		struct drm_sgxfive_dev_query_gpu_info g = { };
+		uint32_t size = sizeof(g);
+
+		igt_assert_eq(__igt_sgxfive_dev_query(fd, 99, &g, &size), -EINVAL);
+	}
+
+	igt_fixture()
+		drm_close_driver(fd);
+}
diff --git a/tests/sgxfive/sgxfive_gem.c b/tests/sgxfive/sgxfive_gem.c
new file mode 100644
index 000000000..fc1c21087
--- /dev/null
+++ b/tests/sgxfive/sgxfive_gem.c
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Copyright (c) 2026 Josep Torra
+ *
+ * CREATE_BO and GET_BO_MMAP_OFFSET: page-rounded sizes, CPU mappings only
+ * with ALLOW_CPU_ACCESS, and every reserved bit rejected.
+ */
+#include <errno.h>
+#include <sys/mman.h>
+
+#include "igt.h"
+#include "igt_sgxfive.h"
+
+int igt_main()
+{
+	int fd = -1;
+
+	igt_fixture()
+		fd = igt_sgxfive_open();
+
+	igt_subtest("create-rounds-up") {
+		uint64_t size = 5000;
+		uint32_t bo = 0;
+
+		igt_assert_eq(__igt_sgxfive_create_bo(fd, &size, 0, &bo), 0);
+		igt_assert_eq_u64(size, 2 * SGXFIVE_PAGE_SIZE);
+		gem_close(fd, bo);
+	}
+
+	igt_subtest("mmap") {
+		const uint64_t size = 4 * SGXFIVE_PAGE_SIZE;
+		uint32_t bo = igt_sgxfive_create_bo(fd, size, DRM_SGXFIVE_BO_ALLOW_CPU_ACCESS);
+		uint32_t *p = igt_sgxfive_mmap_bo(fd, bo, size);
+		uint32_t *q = igt_sgxfive_mmap_bo(fd, bo, size);
+
+		for (uint32_t i = 0; i < size / 4; i++)
+			igt_assert_eq_u32(p[i], 0);		/* zeroed */
+		p[size / 4 - 1] = 0x12345678;
+		igt_assert_eq_u32(q[size / 4 - 1], 0x12345678);	/* the same pages */
+		munmap(p, size);
+		munmap(q, size);
+		gem_close(fd, bo);
+	}
+
+	igt_subtest("mmap-needs-cpu-access") {
+		uint32_t bo = igt_sgxfive_create_bo(fd, SGXFIVE_PAGE_SIZE, 0);
+		uint64_t offset;
+
+		igt_assert_eq(__igt_sgxfive_mmap_offset(fd, bo, &offset), -EINVAL);
+		gem_close(fd, bo);
+	}
+
+	igt_subtest("mmap-bad-handle") {
+		uint64_t offset;
+
+		igt_assert_eq(__igt_sgxfive_mmap_offset(fd, 0xdead, &offset), -ENOENT);
+	}
+
+	igt_subtest("zero-size") {
+		uint64_t size = 0;
+		uint32_t bo;
+
+		igt_assert_eq(__igt_sgxfive_create_bo(fd, &size, 0, &bo), -EINVAL);
+	}
+
+	igt_subtest("bad-flags") {
+		uint64_t size = SGXFIVE_PAGE_SIZE;
+		uint32_t bo;
+
+		/* Defined in the UAPI but not offered yet (design §3.1, probe Q5). */
+		igt_assert_eq(__igt_sgxfive_create_bo(fd, &size, DRM_SGXFIVE_BO_CPU_CACHED, &bo),
+			      -EINVAL);
+		igt_assert_eq(__igt_sgxfive_create_bo(fd, &size, 1ULL << 40, &bo), -EINVAL);
+	}
+
+	igt_subtest("bad-padding") {
+		struct drm_sgxfive_create_bo_args args = {
+			.size = SGXFIVE_PAGE_SIZE, ._padding_c = 1,
+		};
+
+		do_ioctl_err(fd, DRM_IOCTL_SGXFIVE_CREATE_BO, &args, EINVAL);
+	}
+
+	igt_fixture()
+		drm_close_driver(fd);
+}
diff --git a/tests/sgxfive/sgxfive_submit.c b/tests/sgxfive/sgxfive_submit.c
new file mode 100644
index 000000000..ffff3407f
--- /dev/null
+++ b/tests/sgxfive/sgxfive_submit.c
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Copyright (c) 2026 Josep Torra
+ *
+ * SUBMIT_JOBS with dummy transfers, which need no GPU programs: syncobj waits
+ * and signals (binary and timeline), several contexts, and the validation
+ * rules. A call is checked as a whole before any job runs, and on an error
+ * jobs.count reports the job that failed.
+ */
+#include <errno.h>
+#include <string.h>
+
+#include "igt.h"
+#include "igt_sgxfive.h"
+#include "igt_syncobj.h"
+
+#define WAIT_MS 5000
+
+int igt_main()
+{
+	struct drm_sgxfive_dev_query_job_info info = { };
+	struct drm_sgxfive_job jobs[2];
+	uint32_t vm = 0, ctx = 0, failed;
+	int fd = -1;
+
+	igt_fixture() {
+		fd = igt_sgxfive_open();
+		igt_sgxfive_dev_query(fd, DRM_SGXFIVE_DEV_QUERY_JOB_INFO, &info, sizeof(info));
+		vm = igt_sgxfive_create_vm(fd);
+		ctx = igt_sgxfive_create_ctx(fd, vm);
+	}
+
+	igt_subtest("dummy-signals") {
+		uint32_t s = syncobj_create(fd, 0);
+
+		igt_assert_eq(igt_sgxfive_wait(fd, s, 0, 0), -ETIME);
+		igt_sgxfive_submit_dummy(fd, ctx, 0, s);
+		igt_assert_eq(igt_sgxfive_wait(fd, s, 0, WAIT_MS), 0);
+		syncobj_destroy(fd, s);
+	}
+
+	igt_subtest("dummy-chain") {
+		uint32_t s = syncobj_create(fd, 0);
+
+		igt_sgxfive_submit_dummy(fd, ctx, 0, s);
+		for (int i = 0; i < 64; i++)
+			igt_sgxfive_submit_dummy(fd, ctx, s, s);
+		igt_assert_eq(igt_sgxfive_wait(fd, s, 0, WAIT_MS), 0);
+		syncobj_destroy(fd, s);
+	}
+
+	igt_subtest("many-contexts") {
+		uint32_t v2 = igt_sgxfive_create_vm(fd);
+		uint32_t c[4], s[4];
+
+		for (int i = 0; i < 4; i++) {
+			c[i] = igt_sgxfive_create_ctx(fd, i % 2 ? v2 : vm);
+			s[i] = syncobj_create(fd, 0);
+			igt_sgxfive_submit_dummy(fd, c[i], 0, s[i]);
+		}
+		for (int i = 0; i < 4; i++) {
+			igt_assert_eq(igt_sgxfive_wait(fd, s[i], 0, WAIT_MS), 0);
+			syncobj_destroy(fd, s[i]);
+			igt_sgxfive_destroy_ctx(fd, c[i]);
+		}
+		igt_sgxfive_destroy_vm(fd, v2);
+	}
+
+	igt_subtest("wait-needs-a-fence") {
+		uint32_t a = syncobj_create(fd, 0), b = syncobj_create(fd, 0);
+
+		/* drm_syncobj_find_fence: a syncobj nobody signals yet is -EINVAL... */
+		igt_assert_eq(__igt_sgxfive_submit_dummy(fd, ctx, a, b), -EINVAL);
+		igt_assert_eq(igt_sgxfive_wait(fd, b, 0, 0), -ETIME);	/* nothing ran */
+		syncobj_destroy(fd, a);
+		syncobj_destroy(fd, b);
+	}
+
+	igt_subtest("signal-then-wait-in-one-call") {
+		/* ...unless an earlier job of the same call signals it. */
+		uint32_t a = syncobj_create(fd, 0), b = syncobj_create(fd, 0);
+		struct drm_sgxfive_sync_op ops[3] = {
+			{ .handle = a, .flags = DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL },
+			{ .handle = a, .flags = DRM_SGXFIVE_SYNC_OP_FLAG_WAIT },
+			{ .handle = b, .flags = DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL },
+		};
+
+		jobs[0] = igt_sgxfive_dummy_job(ctx);
+		jobs[0].sync_ops = (struct drm_sgxfive_obj_array)DRM_SGXFIVE_OBJ_ARRAY(1, &ops[0]);
+		jobs[1] = igt_sgxfive_dummy_job(ctx);
+		jobs[1].sync_ops = (struct drm_sgxfive_obj_array)DRM_SGXFIVE_OBJ_ARRAY(2, &ops[1]);
+		igt_assert_eq(__igt_sgxfive_submit(fd, jobs, 2, NULL), 0);
+		igt_assert_eq(igt_sgxfive_wait(fd, b, 0, WAIT_MS), 0);
+		syncobj_destroy(fd, a);
+		syncobj_destroy(fd, b);
+	}
+
+	igt_subtest("timeline-points") {
+		uint32_t t = syncobj_create(fd, 0);
+		struct drm_sgxfive_sync_op op = {
+			.handle = t, .value = 2,
+			.flags = DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL |
+				 DRM_SGXFIVE_SYNC_OP_FLAG_HANDLE_TYPE_TIMELINE_SYNCOBJ,
+		};
+
+		jobs[0] = igt_sgxfive_dummy_job(ctx);
+		jobs[0].sync_ops = (struct drm_sgxfive_obj_array)DRM_SGXFIVE_OBJ_ARRAY(1, &op);
+		igt_assert_eq(__igt_sgxfive_submit(fd, jobs, 1, NULL), 0);
+		igt_assert_eq(igt_sgxfive_wait(fd, t, 1, WAIT_MS), 0);
+		igt_assert_eq(igt_sgxfive_wait(fd, t, 2, WAIT_MS), 0);
+		igt_assert_eq(igt_sgxfive_wait(fd, t, 3, 10), -ETIME);
+
+		/* A job waiting on point 2 signals point 4. */
+		{
+			const uint32_t tl = DRM_SGXFIVE_SYNC_OP_FLAG_HANDLE_TYPE_TIMELINE_SYNCOBJ;
+			struct drm_sgxfive_sync_op two[2] = {
+				{ .handle = t, .value = 2, .flags = tl },
+				{ .handle = t, .value = 4,
+				  .flags = tl | DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL },
+			};
+
+			jobs[0].sync_ops = (struct drm_sgxfive_obj_array)DRM_SGXFIVE_OBJ_ARRAY(2, two);
+			igt_assert_eq(__igt_sgxfive_submit(fd, jobs, 1, NULL), 0);
+		}
+		igt_assert_eq(igt_sgxfive_wait(fd, t, 4, WAIT_MS), 0);
+		syncobj_destroy(fd, t);
+	}
+
+	igt_subtest("job-count") {
+		struct drm_sgxfive_job many[64];
+
+		igt_assert(info.max_jobs < ARRAY_SIZE(many));
+		for (int i = 0; i < ARRAY_SIZE(many); i++)
+			many[i] = igt_sgxfive_dummy_job(ctx);
+		igt_assert_eq(__igt_sgxfive_submit(fd, many, 0, NULL), -EINVAL);
+		igt_assert_eq(__igt_sgxfive_submit(fd, many, info.max_jobs + 1, NULL), -EINVAL);
+		igt_assert_eq(__igt_sgxfive_submit(fd, many, info.max_jobs, NULL), 0);
+	}
+
+	igt_subtest("stride") {
+		/* A newer, longer job struct is fine if userspace left its tail zero. */
+		struct {
+			struct drm_sgxfive_job job;
+			uint64_t tail;
+		} big[2] = {
+			{ igt_sgxfive_dummy_job(ctx), 0 },
+			{ igt_sgxfive_dummy_job(ctx), 0 },
+		};
+		struct drm_sgxfive_submit_jobs_args args = {
+			.jobs = { .stride = sizeof(big[0]), .count = 2, .array = (uintptr_t)big },
+		};
+
+		do_ioctl(fd, DRM_IOCTL_SGXFIVE_SUBMIT_JOBS, &args);
+		big[1].tail = 1;
+		do_ioctl_err(fd, DRM_IOCTL_SGXFIVE_SUBMIT_JOBS, &args, EINVAL);
+		args.jobs.stride = sizeof(big[0].job) - 8;	/* older than the first */
+		do_ioctl_err(fd, DRM_IOCTL_SGXFIVE_SUBMIT_JOBS, &args, EINVAL);
+	}
+
+	igt_subtest_group() {
+		struct drm_sgxfive_transfer_cmd cmd = { };
+		struct drm_sgxfive_mem_update upd = { .device_addr = 0x3e000000, .value = 1 };
+		struct drm_sgxfive_sync_op op;
+		uint32_t s = 0;
+
+		igt_fixture()
+			s = syncobj_create(fd, 0);
+
+		/* Job 0 is fine, job 1 breaks one rule: the call fails at index 1. */
+#define BAD_SECOND(name, ...)						\
+		igt_subtest(name) {					\
+			jobs[0] = igt_sgxfive_dummy_job(ctx);		\
+			jobs[1] = igt_sgxfive_dummy_job(ctx);		\
+			__VA_ARGS__;					\
+			failed = 99;					\
+			igt_assert_eq(__igt_sgxfive_submit(fd, jobs, 2, &failed), -EINVAL); \
+			igt_assert_eq_u32(failed, 1);			\
+		}
+
+		BAD_SECOND("bad-type", jobs[1].type = 1)
+		BAD_SECOND("bad-context", jobs[1].context_handle = 0xdead)
+		BAD_SECOND("bad-flags", jobs[1].flags = 1u << 7)
+		BAD_SECOND("reserved-updates",
+			   jobs[1].updates = (struct drm_sgxfive_obj_array)
+				DRM_SGXFIVE_OBJ_ARRAY(1, &upd))
+		BAD_SECOND("reserved-updates-stride",
+			   jobs[1].updates = (struct drm_sgxfive_obj_array){ .stride = 16 })
+		BAD_SECOND("dummy-with-stream",
+			   jobs[1].cmd_stream = (uintptr_t)&cmd;
+			   jobs[1].cmd_stream_len = sizeof(cmd))
+		BAD_SECOND("short-stream",
+			   jobs[1].flags = 0;
+			   jobs[1].cmd_stream = (uintptr_t)&cmd;
+			   jobs[1].cmd_stream_len = 0x40)
+		BAD_SECOND("bad-sync-flags",
+			   op = (struct drm_sgxfive_sync_op){ .handle = s, .flags = 1u << 8 };
+			   jobs[1].sync_ops = (struct drm_sgxfive_obj_array)
+				DRM_SGXFIVE_OBJ_ARRAY(1, &op))
+		BAD_SECOND("binary-syncobj-with-point",
+			   op = (struct drm_sgxfive_sync_op){
+				.handle = s, .flags = DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL, .value = 5 };
+			   jobs[1].sync_ops = (struct drm_sgxfive_obj_array)
+				DRM_SGXFIVE_OBJ_ARRAY(1, &op))
+#undef BAD_SECOND
+
+		igt_subtest("missing-signal-syncobj") {
+			jobs[0] = igt_sgxfive_dummy_job(ctx);
+			jobs[1] = igt_sgxfive_dummy_job(ctx);
+			op = (struct drm_sgxfive_sync_op){
+				.handle = 0xdead, .flags = DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL };
+			jobs[1].sync_ops = (struct drm_sgxfive_obj_array)DRM_SGXFIVE_OBJ_ARRAY(1, &op);
+			failed = 99;
+			igt_assert_eq(__igt_sgxfive_submit(fd, jobs, 2, &failed), -ENOENT);
+			igt_assert_eq_u32(failed, 1);
+		}
+
+		igt_subtest("failed-call-runs-nothing") {
+			jobs[0] = igt_sgxfive_dummy_job(ctx);
+			op = (struct drm_sgxfive_sync_op){
+				.handle = s, .flags = DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL };
+			jobs[0].sync_ops = (struct drm_sgxfive_obj_array)DRM_SGXFIVE_OBJ_ARRAY(1, &op);
+			jobs[1] = igt_sgxfive_dummy_job(0xdead);
+			igt_assert_eq(__igt_sgxfive_submit(fd, jobs, 2, NULL), -EINVAL);
+			igt_assert_eq(igt_sgxfive_wait(fd, s, 0, 100), -ETIME);
+		}
+
+		igt_subtest("kernel-addresses-rejected") {
+			/* A transfer pointing the firmware at the kernel's own heap. */
+			cmd.event_pixel_pds_exec =
+				igt_sgxfive_heap(fd, DRM_SGXFIVE_HEAP_KERNEL_CODE).base;
+			jobs[0] = igt_sgxfive_dummy_job(ctx);
+			jobs[0].flags = 0;
+			jobs[0].cmd_stream = (uintptr_t)&cmd;
+			jobs[0].cmd_stream_len = sizeof(cmd);
+			igt_assert_eq(__igt_sgxfive_submit(fd, jobs, 1, NULL), -EINVAL);
+		}
+
+		igt_fixture()
+			syncobj_destroy(fd, s);
+	}
+
+	igt_fixture() {
+		igt_sgxfive_destroy_ctx(fd, ctx);
+		igt_sgxfive_destroy_vm(fd, vm);
+		drm_close_driver(fd);
+	}
+}
diff --git a/tests/sgxfive/sgxfive_vm.c b/tests/sgxfive/sgxfive_vm.c
new file mode 100644
index 000000000..794555119
--- /dev/null
+++ b/tests/sgxfive/sgxfive_vm.c
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Copyright (c) 2026 Josep Torra
+ *
+ * VM contexts and VM_MAP/VM_UNMAP: mappings stay inside one user heap, never
+ * overlap, are page aligned and within their BO, and are unmapped whole.
+ */
+#include <errno.h>
+
+#include "igt.h"
+#include "igt_sgxfive.h"
+
+#define PAGE SGXFIVE_PAGE_SIZE
+
+int igt_main()
+{
+	struct drm_sgxfive_heap gen, usse, kcode, kdata;
+	uint32_t vm = 0, bo = 0;
+	int fd = -1;
+
+	igt_fixture() {
+		fd = igt_sgxfive_open();
+		gen = igt_sgxfive_heap(fd, DRM_SGXFIVE_HEAP_GENERAL);
+		usse = igt_sgxfive_heap(fd, DRM_SGXFIVE_HEAP_USSE_PIXEL);
+		kcode = igt_sgxfive_heap(fd, DRM_SGXFIVE_HEAP_KERNEL_CODE);
+		kdata = igt_sgxfive_heap(fd, DRM_SGXFIVE_HEAP_KERNEL_DATA);
+		vm = igt_sgxfive_create_vm(fd);
+		bo = igt_sgxfive_create_bo(fd, 3 * PAGE, 0);
+	}
+
+	igt_subtest("create-destroy") {
+		uint32_t v = igt_sgxfive_create_vm(fd);
+
+		igt_assert(v && v != vm);
+		igt_sgxfive_destroy_vm(fd, v);
+		igt_assert_eq(__igt_sgxfive_destroy_vm(fd, v), -EINVAL);
+	}
+
+	igt_subtest("destroy-bad-handle")
+		igt_assert_eq(__igt_sgxfive_destroy_vm(fd, 0xdead), -EINVAL);
+
+	igt_subtest("map-unmap") {
+		igt_sgxfive_vm_map(fd, vm, gen.base, bo, 0, 2 * PAGE, 0);
+		igt_sgxfive_vm_unmap(fd, vm, gen.base, 2 * PAGE);
+		igt_assert_eq(__igt_sgxfive_vm_unmap(fd, vm, gen.base, 2 * PAGE), -ENOENT);
+	}
+
+	igt_subtest("map-read-only") {
+		igt_sgxfive_vm_map(fd, vm, gen.base, bo, PAGE, PAGE,
+				   DRM_SGXFIVE_VM_MAP_READ_ONLY);
+		igt_sgxfive_vm_unmap(fd, vm, gen.base, PAGE);
+	}
+
+	igt_subtest("overlap") {
+		igt_sgxfive_vm_map(fd, vm, gen.base, bo, 0, 2 * PAGE, 0);
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, gen.base + PAGE, bo, 0, PAGE, 0),
+			      -EEXIST);
+		igt_sgxfive_vm_unmap(fd, vm, gen.base, 2 * PAGE);
+	}
+
+	igt_subtest("unmap-whole-only") {
+		igt_sgxfive_vm_map(fd, vm, gen.base, bo, 0, 2 * PAGE, 0);
+		igt_assert_eq(__igt_sgxfive_vm_unmap(fd, vm, gen.base, PAGE), -ENOENT);
+		igt_assert_eq(__igt_sgxfive_vm_unmap(fd, vm, gen.base + PAGE, PAGE), -ENOENT);
+		igt_sgxfive_vm_unmap(fd, vm, gen.base, 2 * PAGE);
+	}
+
+	igt_subtest("kernel-heaps-unmappable") {
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, kcode.base, bo, 0, PAGE, 0), -EINVAL);
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, kdata.base, bo, 0, PAGE,
+						   DRM_SGXFIVE_VM_MAP_READ_ONLY), -EINVAL);
+	}
+
+	igt_subtest("bad-ranges") {
+		/* Unaligned address, past the BO, across a heap's end, above 4 GiB. */
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, gen.base + 8, bo, 0, PAGE, 0), -EINVAL);
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, gen.base, bo, 0, 4 * PAGE, 0), -EINVAL);
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, gen.base, bo, 3 * PAGE, PAGE, 0),
+			      -EINVAL);
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, usse.base + usse.size - PAGE, bo, 0,
+						   2 * PAGE, 0), -EINVAL);
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, 1ULL << 32, bo, 0, PAGE, 0), -EINVAL);
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, gen.base, bo, 0, 0, 0), -EINVAL);
+	}
+
+	igt_subtest("bad-flags")
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, gen.base, bo, 0, PAGE, 1u << 5),
+			      -EINVAL);
+
+	igt_subtest("bad-handles") {
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, vm, gen.base, 0xdead, 0, PAGE, 0), -ENOENT);
+		igt_assert_eq(__igt_sgxfive_vm_map(fd, 0xdead, gen.base, bo, 0, PAGE, 0), -EINVAL);
+		igt_assert_eq(__igt_sgxfive_vm_unmap(fd, 0xdead, gen.base, PAGE), -EINVAL);
+	}
+
+	igt_subtest("bo-outlives-its-handle") {
+		uint32_t b = igt_sgxfive_create_bo(fd, PAGE, 0);
+
+		igt_sgxfive_vm_map(fd, vm, gen.base, b, 0, PAGE, 0);
+		gem_close(fd, b);			/* the mapping keeps the pages */
+		igt_sgxfive_vm_unmap(fd, vm, gen.base, PAGE);
+	}
+
+	igt_subtest("destroy-with-mappings") {
+		uint32_t v = igt_sgxfive_create_vm(fd);
+
+		igt_sgxfive_vm_map(fd, v, gen.base, bo, 0, PAGE, 0);
+		igt_sgxfive_destroy_vm(fd, v);		/* releases the mapping */
+	}
+
+	igt_fixture() {
+		gem_close(fd, bo);
+		igt_sgxfive_destroy_vm(fd, vm);
+		drm_close_driver(fd);
+	}
+}
