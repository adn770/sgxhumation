diff --git a/lib/sgxfive/sgxfive.h b/lib/sgxfive/sgxfive.h
new file mode 100644
index 000000000..0b25fe221
--- /dev/null
+++ b/lib/sgxfive/sgxfive.h
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * libsgxfive: a thin C11 wrapper over the sgxfive render-node ioctls
+ * (kernel/uapi/sgxfive_drm.h), for tests and bring-up; not the open
+ * userspace a driver upstreaming needs (that is Mesa).
+ *
+ * Every function returning int returns 0 or a negative errno. All system
+ * calls go through a struct sgxfive_backend, so the same code runs against
+ * the kernel (sgxfive_os_backend()) or the in-process mock (sgxfive_mock.h).
+ */
+#ifndef SGXFIVE_H
+#define SGXFIVE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "sgxfive_drm.h"
+
+#define SGXFIVE_DRIVER_NAME	"sgxfive"
+/* While sgxfive is hosted by gma500 (Cedarview), its render node is gma500's. */
+#define SGXFIVE_HOST_DRIVER_NAME	"gma500"
+#define SGXFIVE_PAGE_SIZE	4096u
+
+/* ---- System-call backend ------------------------------------------------------------ */
+
+struct sgxfive_backend {
+	int (*open)(void *priv, const char *path);		/* fd or -errno */
+	int (*close)(void *priv, int fd);
+	int (*ioctl)(void *priv, int fd, unsigned long req, void *arg);
+	int (*mmap)(void *priv, int fd, uint64_t offset, size_t len, void **out);
+	int (*munmap)(void *priv, void *addr, size_t len);
+	void *priv;
+};
+
+/* open(2), ioctl(2) with EINTR/EAGAIN retry, mmap(2) on the render node. */
+const struct sgxfive_backend *sgxfive_os_backend(void);
+
+/* ---- Device ------------------------------------------------------------------------- */
+
+struct sgxfive_dev;
+
+/* Everything DEV_QUERY reports; heaps beyond SGXFIVE's known count are not copied. */
+struct sgxfive_info {
+	struct drm_sgxfive_dev_query_gpu_info gpu;
+	struct drm_sgxfive_dev_query_fw_info fw;
+	struct drm_sgxfive_dev_query_job_info job;
+	struct drm_sgxfive_dev_query_runtime_info runtime;
+	struct drm_sgxfive_heap heaps[DRM_SGXFIVE_HEAP_COUNT];
+	uint32_t num_heaps;		/* as reported by the kernel */
+};
+
+/*
+ * Open path, or with path NULL the first /dev/dri/renderD128..191 whose
+ * DRM_IOCTL_VERSION name is "sgxfive" (-ENODEV if none). Runs every query.
+ */
+int sgxfive_dev_open(const struct sgxfive_backend *be, const char *path,
+		     struct sgxfive_dev **out);
+int sgxfive_dev_adopt(const struct sgxfive_backend *be, int fd, struct sgxfive_dev **out);
+void sgxfive_dev_close(struct sgxfive_dev *dev);
+const struct sgxfive_info *sgxfive_dev_info(const struct sgxfive_dev *dev);
+const char *sgxfive_dev_path(const struct sgxfive_dev *dev);
+int sgxfive_dev_ioctl(struct sgxfive_dev *dev, unsigned long req, void *arg);
+
+/* One raw DEV_QUERY: *size in = buffer size, out = bytes written or needed. */
+int sgxfive_dev_query(struct sgxfive_dev *dev, uint32_t type, void *buf, uint32_t *size);
+
+/* The heap with this id, or NULL if absent (size 0) or unknown. */
+const struct drm_sgxfive_heap *sgxfive_heap(const struct sgxfive_dev *dev, uint32_t id);
+
+/* ---- Buffer objects ----------------------------------------------------------------- */
+
+struct sgxfive_bo {
+	struct sgxfive_dev *dev;
+	uint32_t handle;
+	uint64_t size;
+	uint64_t flags;
+	void *map;			/* CPU mapping once sgxfive_bo_mmap() succeeded */
+};
+
+int sgxfive_bo_create(struct sgxfive_dev *dev, uint64_t size, uint64_t flags,
+		      struct sgxfive_bo **out);
+int sgxfive_bo_mmap(struct sgxfive_bo *bo, void **ptr);
+void sgxfive_bo_destroy(struct sgxfive_bo *bo);
+
+/* ---- VM contexts -------------------------------------------------------------------- */
+
+struct sgxfive_vm;
+
+int sgxfive_vm_create(struct sgxfive_dev *dev, struct sgxfive_vm **out);
+void sgxfive_vm_destroy(struct sgxfive_vm *vm);
+uint32_t sgxfive_vm_handle(const struct sgxfive_vm *vm);
+struct sgxfive_dev *sgxfive_vm_dev(const struct sgxfive_vm *vm);
+
+/*
+ * Reserve size bytes (page multiple) of GPU address space in a user heap, with
+ * align a power of two >= 4 KiB; a bump allocator, never reused.
+ */
+int sgxfive_vm_alloc(struct sgxfive_vm *vm, uint32_t heap, uint64_t size, uint64_t align,
+		     uint64_t *addr);
+int sgxfive_vm_map(struct sgxfive_vm *vm, uint64_t addr, const struct sgxfive_bo *bo,
+		   uint64_t offset, uint64_t size, uint32_t flags);
+int sgxfive_vm_unmap(struct sgxfive_vm *vm, uint64_t addr, uint64_t size);
+
+/* ---- Contexts and syncobjs ---------------------------------------------------------- */
+
+int sgxfive_ctx_create(struct sgxfive_vm *vm, uint32_t *handle);	/* TRANSFER */
+int sgxfive_ctx_destroy(struct sgxfive_dev *dev, uint32_t handle);
+
+int sgxfive_syncobj_create(struct sgxfive_dev *dev, bool signaled, uint32_t *handle);
+int sgxfive_syncobj_destroy(struct sgxfive_dev *dev, uint32_t handle);
+/*
+ * Wait for a binary syncobj (point 0) or a timeline point, timeout_ns from now
+ * (-ETIME on timeout). With WAIT_FOR_SUBMIT, so an unsubmitted point waits too.
+ */
+int sgxfive_syncobj_wait(struct sgxfive_dev *dev, uint32_t handle, uint64_t point,
+			 int64_t timeout_ns);
+
+/* ---- Submission --------------------------------------------------------------------- */
+
+/* On error *failed (if not NULL) is the index of the failing job. */
+int sgxfive_submit(struct sgxfive_dev *dev, const struct drm_sgxfive_job *jobs,
+		   uint32_t count, uint32_t *failed);
+
+/*
+ * One transfer job: cmd NULL with DRM_SGXFIVE_SUBMIT_JOB_TRANSFER_DUMMY for a
+ * dummy. signal (if non-zero) is a binary syncobj to signal on completion,
+ * wait (if non-zero) one to wait for first.
+ */
+int sgxfive_submit_transfer(struct sgxfive_dev *dev, uint32_t ctx, uint32_t flags,
+			    const struct drm_sgxfive_transfer_cmd *cmd, uint32_t wait,
+			    uint32_t signal);
+
+#endif
diff --git a/lib/sgxfive/sgxfive_xfer.h b/lib/sgxfive/sgxfive_xfer.h
new file mode 100644
index 000000000..b694beacb
--- /dev/null
+++ b/lib/sgxfive/sgxfive_xfer.h
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Transfer jobs from userspace: the pure builders of a FASTSCALE transfer
+ * (design/sgx545_transfer.md §4.2 fill, §4.4 copy), the program-source
+ * interface, and a per-context engine that places programs in the client's
+ * VM and submits fills and copies.
+ */
+#ifndef SGXFIVE_XFER_H
+#define SGXFIVE_XFER_H
+
+#include "sgxfive.h"
+
+/* ---- Pure builders ------------------------------------------------------------------ */
+
+struct sgxfive_rect {
+	uint32_t x0, y0, x1, y1;	/* pixels; x1 and y1 exclusive */
+};
+
+#define SGXFIVE_BGOBJ_DWORDS	17	/* background object, no layers (fill) */
+#define SGXFIVE_BGOBJ1_DWORDS	23	/* ... one texture layer (copy) */
+#define SGXFIVE_PBE_WORDS	5	/* emit1 src0/1, emit2 src0/1, sideband */
+#define SGXFIVE_DOUTU_RANGE	0x80000	/* CBASE 0: the first 512 KiB of the code heap */
+#define SGXFIVE_TEX_MAX		4096	/* 12-bit WIDTH/HEIGHT in T1 */
+
+/*
+ * DOUTU word U0 of a USE program at addr, in the code heap at heap_base, with
+ * temps temporaries (§4.2.4). -EINVAL unless 8-byte aligned and in the window.
+ */
+int sgxfive_doutu(uint64_t addr, uint64_t heap_base, uint32_t temps, uint32_t *u0);
+
+/* PBE state of an ARGB8888 linear destination (§4.2.5); stride in bytes. */
+void sgxfive_pbe(uint32_t pbe[SGXFIVE_PBE_WORDS], const struct sgxfive_rect *r,
+		 uint32_t stride, uint32_t addr);
+
+/* Background objects (§4.2.3, §4.4.2); pri/sec are PDS addresses, *_data byte sizes. */
+void sgxfive_bgobj_fill(uint32_t bg[SGXFIVE_BGOBJ_DWORDS], uint32_t pds_base, uint32_t pri,
+			uint32_t pri_data, uint32_t sec, uint32_t sec_data,
+			const struct sgxfive_rect *r);
+void sgxfive_bgobj_copy(uint32_t bg[SGXFIVE_BGOBJ1_DWORDS], uint32_t pds_base, uint32_t pri,
+			uint32_t pri_data, uint32_t sec, uint32_t sec_data,
+			const struct sgxfive_rect *dst, const struct sgxfive_rect *src,
+			uint32_t src_w, uint32_t src_h);
+
+/* FloatIntDiv of the closed code: x / n truncated to 20 fraction bits, as IEEE single. */
+uint32_t sgxfive_float_int_div(uint32_t x, uint32_t n);
+
+/* DOUTT words T0..T3 of a linear ARGB8888 source (§4.4.3); stride in bytes. */
+void sgxfive_tex_words(uint32_t t[4], uint32_t addr, uint32_t width, uint32_t height,
+		       uint32_t stride);
+
+/* What the register block of a FASTSCALE transfer depends on (§4.2.6). */
+struct sgxfive_xfer_regs {
+	struct sgxfive_rect rect;	/* destination rectangle: the render box */
+	uint32_t bg;			/* background object */
+	uint32_t req_base;		/* BIF_3D_REQ_BASE: 1 MiB window holding bg */
+	uint32_t pixev_exec;		/* pixel-event PDS program */
+	uint32_t pds_exec_base;		/* PDS_EXEC_BASE */
+	uint32_t layers;		/* TSP layers in the background object */
+};
+
+void sgxfive_transfer_cmd(struct drm_sgxfive_transfer_cmd *cmd,
+			  const struct sgxfive_xfer_regs *r);
+
+/* ---- Program sources ---------------------------------------------------------------- */
+
+/*
+ * The GPU programs of a transfer. The ids, metadata and parameters are those
+ * of the firmware file's transfer-queue templates (design/sgx545_fw_format.md
+ * §9-§11): sgxfive_prog_asm_create() builds them from our own assembled
+ * code, and a source backed by a .fw file would be a thin adapter.
+ */
+enum sgxfive_prog_id {
+	SGXFIVE_PROG_USE_FILL = 0,	/* fill shader: mov o0, #colour */
+	SGXFIVE_PROG_USE_SEC,		/* USE secondary (no work) */
+	SGXFIVE_PROG_USE_EOT,		/* end of tile: PBE state, emitpix */
+	SGXFIVE_PROG_USE_EOR,		/* end of render */
+	SGXFIVE_PROG_PDS_PRIM,		/* PDS primary KICKONLY */
+	SGXFIVE_PROG_PDS_SEC,		/* PDS secondary BASIC */
+	SGXFIVE_PROG_PDS_PIXEVENT,	/* pixel-event PDS program */
+	SGXFIVE_PROG_USE_COPY,		/* copy shader: mov o0, pa0 */
+	SGXFIVE_PROG_PDS_PRIM_1SRC,	/* PDS primary single_source: texture fetch */
+	SGXFIVE_PROG_COUNT,
+};
+
+enum sgxfive_prog_param {
+	SGXFIVE_PARAM_COLOUR = 0,	/* fill colour, ARGB8888 */
+	SGXFIVE_PARAM_PBE0,		/* PBE words 0..3 */
+	SGXFIVE_PARAM_PBE1,
+	SGXFIVE_PARAM_PBE2,
+	SGXFIVE_PARAM_PBE3,
+	SGXFIVE_PARAM_SIDEBAND,		/* PBE word 4 */
+	SGXFIVE_PARAM_T0,		/* copy: DOUTT T0, T1, T2 (source address) */
+	SGXFIVE_PARAM_T1,
+	SGXFIVE_PARAM_SRC,
+	SGXFIVE_PARAM_COUNT,
+};
+
+#define SGXFIVE_PROG_NO_STRADDLE	(1u << 0)	/* must not cross a 4 KiB page */
+
+struct sgxfive_prog_meta {
+	uint32_t heap;			/* DRM_SGXFIVE_HEAP_USSE_PIXEL or _PDS_PIXEL */
+	uint32_t temps;			/* USE temporaries (DOUTU TRC) */
+	uint32_t attrs;			/* PDS primary attributes */
+	uint32_t size;			/* bytes */
+	uint32_t align;			/* bytes */
+	uint32_t data_size;		/* PDS data segment bytes */
+	uint32_t flags;			/* SGXFIVE_PROG_* */
+};
+
+/* Where everything an image may refer to has been placed. */
+struct sgxfive_prog_env {
+	uint32_t params[SGXFIVE_PARAM_COUNT];
+	uint64_t addr[SGXFIVE_PROG_COUNT];	/* 0: not placed */
+	uint32_t doutu[SGXFIVE_PROG_COUNT];	/* U0 of each placed USE program */
+	uint64_t heap_base[DRM_SGXFIVE_HEAP_COUNT];
+};
+
+struct sgxfive_prog_source;
+
+struct sgxfive_prog_source_ops {
+	/* -ENOENT if the source has no such program. */
+	int (*meta)(struct sgxfive_prog_source *src, uint32_t id, struct sgxfive_prog_meta *m);
+	/* Write the finished image of program id (meta.size bytes) to out. */
+	int (*build)(struct sgxfive_prog_source *src, uint32_t id,
+		     const struct sgxfive_prog_env *env, void *out);
+	void (*destroy)(struct sgxfive_prog_source *src);
+};
+
+/* Embed as the first member of a provider's own struct. */
+struct sgxfive_prog_source {
+	const struct sgxfive_prog_source_ops *ops;
+	const char *name;
+};
+
+/*
+ * Our own programs: tools/usse-asm/progs/ assembled at generation time
+ * (src/prog_asm_gen.h), with the TQ_META records and TQ_PATCHES of
+ * design/sgx545_fw_format.md §9-§11. They equal the templates of the closed
+ * libsrv_um.so bit for bit, so their images run on hardware; build() equals
+ * fwload.build_tq() for the same placement and parameters. Needs no file.
+ */
+struct sgxfive_prog_source *sgxfive_prog_asm_create(void);
+
+/*
+ * Test double: builds every program from the words the design documents give
+ * (§4.2.4, §4.2.7, §4.4.5). The closed template bodies it does not know
+ * (USE secondary, pixel-event PDS) are left zero, so its images are for the
+ * mock only and must never run on hardware.
+ */
+struct sgxfive_prog_source *sgxfive_prog_fake_create(void);
+void sgxfive_prog_source_destroy(struct sgxfive_prog_source *src);
+
+/* USSE_LIMM immediate split (fw_format §4) of a 64-bit instruction. */
+uint64_t sgxfive_limm_set(uint64_t insn, uint32_t imm);
+uint32_t sgxfive_limm_get(uint64_t insn);
+
+/* ---- Transfer engine ---------------------------------------------------------------- */
+
+/* A linear ARGB8888 surface at a GPU address of the engine's VM. */
+struct sgxfive_surface {
+	uint64_t addr;
+	uint32_t width, height;
+	uint32_t stride;		/* bytes */
+};
+
+struct sgxfive_xfer;
+
+/*
+ * Programs, background object and command of one context's transfers, placed
+ * in a private 3-page BO mapped into the VM (PDS page, USE page, stream page).
+ * One transfer in flight per engine: each job waits for the previous one
+ * before its programs are rewritten.
+ */
+int sgxfive_xfer_create(struct sgxfive_vm *vm, uint32_t ctx, struct sgxfive_prog_source *src,
+			struct sgxfive_xfer **out);
+void sgxfive_xfer_destroy(struct sgxfive_xfer *x);
+
+/* Addresses the engine chose, for tests and debugging. */
+struct sgxfive_xfer_layout {
+	uint64_t pds_page, use_page, stream_page;
+	uint64_t prog[SGXFIVE_PROG_COUNT];
+	uint64_t bg;
+};
+void sgxfive_xfer_get_layout(const struct sgxfive_xfer *x, struct sgxfive_xfer_layout *l);
+/* The last command and program images written (for tests). */
+const struct drm_sgxfive_transfer_cmd *sgxfive_xfer_last_cmd(const struct sgxfive_xfer *x);
+const void *sgxfive_xfer_page(const struct sgxfive_xfer *x, uint32_t heap);
+
+/*
+ * Fill rect of dst with colour; copy the w x h rectangle at (sx, sy) of src to
+ * rect of dst. signal (if non-zero) is a binary syncobj signalled on completion.
+ */
+int sgxfive_xfer_fill(struct sgxfive_xfer *x, const struct sgxfive_surface *dst,
+		      const struct sgxfive_rect *rect, uint32_t colour, uint32_t signal);
+int sgxfive_xfer_copy(struct sgxfive_xfer *x, const struct sgxfive_surface *src,
+		      uint32_t sx, uint32_t sy, const struct sgxfive_surface *dst,
+		      const struct sgxfive_rect *rect, uint32_t signal);
+/* Wait for the engine's last job (timeout from now). */
+int sgxfive_xfer_wait(struct sgxfive_xfer *x, int64_t timeout_ns);
+
+#endif
diff --git a/lib/sgxfive/xfer.c b/lib/sgxfive/xfer.c
new file mode 100644
index 000000000..69522e6c6
--- /dev/null
+++ b/lib/sgxfive/xfer.c
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Pure builders of a FASTSCALE transfer: DOUTU words, PBE state, background
+ * objects, texture words and the register block. They follow
+ * design/sgx545_transfer.md §4.2 and §4.4 (and the kernel's sgx_xfer.c,
+ * which runs the same recipes from debugfs).
+ */
+#include <errno.h>
+#include <string.h>
+
+#include "sgxfive_xfer.h"
+
+int sgxfive_doutu(uint64_t addr, uint64_t heap_base, uint32_t temps, uint32_t *u0)
+{
+	uint64_t off = addr - heap_base;
+
+	if (addr < heap_base || off >= SGXFIVE_DOUTU_RANGE || off % 8)
+		return -EINVAL;
+	/* EXE [19:4] (instruction index), CBASE [3:0] = 0, TRC [31:24] in fours. */
+	*u0 = (uint32_t)((off << 1) & 0xffff0) | (uint32_t)((off >> 19) & 0xf) |
+	      ((temps + 3) >> 2) << 24;
+	return 0;
+}
+
+void sgxfive_pbe(uint32_t pbe[SGXFIVE_PBE_WORDS], const struct sgxfive_rect *r,
+		 uint32_t stride, uint32_t addr)
+{
+	pbe[0] = r->x0 | r->y0 << 16;				/* XMIN, YMIN */
+	pbe[1] = (r->x1 - 1) | (r->y1 - 1) << 16;		/* XMAX, YMAX inclusive */
+	pbe[2] = 0x80 << 8 | (stride / 8 - 1) << 16;		/* COUNT, LINESTRIDE */
+	pbe[3] = addr & ~3u;					/* FBADDR */
+	pbe[4] = 0x200;						/* TILERELATIVE, ARGB8888 */
+}
+
+/* Vertex coordinates: 24-bit fixed point, 8 fraction bits, offset 4096. */
+static uint32_t vtx(uint32_t c)
+{
+	return ((c + 0x1000) << 8) & 0xffffff;
+}
+
+/* Top-left, top-right, bottom-left, packed even/odd/even into 8 dwords; Z = 0. */
+static void put_vertices(uint32_t v[8], const struct sgxfive_rect *r)
+{
+	uint32_t x0 = vtx(r->x0), y0 = vtx(r->y0), x1 = vtx(r->x1), y1 = vtx(r->y1);
+
+	v[0] = y0 | (x0 & 0xff) << 24;
+	v[1] = x0 >> 8;
+	v[2] = (y0 & 0xffff) << 16;
+	v[3] = (y0 >> 16) | x1 << 8;
+	v[4] = 0;
+	v[5] = y1 | (x0 & 0xff) << 24;
+	v[6] = x0 >> 8;
+	v[7] = 0;
+}
+
+/* PDS state: secondary pointer, sizes (PIXELSIZE, USETASKSIZE 3), primary pointer. */
+static void put_pds_state(uint32_t bg[3], uint32_t pds_base, uint32_t pri, uint32_t pri_data,
+			  uint32_t sec, uint32_t sec_data, uint32_t pri_attrs)
+{
+	bg[0] = ((sec - pds_base) >> 4) | (sec_data >> 4) << 26;
+	bg[1] = ((pri_attrs + 3) >> 2) | 3 << 16;
+	bg[2] = ((pri - pds_base) >> 4) | (pri_data >> 4) << 26;
+}
+
+void sgxfive_bgobj_fill(uint32_t bg[SGXFIVE_BGOBJ_DWORDS], uint32_t pds_base, uint32_t pri,
+			uint32_t pri_data, uint32_t sec, uint32_t sec_data,
+			const struct sgxfive_rect *r)
+{
+	memset(bg, 0, SGXFIVE_BGOBJ_DWORDS * sizeof(*bg));
+	put_pds_state(bg, pds_base, pri, pri_data, sec, sec_data, 0);
+	put_vertices(&bg[9], r);
+}
+
+uint32_t sgxfive_float_int_div(uint32_t x, uint32_t n)
+{
+	uint32_t q, m;
+
+	if (!x || !n)
+		return 0;
+	if (x >= n)
+		return 0x3f800000;
+	q = (uint32_t)(((uint64_t)x << 20) / n);	/* in [1, 1 << 20) */
+	for (m = 19; !(q >> m); m--)
+		;
+	return (127 + m - 20) << 23 | ((q << (23 - m)) & 0x7fffff);
+}
+
+void sgxfive_bgobj_copy(uint32_t bg[SGXFIVE_BGOBJ1_DWORDS], uint32_t pds_base, uint32_t pri,
+			uint32_t pri_data, uint32_t sec, uint32_t sec_data,
+			const struct sgxfive_rect *dst, const struct sgxfive_rect *src,
+			uint32_t src_w, uint32_t src_h)
+{
+	uint32_t u0 = sgxfive_float_int_div(src->x0, src_w);
+	uint32_t u1 = sgxfive_float_int_div(src->x1, src_w);
+	uint32_t v0 = sgxfive_float_int_div(src->y0, src_h);
+	uint32_t v1 = sgxfive_float_int_div(src->y1, src_h);
+
+	memset(bg, 0, SGXFIVE_BGOBJ1_DWORDS * sizeof(*bg));
+	put_pds_state(bg, pds_base, pri, pri_data, sec, sec_data, 1);
+	bg[3] = u0;
+	bg[4] = v0;
+	bg[5] = u1;
+	bg[6] = v0;
+	bg[7] = u0;
+	bg[8] = v1;
+	bg[10] = 2 << 8 | 2;			/* PITCHF, PITCHB: 2 dwords per layer */
+	put_vertices(&bg[15], dst);
+}
+
+void sgxfive_tex_words(uint32_t t[4], uint32_t addr, uint32_t width, uint32_t height,
+		       uint32_t stride)
+{
+	uint32_t s = stride / 4 - 1;		/* the stride in dwords, minus one */
+
+	t[0] = (s & 7) << 9 | (s >> 3) << 17;	/* STRIDELO [11:9], STRIDEHI [26:17], POINT */
+	t[1] = 0xcc000000 | (width - 1) << 12 | (height - 1);	/* NP2_STRIDE_EXT, B8G8R8A8 */
+	t[2] = addr & ~3u;
+	t[3] = 0xa0800000;
+}
+
+void sgxfive_transfer_cmd(struct drm_sgxfive_transfer_cmd *c, const struct sgxfive_xfer_regs *r)
+{
+	const struct sgxfive_rect *b = &r->rect;
+
+	memset(c, 0, sizeof(*c));
+	c->isp_bgobjtag = (r->bg - r->req_base) >> 4 | r->layers << 25;
+	c->isp_bgobj = 0x200;			/* ENABLEBGTAG */
+	c->isp_bgobjdepth = 0x3f800000;		/* 1.0f */
+	c->isp_render = 3;			/* FASTSCALE, scan TL2BR */
+	c->isp_ipfmisc = 0x100;			/* PROCESSEMPTY */
+	c->bif_3d_req_base = r->req_base;
+	c->aa_mode_3d = 0x80000000;		/* GLOBALREGISTER */
+	c->isp_multisamplectl = 0x88;		/* one sample at the pixel centre */
+	c->event_pixel_pds_exec = r->pixev_exec & ~0xfu;
+	c->event_pixel_pds_data = 0x50 >> 4;
+	c->event_pixel_pds_info = (1 * 4 + 15) >> 4;
+	c->isp_render_box1 = (b->y0 >> 4) | (b->x0 >> 5) << 16;
+	c->isp_render_box2 = (((b->y1 + 15) >> 4) - 1) | (((b->x1 + 31) >> 5) - 1) << 16;
+	c->pixelbe = 0x80;			/* ALPHATHRESHOLD */
+	c->pds_exec_base = r->pds_exec_base;
+}
+
+/* USSE_LIMM: imm[20:0] at bit 0, imm[25:21] at bit 36, imm[31:26] at bit 44. */
+static const struct { unsigned int insn, width, imm; } limm_fields[] = {
+	{ 0, 21, 0 }, { 36, 5, 21 }, { 44, 6, 26 },
+};
+
+uint64_t sgxfive_limm_set(uint64_t insn, uint32_t imm)
+{
+	for (unsigned int i = 0; i < 3; i++) {
+		uint64_t mask = ((1ull << limm_fields[i].width) - 1) << limm_fields[i].insn;
+
+		insn = (insn & ~mask) |
+		       ((uint64_t)(imm >> limm_fields[i].imm) << limm_fields[i].insn & mask);
+	}
+	return insn;
+}
+
+uint32_t sgxfive_limm_get(uint64_t insn)
+{
+	uint32_t imm = 0;
+
+	for (unsigned int i = 0; i < 3; i++)
+		imm |= (uint32_t)((insn >> limm_fields[i].insn) &
+				  ((1ull << limm_fields[i].width) - 1)) << limm_fields[i].imm;
+	return imm;
+}
diff --git a/lib/sgxfive/xfer_job.c b/lib/sgxfive/xfer_job.c
new file mode 100644
index 000000000..8b2e0a231
--- /dev/null
+++ b/lib/sgxfive/xfer_job.c
@@ -0,0 +1,326 @@
+// SPDX-License-Identifier: MIT
+/*
+ * The transfer engine: one context's fill and copy jobs. Programs come from a
+ * struct sgxfive_prog_source and are placed in a private three-page BO mapped
+ * into the context's VM (one page each in PDS_PIXEL, USSE_PIXEL and GENERAL);
+ * the background object goes in the GENERAL page, and the job is the register
+ * block of design/sgx545_transfer.md §4.2.6.
+ */
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sgxfive_xfer.h"
+
+enum { PG_PDS, PG_USE, PG_STREAM, PG_COUNT };
+
+static const uint32_t page_heap[PG_COUNT] = {
+	DRM_SGXFIVE_HEAP_PDS_PIXEL, DRM_SGXFIVE_HEAP_USSE_PIXEL, DRM_SGXFIVE_HEAP_GENERAL,
+};
+
+#define SLOT_ALIGN	16	/* placement granularity: reproduces the debugfs recipes */
+#define BG_ALIGN	64
+#define WAIT_NS		(10LL * 1000000000LL)
+
+struct sgxfive_xfer {
+	struct sgxfive_vm *vm;
+	struct sgxfive_dev *dev;
+	uint32_t ctx;
+	struct sgxfive_prog_source *src;
+	struct sgxfive_bo *bo;
+	uint8_t *map;
+	uint32_t done;		/* syncobj signalled by the engine's last job */
+	bool pending;
+	struct sgxfive_xfer_layout layout;
+	struct drm_sgxfive_transfer_cmd cmd;
+};
+
+static const uint32_t fill_progs[] = {
+	SGXFIVE_PROG_USE_FILL, SGXFIVE_PROG_USE_SEC, SGXFIVE_PROG_USE_EOT, SGXFIVE_PROG_USE_EOR,
+	SGXFIVE_PROG_PDS_PRIM, SGXFIVE_PROG_PDS_SEC, SGXFIVE_PROG_PDS_PIXEVENT,
+};
+static const uint32_t copy_progs[] = {
+	SGXFIVE_PROG_USE_COPY, SGXFIVE_PROG_USE_SEC, SGXFIVE_PROG_USE_EOT, SGXFIVE_PROG_USE_EOR,
+	SGXFIVE_PROG_PDS_PRIM_1SRC, SGXFIVE_PROG_PDS_SEC, SGXFIVE_PROG_PDS_PIXEVENT,
+};
+#define NPROGS (sizeof(fill_progs) / sizeof(fill_progs[0]))
+
+int sgxfive_xfer_create(struct sgxfive_vm *vm, uint32_t ctx, struct sgxfive_prog_source *src,
+			struct sgxfive_xfer **out)
+{
+	struct sgxfive_dev *dev = sgxfive_vm_dev(vm);
+	struct sgxfive_xfer *x;
+	uint64_t *pages[PG_COUNT];
+	void *map = NULL;
+	int ret;
+
+	if (!src)
+		return -EINVAL;
+	x = calloc(1, sizeof(*x));
+	if (!x)
+		return -ENOMEM;
+	x->vm = vm;
+	x->dev = dev;
+	x->ctx = ctx;
+	x->src = src;
+	pages[PG_PDS] = &x->layout.pds_page;
+	pages[PG_USE] = &x->layout.use_page;
+	pages[PG_STREAM] = &x->layout.stream_page;
+	ret = sgxfive_bo_create(dev, PG_COUNT * SGXFIVE_PAGE_SIZE,
+				DRM_SGXFIVE_BO_ALLOW_CPU_ACCESS, &x->bo);
+	if (!ret)
+		ret = sgxfive_bo_mmap(x->bo, &map);
+	for (int i = 0; !ret && i < PG_COUNT; i++) {
+		ret = sgxfive_vm_alloc(vm, page_heap[i], SGXFIVE_PAGE_SIZE, SGXFIVE_PAGE_SIZE,
+				       pages[i]);
+		if (!ret)
+			ret = sgxfive_vm_map(vm, *pages[i], x->bo, (uint64_t)i * SGXFIVE_PAGE_SIZE,
+					     SGXFIVE_PAGE_SIZE, 0);
+	}
+	if (!ret)
+		ret = sgxfive_syncobj_create(dev, false, &x->done);
+	if (ret) {
+		sgxfive_xfer_destroy(x);
+		return ret;
+	}
+	x->map = map;
+	*out = x;
+	return 0;
+}
+
+void sgxfive_xfer_destroy(struct sgxfive_xfer *x)
+{
+	const uint64_t pages[PG_COUNT] = {
+		x ? x->layout.pds_page : 0, x ? x->layout.use_page : 0,
+		x ? x->layout.stream_page : 0,
+	};
+
+	if (!x)
+		return;
+	if (x->pending)
+		sgxfive_xfer_wait(x, WAIT_NS);
+	for (int i = 0; i < PG_COUNT; i++)
+		if (pages[i])
+			sgxfive_vm_unmap(x->vm, pages[i], SGXFIVE_PAGE_SIZE);
+	if (x->done)
+		sgxfive_syncobj_destroy(x->dev, x->done);
+	sgxfive_bo_destroy(x->bo);
+	free(x);
+}
+
+void sgxfive_xfer_get_layout(const struct sgxfive_xfer *x, struct sgxfive_xfer_layout *l)
+{
+	*l = x->layout;
+}
+
+const struct drm_sgxfive_transfer_cmd *sgxfive_xfer_last_cmd(const struct sgxfive_xfer *x)
+{
+	return &x->cmd;
+}
+
+const void *sgxfive_xfer_page(const struct sgxfive_xfer *x, uint32_t heap)
+{
+	for (int i = 0; i < PG_COUNT; i++)
+		if (page_heap[i] == heap)
+			return x->map + i * SGXFIVE_PAGE_SIZE;
+	return NULL;
+}
+
+int sgxfive_xfer_wait(struct sgxfive_xfer *x, int64_t timeout_ns)
+{
+	int ret;
+
+	if (!x->pending)
+		return 0;
+	ret = sgxfive_syncobj_wait(x->dev, x->done, 0, timeout_ns);
+	if (!ret)
+		x->pending = false;
+	return ret;
+}
+
+static int page_of(uint32_t heap)
+{
+	for (int i = 0; i < PG_COUNT; i++)
+		if (page_heap[i] == heap)
+			return i;
+	return -1;
+}
+
+/* Place, build and write the programs of one job; fill env with their addresses. */
+static int build_programs(struct sgxfive_xfer *x, const uint32_t *ids,
+			  struct sgxfive_prog_env *env, struct sgxfive_prog_meta *m)
+{
+	const struct sgxfive_info *info = sgxfive_dev_info(x->dev);
+	const uint64_t page_addr[PG_COUNT] = {
+		x->layout.pds_page, x->layout.use_page, x->layout.stream_page,
+	};
+	uint32_t cursor[PG_COUNT] = { 0 };
+	int ret;
+
+	memset(x->layout.prog, 0, sizeof(x->layout.prog));
+	memset(env->addr, 0, sizeof(env->addr));
+	memset(env->doutu, 0, sizeof(env->doutu));
+	for (uint32_t i = 0; i < DRM_SGXFIVE_HEAP_COUNT; i++)
+		env->heap_base[i] = info->heaps[i].base;
+
+	for (unsigned int k = 0; k < NPROGS; k++) {
+		const uint32_t id = ids[k];
+		uint32_t align, off;
+		int pg;
+
+		ret = x->src->ops->meta(x->src, id, &m[id]);
+		if (ret)
+			return ret;
+		pg = page_of(m[id].heap);
+		if (pg < 0 || pg == PG_STREAM || !m[id].align || m[id].align & (m[id].align - 1))
+			return -EINVAL;
+		align = m[id].align > SLOT_ALIGN ? m[id].align : SLOT_ALIGN;
+		off = (cursor[pg] + align - 1) & ~(align - 1);
+		if (off + m[id].size > SGXFIVE_PAGE_SIZE)
+			return -ENOSPC;		/* NO_STRADDLE holds: one page each */
+		cursor[pg] = off + m[id].size;
+		env->addr[id] = page_addr[pg] + off;
+		x->layout.prog[id] = env->addr[id];
+		if (pg == PG_USE) {
+			ret = sgxfive_doutu(env->addr[id], info->heaps[m[id].heap].base,
+					    m[id].temps, &env->doutu[id]);
+			if (ret)
+				return ret;
+		}
+	}
+	for (unsigned int k = 0; k < NPROGS; k++) {
+		const uint32_t id = ids[k];
+		uint8_t *dst = x->map + page_of(m[id].heap) * SGXFIVE_PAGE_SIZE +
+			       (env->addr[id] - page_addr[page_of(m[id].heap)]);
+
+		ret = x->src->ops->build(x->src, id, env, dst);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int submit(struct sgxfive_xfer *x, uint32_t signal)
+{
+	struct drm_sgxfive_sync_op ops[2] = {
+		{ .handle = x->done, .flags = DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL },
+		{ .handle = signal, .flags = DRM_SGXFIVE_SYNC_OP_FLAG_SIGNAL },
+	};
+	struct drm_sgxfive_job job = {
+		.type = DRM_SGXFIVE_JOB_TYPE_TRANSFER, .context_handle = x->ctx,
+		.cmd_stream = (uintptr_t)&x->cmd, .cmd_stream_len = sizeof(x->cmd),
+		.sync_ops = DRM_SGXFIVE_OBJ_ARRAY(signal ? 2 : 1, ops),
+	};
+	int ret = sgxfive_submit(x->dev, &job, 1, NULL);
+
+	if (!ret)
+		x->pending = true;
+	return ret;
+}
+
+/* The destination checks of fwload.fill_params (design/sgx545_fw_format.md §9.6). */
+static int check_dst(const struct sgxfive_surface *s, const struct sgxfive_rect *r)
+{
+	if (r->x0 >= r->x1 || r->y0 >= r->y1 || r->x1 > s->width || r->y1 > s->height ||
+	    r->x1 > 0x2000 || r->y1 > 0x2000)
+		return -EINVAL;
+	if (s->stride % 8 || s->stride < 4ull * r->x1 || s->stride > 0x8000)
+		return -EINVAL;
+	if (s->addr % 4 || s->addr + (uint64_t)s->stride * (r->y1 - 1) + 4ull * r->x1 >
+	    1ull << 32)
+		return -EINVAL;
+	return 0;
+}
+
+static int run(struct sgxfive_xfer *x, const uint32_t *ids, struct sgxfive_prog_env *env,
+	       const struct sgxfive_rect *rect, const struct sgxfive_rect *src_rect,
+	       uint32_t signal)
+{
+	struct sgxfive_prog_meta m[SGXFIVE_PROG_COUNT];
+	uint32_t bg[SGXFIVE_BGOBJ1_DWORDS];
+	const uint32_t pri = ids == fill_progs ? SGXFIVE_PROG_PDS_PRIM
+					       : SGXFIVE_PROG_PDS_PRIM_1SRC;
+	struct sgxfive_xfer_regs regs;
+	uint32_t P;
+	int ret;
+
+	ret = sgxfive_xfer_wait(x, WAIT_NS);	/* one job in flight: programs are reused */
+	if (ret)
+		return ret;
+	ret = build_programs(x, ids, env, m);
+	if (ret)
+		return ret;
+	P = (uint32_t)x->layout.pds_page;
+	x->layout.bg = x->layout.stream_page;	/* offset 0: BG_ALIGN holds */
+	if (src_rect) {
+		sgxfive_bgobj_copy(bg, P, (uint32_t)env->addr[pri], m[pri].data_size,
+				   (uint32_t)env->addr[SGXFIVE_PROG_PDS_SEC],
+				   m[SGXFIVE_PROG_PDS_SEC].data_size, rect, src_rect,
+				   src_rect->x1, src_rect->y1);
+		memcpy(x->map + PG_STREAM * SGXFIVE_PAGE_SIZE, bg, SGXFIVE_BGOBJ1_DWORDS * 4);
+	} else {
+		sgxfive_bgobj_fill(bg, P, (uint32_t)env->addr[pri], m[pri].data_size,
+				   (uint32_t)env->addr[SGXFIVE_PROG_PDS_SEC],
+				   m[SGXFIVE_PROG_PDS_SEC].data_size, rect);
+		memcpy(x->map + PG_STREAM * SGXFIVE_PAGE_SIZE, bg, SGXFIVE_BGOBJ_DWORDS * 4);
+	}
+	regs = (struct sgxfive_xfer_regs){
+		.rect = *rect, .bg = (uint32_t)x->layout.bg,
+		.req_base = (uint32_t)x->layout.bg & ~0xfffffu,
+		.pixev_exec = (uint32_t)env->addr[SGXFIVE_PROG_PDS_PIXEVENT],
+		.pds_exec_base = P, .layers = src_rect ? 1 : 0,
+	};
+	sgxfive_transfer_cmd(&x->cmd, &regs);
+	return submit(x, signal);
+}
+
+int sgxfive_xfer_fill(struct sgxfive_xfer *x, const struct sgxfive_surface *dst,
+		      const struct sgxfive_rect *rect, uint32_t colour, uint32_t signal)
+{
+	struct sgxfive_prog_env env = { 0 };
+	int ret = check_dst(dst, rect);
+
+	if (ret)
+		return ret;
+	env.params[SGXFIVE_PARAM_COLOUR] = colour;
+	sgxfive_pbe(&env.params[SGXFIVE_PARAM_PBE0], rect, dst->stride, (uint32_t)dst->addr);
+	return run(x, fill_progs, &env, rect, NULL, signal);
+}
+
+int sgxfive_xfer_copy(struct sgxfive_xfer *x, const struct sgxfive_surface *src,
+		      uint32_t sx, uint32_t sy, const struct sgxfive_surface *dst,
+		      const struct sgxfive_rect *rect, uint32_t signal)
+{
+	struct sgxfive_prog_env env = { 0 };
+	struct sgxfive_rect sr;
+	uint32_t w, h, t[4];
+	uint64_t saddr;
+	int ret = check_dst(dst, rect);
+
+	if (ret)
+		return ret;
+	w = rect->x1 - rect->x0;
+	h = rect->y1 - rect->y0;
+	/* The source texture is the copied rectangle itself (fw_format §10.7). */
+	if (w > SGXFIVE_TEX_MAX || h > SGXFIVE_TEX_MAX || sx + w > src->width ||
+	    sy + h > src->height || src->stride % 4 || src->stride < 4ull * w ||
+	    src->stride > 0x8000 || src->addr % 4)
+		return -EINVAL;
+	saddr = src->addr + (uint64_t)sy * src->stride + 4ull * sx;
+	if (saddr + (uint64_t)src->stride * (h - 1) + 4ull * w > 1ull << 32)
+		return -EINVAL;
+	sgxfive_pbe(&env.params[SGXFIVE_PARAM_PBE0], rect, dst->stride, (uint32_t)dst->addr);
+	sgxfive_tex_words(t, (uint32_t)saddr, w, h, src->stride);
+	env.params[SGXFIVE_PARAM_T0] = t[0];
+	env.params[SGXFIVE_PARAM_T1] = t[1];
+	env.params[SGXFIVE_PARAM_SRC] = t[2];
+	sr = (struct sgxfive_rect){ 0, 0, w, h };
+	return run(x, copy_progs, &env, rect, &sr, signal);
+}
+
+/* Any program source: the assembled one, the fake, or one wrapping another. */
+void sgxfive_prog_source_destroy(struct sgxfive_prog_source *src)
+{
+	if (src && src->ops->destroy)
+		src->ops->destroy(src);
+}
