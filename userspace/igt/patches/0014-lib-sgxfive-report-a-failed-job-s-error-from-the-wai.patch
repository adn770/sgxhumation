@@ -198,7 +198,11 @@ int sgxfive_xfer_fill(struct sgxfive_xfer *x, const struct sgxfive_surface *dst,
 int sgxfive_xfer_copy(struct sgxfive_xfer *x, const struct sgxfive_surface *src,
