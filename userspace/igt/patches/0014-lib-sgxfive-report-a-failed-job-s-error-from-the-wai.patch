From dee8eced88e039451e73e9d631d004e3113d4b22 Mon Sep 17 00:00:00 2001
From: Josep Torra <n770galaxy@gmail.com>
Date: Thu, 22 Oct 2026 10:29:51 +0200
Subject: [PATCH 14/15] lib/sgxfive: report a failed job's error from the waits

A job that faults or hangs is recovered and fails: the kernel signals its
fence with -EIO (a fault), -ETIMEDOUT (a hang) or -ECANCELED (a job of the
lost context behind it). DRM's syncobj wait succeeds all the same, so the
library's waits returned 0 for a failed job.

Sync libsgxfive: sgxfive_syncobj_wait() reads a binary syncobj's fence
status from a sync_file exported from it and returns the error, with
sgxfive_syncobj_wait_job() and sgxfive_syncobj_fence_status() beside it,
and the transfer and render engines' waits report their last job's
error. Add igt_sgxfive_fence_status(), the same status through IGT's own
syncobj and sync_file helpers, and update the uapi header, which now
documents the errors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/drm-uapi/sgxfive_drm.h | 17 ++++++++++---
 lib/igt_sgxfive.c              | 19 ++++++++++++++
 lib/igt_sgxfive.h              |  1 +
 lib/sgxfive/dev.c              | 45 +++++++++++++++++++++++++++++++---
 lib/sgxfive/render.c           |  6 ++---
 lib/sgxfive/sgxfive.h          | 17 +++++++++++++
 lib/sgxfive/sgxfive_render.h   |  1 +
 lib/sgxfive/sgxfive_xfer.h     |  6 ++++-
 lib/sgxfive/xfer_job.c         | 21 +++++++++++++---
 9 files changed, 118 insertions(+), 15 deletions(-)

diff --git a/include/drm-uapi/sgxfive_drm.h b/include/drm-uapi/sgxfive_drm.h
index ac261f431..415254155 100644
--- a/include/drm-uapi/sgxfive_drm.h
+++ b/include/drm-uapi/sgxfive_drm.h
@@ -497,10 +497,10 @@ struct drm_sgxfive_vm_unmap_args {
  * kernel-owned) bound to one VM context for its lifetime. Contexts run their
  * jobs in submission order; the firmware arbitrates between contexts. A
  * context whose job faulted or hung is lost: its pending jobs complete with
- * an error and further submissions fail with -ECANCELED. After three such
- * jobs within a minute the whole file is banned: CREATE_CONTEXT and
- * SUBMIT_JOBS on it fail with -ECANCELED, while jobs it already queued on
- * contexts that are not lost still run.
+ * an error (see SUBMIT_JOBS) and further submissions fail with -ECANCELED.
+ * After three such jobs within a minute the whole file is banned:
+ * CREATE_CONTEXT and SUBMIT_JOBS on it fail with -ECANCELED, while jobs it
+ * already queued on contexts that are not lost still run.
  */
 
 /**
@@ -587,6 +587,15 @@ struct drm_sgxfive_destroy_context_args {
  *
  * A job's out-fence signals once the firmware reports completion, after the
  * job's memory writes are visible to write-combined CPU mappings.
+ *
+ * A job that does not complete signals its out-fence with an error, which
+ * the fence status reports (a sync_file exported from the signalled syncobj,
+ * SYNC_IOC_FILE_INFO; a syncobj wait itself succeeds): -EIO for the job a
+ * GPU fault was blamed on, -ETIMEDOUT for the job a hang without a fault was
+ * blamed on, -ECANCELED for the jobs of its context queued behind it and for
+ * jobs of a context that is already lost. Its memory writes may be partial.
+ * Other contexts' unfinished jobs run again after the recovery and signal
+ * without an error.
  */
 
 /* Sync op encoding, as in pvr_drm.h. */
diff --git a/lib/igt_sgxfive.c b/lib/igt_sgxfive.c
index 91f190bf9..ecd21242c 100644
--- a/lib/igt_sgxfive.c
+++ b/lib/igt_sgxfive.c
@@ -12,6 +12,7 @@
 #include "igt_sgxfive.h"
 #include "igt_syncobj.h"
 #include "ioctl_wrappers.h"
+#include "sw_sync.h"
 
 /**
  * SECTION:igt_sgxfive
@@ -298,3 +299,21 @@ int igt_sgxfive_wait(int fd, uint32_t syncobj, uint64_t point, uint32_t timeout_
 		return syncobj_wait_err(fd, &syncobj, 1, deadline, flags);
 	return syncobj_timeline_wait_err(fd, &syncobj, &point, 1, deadline, flags);
 }
+
+/*
+ * The status of a binary syncobj's fence, from a sync_file exported from it:
+ * 1 signalled, 0 pending, or the error it signalled with (-EIO for a job that
+ * faulted, -ETIMEDOUT for one that hung, -ECANCELED for a job of a lost
+ * context). A syncobj wait succeeds whatever the error; this reads it.
+ */
+int igt_sgxfive_fence_status(int fd, uint32_t syncobj)
+{
+	int sf = syncobj_handle_to_fd(fd, syncobj,
+				      DRM_SYNCOBJ_HANDLE_TO_FD_FLAGS_EXPORT_SYNC_FILE);
+	int status;
+
+	igt_assert_lte(0, sf);
+	status = sync_fence_status(sf);
+	close(sf);
+	return status;
+}
diff --git a/lib/igt_sgxfive.h b/lib/igt_sgxfive.h
index fa0bb8ef3..a52290ae6 100644
--- a/lib/igt_sgxfive.h
+++ b/lib/igt_sgxfive.h
@@ -49,5 +49,6 @@ struct drm_sgxfive_job igt_sgxfive_dummy_job(uint32_t ctx);
 int __igt_sgxfive_submit_dummy(int fd, uint32_t ctx, uint32_t wait, uint32_t signal);
 void igt_sgxfive_submit_dummy(int fd, uint32_t ctx, uint32_t wait, uint32_t signal);
 int igt_sgxfive_wait(int fd, uint32_t syncobj, uint64_t point, uint32_t timeout_ms);
+int igt_sgxfive_fence_status(int fd, uint32_t syncobj);
 
 #endif /* IGT_SGXFIVE_H */
diff --git a/lib/sgxfive/dev.c b/lib/sgxfive/dev.c
index 2c276fc41..69559e4c2 100644
--- a/lib/sgxfive/dev.c
+++ b/lib/sgxfive/dev.c
@@ -13,6 +13,8 @@
 #include <time.h>
 #include <unistd.h>
 
+#include <linux/sync_file.h>
+
 #include "sgxfive.h"
 
 struct sgxfive_dev {
@@ -445,8 +447,30 @@ static int64_t deadline(int64_t timeout_ns)
 	return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec + timeout_ns;
 }
 
-int sgxfive_syncobj_wait(struct sgxfive_dev *dev, uint32_t handle, uint64_t point,
-			 int64_t timeout_ns)
+/*
+ * The fence status through a sync_file: DRM's syncobj wait succeeds whatever
+ * the fence's error, and only the sync_file query reports it.
+ */
+int sgxfive_syncobj_fence_status(struct sgxfive_dev *dev, uint32_t handle, int *status)
+{
+	struct drm_syncobj_handle h = {
+		.handle = handle, .flags = DRM_SYNCOBJ_HANDLE_TO_FD_FLAGS_EXPORT_SYNC_FILE,
+		.fd = -1,
+	};
+	struct sync_file_info info = { .num_fences = 0 };
+	int ret = sgxfive_dev_ioctl(dev, DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD, &h);
+
+	if (ret)
+		return ret;
+	ret = dev->be->ioctl(dev->be->priv, h.fd, SYNC_IOC_FILE_INFO, &info);
+	dev->be->close(dev->be->priv, h.fd);
+	if (!ret)
+		*status = info.status;
+	return ret;
+}
+
+int sgxfive_syncobj_wait_job(struct sgxfive_dev *dev, uint32_t handle, uint64_t point,
+			     int64_t timeout_ns, int *job_error)
 {
 	struct drm_syncobj_timeline_wait tw = {
 		.handles = (uintptr_t)&handle, .points = (uintptr_t)&point,
@@ -457,10 +481,25 @@ int sgxfive_syncobj_wait(struct sgxfive_dev *dev, uint32_t handle, uint64_t poin
 		.handles = (uintptr_t)&handle, .timeout_nsec = tw.timeout_nsec,
 		.count_handles = 1, .flags = DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT,
 	};
+	int ret, status = 1;
 
+	*job_error = 0;
 	if (point)
 		return sgxfive_dev_ioctl(dev, DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT, &tw);
-	return sgxfive_dev_ioctl(dev, DRM_IOCTL_SYNCOBJ_WAIT, &w);
+	ret = sgxfive_dev_ioctl(dev, DRM_IOCTL_SYNCOBJ_WAIT, &w);
+	if (!ret)
+		ret = sgxfive_syncobj_fence_status(dev, handle, &status);
+	if (!ret && status < 0)
+		*job_error = status;
+	return ret;
+}
+
+int sgxfive_syncobj_wait(struct sgxfive_dev *dev, uint32_t handle, uint64_t point,
+			 int64_t timeout_ns)
+{
+	int job_error, ret = sgxfive_syncobj_wait_job(dev, handle, point, timeout_ns, &job_error);
+
+	return ret ? ret : job_error;
 }
 
